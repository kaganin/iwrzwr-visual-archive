{"html":"<div id=\"iwr-night-resources\" aria-label=\"Set 11: Shared Resources, beş hareketli ses ekranı\">\n  <div class=\"viz-controls\">\n    <button type=\"button\" class=\"btn\" data-mode=\"play\" aria-pressed=\"true\">Çalma</button>\n    <button type=\"button\" class=\"btn\" data-mode=\"record\" aria-pressed=\"false\">Kayıt</button>\n    <button type=\"button\" class=\"btn btn-ghost\" data-pause aria-pressed=\"false\">Duraklat</button>\n    <span class=\"text-small text-muted\">Örnek ses ritmi · sessiz demo</span>\n  </div>\n  <div class=\"nr-layout\">\n    <div class=\"nr-stage\">\n      <div class=\"nr-phone\" aria-label=\"iwrzwr: Shared Resources önizlemesi\">\n        <div class=\"nr-header\">\n          <div class=\"nr-status\" aria-hidden=\"true\"><span>9:41</span><span data-record hidden>REC</span><span>••• &nbsp; ▰</span></div>\n          <div class=\"nr-controls\">\n            <div class=\"nr-circle\" aria-hidden=\"true\"></div>\n            <canvas role=\"img\" aria-label=\"Choke Pair: aynı ailenin yeni olayı eski izi kesiyor\"></canvas>\n            <div class=\"nr-circle\" aria-hidden=\"true\"><i data-lucide=\"plus\"></i></div>\n          </div>\n        </div>\n        <div class=\"nr-pads\" aria-hidden=\"true\"><div><i data-lucide=\"mic\"></i></div><div><i data-lucide=\"mic\"></i></div></div>\n      </div>\n      <div class=\"text-small text-muted nr-spec\">126px header · 44px alan · 24px boşluk</div>\n    </div>\n    <div class=\"nr-options\" role=\"group\" aria-label=\"Shared Resources seçenekleri\">\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"choke\" aria-pressed=\"true\">1 · Choke Pair</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"vacancy\" aria-pressed=\"false\">2 · Voice Vacancy</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"dock\" aria-pressed=\"false\">3 · Docked Phrase</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"recall\" aria-pressed=\"false\">4 · Masked Recall</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"routing\" aria-pressed=\"false\">5 · Routed Emphasis</button>\n    </div>\n  </div>\n  <div class=\"nr-caption\" data-description aria-live=\"polite\">Bir çiftin yeni olayı eski kuyruğu anında kesiyor; diğer çiftler etkilenmiyor.</div>\n</div>\n<style>\n  #iwr-night-resources .nr-layout { display:grid; grid-template-columns:minmax(0,402px) minmax(190px,1fr); gap:24px; align-items:center; margin-top:20px; }\n  #iwr-night-resources .nr-stage { min-width:0; }\n  #iwr-night-resources .nr-options { display:grid; gap:8px; }\n  #iwr-night-resources .nr-phone { --nr-screen:#000; --nr-pad:#cdcdcd; --nr-divider:#b6b6b6; --nr-ink:#f1f0e8; color:var(--nr-ink); background:var(--nr-pad); border-radius:30px; overflow:hidden; font-family:-apple-system,BlinkMacSystemFont,sans-serif; }\n  #iwr-night-resources .nr-header { height:126px; position:relative; background:var(--nr-screen); border-radius:0 0 32px 40px; }\n  #iwr-night-resources .nr-status { position:absolute; top:24px; left:28px; right:28px; display:flex; align-items:center; justify-content:space-between; font-size:13px; font-weight:500; }\n  #iwr-night-resources [data-record] { color:#FF0000; font-family:ui-monospace,monospace; font-size:11px; }\n  #iwr-night-resources [hidden] { display:none; }\n  #iwr-night-resources .nr-controls { position:absolute; top:62px; left:20px; right:20px; display:flex; align-items:center; gap:24px; height:44px; }\n  #iwr-night-resources .nr-circle { width:44px; height:44px; flex:none; display:grid; place-items:center; border-radius:50%; background:#141414; box-shadow:inset 0 0 0 1px #303030; }\n  #iwr-night-resources .nr-circle svg { width:20px; height:20px; stroke-width:1.5; }\n  #iwr-night-resources canvas { display:block; height:44px; width:100%; flex:1; min-width:0; }\n  #iwr-night-resources .nr-pads { display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--nr-divider); }\n  #iwr-night-resources .nr-pads>div { display:grid; place-items:center; height:120px; background:var(--nr-pad); color:#929292; }\n  #iwr-night-resources .nr-pads svg { width:18px; height:18px; }\n  #iwr-night-resources .nr-spec { margin-top:10px; }\n  #iwr-night-resources .nr-caption { margin-top:16px; min-height:44px; }\n  @media(max-width:630px) { #iwr-night-resources .nr-layout { grid-template-columns:minmax(0,1fr); gap:18px; } #iwr-night-resources .nr-stage { width:100%; max-width:402px; margin:auto; } }\n</style>\n<script>\n(() => {\n  const root=document.getElementById('iwr-night-resources');\n  const canvas=root.querySelector('canvas'),ctx=canvas.getContext('2d');\n  const pause=root.querySelector('[data-pause]'),caption=root.querySelector('[data-description]');\n  const reduced=matchMedia('(prefers-reduced-motion: reduce)');\n  const state={style:'choke',mode:'play',paused:reduced.matches,accent:true};\n  const names={choke:'Choke Pair',vacancy:'Voice Vacancy',dock:'Docked Phrase',recall:'Masked Recall',routing:'Routed Emphasis'};\n  const descriptions={\n    choke:['Bir çiftin yeni olayı eski kuyruğu anında kesiyor; diğer çiftler etkilenmiyor.','Yeni iz kısa bir uçla yazılıyor; eşinin devam eden izi aynı anda kesiliyor.'],\n    vacancy:['Sekiz sabit yer paylaşılır; hepsi doluysa yalnız en eski etkin iz yerini bırakır.','Olaylar boş yerlere yazılıyor; kapasite dolunca en eski yer yeniden kullanılıyor.'],\n    dock:['Birleşmiş parçalar ortak bir gövde; vuruşlar yalnız kendi birleşme çizgisini vurguluyor.','Ayrı parçalar ortak kenarlarda birleşiyor; tamamlanan yapı birlikte hareket ediyor.'],\n    recall:['Sahneler değişse de işaretli bölüm aynı kalıyor; diğer parçalar yenileniyor.','Korunan bölüm sabit tutuluyor; yalnız açıkta kalan yollar yeniden yazılıyor.'],\n    routing:['Tek giriş, birbirine komşu olmayan hedefleri aynı anda seçiyor; kablo yok.','Aynı girişin hedef kümesi adım adım yazılıyor; yeni üyelik kısa bir çentikle beliriyor.']\n  };\n  const white='#f1f0e8',amber='#FF0000';\n  let w=226,dpr=1,t=2.4,last=0,raf=0,visible=true;\n  const clamp=(x,a=0,b=1)=>Math.min(b,Math.max(a,x));\n  // Live sound seam: iwrSignal exists only inside the archive gallery. Without it, or with sound off, nothing changes.\n  const hearing=()=>typeof iwrSignal!=='undefined'&&iwrSignal.active?iwrSignal:null;\n  // Geometry reads audio features. Transport and history have separate clocks.\n  const charge=(band='amp',age=0)=>{const s=hearing();return s?clamp(s.bandAt?s.bandAt(band,age):(s[band]??s.level??0)):0;};\n  const strike=(kind='kick')=>{const s=hearing();return s?.eventAt?s.eventAt(kind):{n:Math.floor(s?.beat??0),age:s?.[kind+'Age']??30};};\n  // Time-driven machines move on the beat and rest between hits; the studies' own dt clamps still apply first.\n  const conduct=()=>{const s=hearing();return s?0.25+4.2*s.hit:1;};\n  const mod=(x,n)=>(x%n+n)%n;\n  const accent=()=>state.accent?amber:white;\n  function ink(alpha=1,color=white) {ctx.globalAlpha=clamp(alpha);ctx.fillStyle=color;ctx.strokeStyle=color;}\n  function rect(x,y,width,height,alpha=1,color=white) {ink(alpha,color);ctx.fillRect(Math.round(x*dpr)/dpr,Math.round(y*dpr)/dpr,width,height);}\n  function line(points,alpha=1,color=white) {if(points.length<2)return;ink(alpha,color);ctx.lineWidth=1;ctx.lineCap='butt';ctx.lineJoin='miter';ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(...p):ctx.moveTo(...p));ctx.stroke();}\n  function partial(points,fraction,alpha,color=white) {\n    const lengths=points.slice(1).map((p,i)=>Math.hypot(p[0]-points[i][0],p[1]-points[i][1]));\n    let left=lengths.reduce((a,b)=>a+b,0)*clamp(fraction);const path=[points[0]];\n    for(let i=0;i<lengths.length&&left>0;i++) {const p=points[i],q=points[i+1],f=Math.min(1,left/lengths[i]);path.push([p[0]+(q[0]-p[0])*f,p[1]+(q[1]-p[1])*f]);left-=lengths[i];}\n    line(path,alpha,color);return path[path.length-1];\n  }\n  // All schedules are deterministic examples, not microphone, MIDI or instrument analysis.\n  const chokeEvents=[[.1,0,0],[.38,2,0],[.65,0,1],[.92,1,0],[1.13,3,1],[1.46,2,1],[1.77,1,1],[2.01,0,0],[2.32,3,0],[2.65,0,1],[2.94,2,0],[3.18,3,1],[3.55,1,0],[3.89,1,1],[4.2,2,1],[4.55,0,0]];\n  function chokeState(time) {\n    if(hearing()){\n      const pairs=Array.from({length:4},(_,group)=>{const a=strike(group%2?'note':'kick'),b=strike(group%2?'hat':'snare'),e=a.age<b.age?a:b;return {at:time-e.age,end:time-e.age+.65,member:a.age<b.age?0:1,group};});\n      return {phase:time,pairs,cuts:[]};\n    }\n    const phase=mod(time,6),pairs=Array(4).fill(null),cuts=[];\n    chokeEvents.forEach(([at,group,member],id)=>{if(at>phase)return;const old=pairs[group];if(old&&old.end>at&&old.member!==member)cuts.push({at,group,member:old.member});pairs[group]={at,group,member,id,end:at+1.24};});\n    return {phase,pairs,cuts};\n  }\n  function choke(time) {\n    const {phase,pairs,cuts}=chokeState(time),pitch=(w-12)/4,recording=state.mode==='record';\n    for(let group=0;group<4;group++) {\n      const x=6+group*pitch,length=pitch-10;\n      for(let member=0;member<2;member++) {const y=member?30:14;line([[x+4,y-3],[x,y-3],[x,y+3],[x+4,y+3]],.24);}\n      const event=pairs[group];\n      if(event&&event.end>phase) {\n        const age=phase-event.at,remaining=clamp((event.end-phase)/1.24),extent=length*Math.ceil(remaining*12)/12*(recording?clamp(age/.12):1),y=event.member?30:14;\n        line([[x+3,y],[x+3+extent,y]],.85,age<.12?accent():white);\n        if(recording)line([[x+3+extent,y-2],[x+3+extent,y+2]],1,accent());\n      }\n    }\n    cuts.filter(cut=>phase-cut.at<.12).forEach(cut=>{const x=6+cut.group*pitch+6,y=cut.member?30:14;line([[x,y-3],[x,y+3]],1,accent());});\n  }\n  const starts=[.08,.3,.56,.81,1.05,1.3,1.59,1.89,2.2,2.46,3.2,3.43,4.51];\n  const voiceEvents=starts.map((at,id)=>({at,id,duration:2.9+.3*((id*3)%4)}));\n  function voiceState(time) {\n    if(hearing()){\n      const seats=Array(8).fill(null),seen=new Set();let back=0;\n      for(let i=0;i<8;i++){const e=hearing().eventAt?.('note',back)??strike('note'),at=time-back-e.age;\n        if(e.n>0&&!seen.has(e.n)){const duration=.4+charge('mid',Math.max(0,time-at-.035))*1.4;seen.add(e.n);if(time<at+duration)seats[mod(e.n,8)]={at,id:e.n,duration,end:at+duration};}\n        back+=e.age+.001;\n      }\n      return {phase:time,seats,actions:[]};\n    }\n    const phase=mod(time,8),seats=Array(8).fill(null),actions=[];\n    for(const event of voiceEvents) {\n      if(event.at>phase)break;\n      for(let i=0;i<8;i++)if(seats[i]&&seats[i].end<=event.at)seats[i]=null;\n      let seat=seats.findIndex(value=>!value),stolen=null;\n      if(seat<0){seat=seats.reduce((oldest,value,i)=>value.at<seats[oldest].at?i:oldest,0);stolen=seats[seat].id;}\n      seats[seat]={...event,end:event.at+event.duration};actions.push({at:event.at,seat,stolen,id:event.id});\n    }\n    for(let i=0;i<8;i++)if(seats[i]&&seats[i].end<=phase)seats[i]=null;\n    return {phase,seats,actions};\n  }\n  function vacancy(time) {\n    const {phase,seats,actions}=voiceState(time),pitch=(w-8)/8,width=Math.min(18,pitch-5),recording=state.mode==='record';\n    seats.forEach((event,i)=>{\n      const x=4+pitch*(i+.5),l=x-width/2,r=x+width/2;\n      line([[l+3,11],[l,11],[l,16]],.32);line([[r-3,33],[r,33],[r,28]],.32);\n      if(!event)return;\n      const age=phase-event.at,remaining=clamp((event.end-phase)/event.duration),direction=event.id%2?1:-1;\n      const tooth=[[x-4,22-direction*3],[x+3,22],[x-4,22+direction*3]];\n      partial(tooth,recording?clamp(age/.14):1,.9,age<.16?accent():white);\n      line([[l,13+(1-remaining)*17],[l+3,13+(1-remaining)*17]],.7);\n      if(recording&&age<.2)rect(r-1,8,2,2,1,accent());\n    });\n    actions.filter(action=>action.stolen!==null&&phase-action.at<.18).forEach(action=>{const x=4+pitch*(action.seat+.5);line([[x-4,38],[x+4,38]],1,accent());});\n  }\n  const pieces=[[[0,0],[26,0],[26,8],[34,8],[34,22],[0,22]],[[26,0],[60,0],[60,22],[34,22],[34,8],[26,8]],[[60,0],[84,0],[84,10],[92,10],[92,22],[60,22]],[[84,0],[112,0],[112,22],[92,22],[92,10],[84,10]]];\n  const seams=[[[26,0],[26,8],[34,8],[34,22]],[[60,0],[60,22]],[[84,0],[84,10],[92,10],[92,22]]];\n  function dockGeometry(time,recording) {\n    if(hearing())return {phase:strike('snare').age,offsets:pieces.map((_,i)=>[0,(.5-charge(['low','mid','high','amp'][i]))*4]),common:0};\n    const phase=mod(time,5.2),offsets=pieces.map((_,i)=>{\n      if(!recording)return i===3&&phase>3.5?[5*clamp((phase-3.5)/.16),-4*clamp((phase-3.5)/.16)]:[0,0];\n      const pending=1-clamp((phase-i*.8)/.14);return [i*7*pending,(i%2?-5:5)*pending*(i?1:0)];\n    });\n    const common=recording&&phase>2.7?2*clamp((phase-2.7)/.2):0;\n    return {phase,offsets,common};\n  }\n  function dock(time) {\n    const recording=state.mode==='record',{phase,offsets,common}=dockGeometry(time,recording),scale=Math.min(1.5,(w-12)/134),left=(w-112*scale)/2-5;\n    const map=(p,offset=[0,0])=>[left+(p[0]+offset[0]+common)*scale,10+p[1]+offset[1]];\n    const edges=new Map();\n    pieces.forEach((points,i)=>{\n      for(let j=0;j<points.length;j++) {\n        const a=map(points[j],offsets[i]),b=map(points[(j+1)%points.length],offsets[i]);\n        const keys=[a.join(','),b.join(',')].sort(),key=keys.join('|');\n        const previous=edges.get(key);edges.set(key,{a,b,count:previous?previous.count+1:1});\n      }\n    });\n    edges.forEach(edge=>line([edge.a,edge.b],edge.count>1?.22:.75));\n    const active=Math.min(2,Math.floor(phase/.8));\n    if(!recording&&phase<3.2){const points=seams[active].map(p=>map(p));partial(points,clamp(mod(phase,.8)/.15),.9,accent());}\n    if(recording)seams.forEach((points,i)=>{const age=phase-(i+1)*.8;if(age>=0&&age<.26)line(points.map(p=>map(p)),1,accent());});\n  }\n  const routes=[[0,8,-5],[8,-6,4],[-6,5,9],[4,-9,-3],[9,2,-8],[-3,7,3]];\n  function recallState(time) {\n    if(hearing()){const e=strike('note');return {event:e.n,values:['low','mid','high'].map((b,i)=>Math.round((charge(b,i*.22)-.5)*18)),protectedIndex:mod(e.n,3),age:e.age};}\n    // Twelve complete scenes; seed is the previous cycle's terminal state.\n    const phase=mod(time,9.6),event=Math.min(11,Math.floor((phase+1e-10)/.8)),values=[-3,7,4];let protectedIndex=0;\n    for(let scene=0;scene<=event;scene++) {protectedIndex=Math.floor(scene/4)%3;for(let i=0;i<3;i++)if(i!==protectedIndex)values[i]=routes[scene%routes.length][i];}\n    return {event,values,protectedIndex,age:Math.max(0,phase-event*.8)};\n  }\n  function recall(time) {\n    const {event,values,protectedIndex,age}=recallState(time),span=(w-14)/3,recording=state.mode==='record';\n    values.forEach((value,i)=>{\n      const x=7+i*span,y=22-value,points=[[x,22],[x+span*.2,22],[x+span*.2,y],[x+span*.68,y],[x+span*.68,22],[x+span,22]];\n      const locked=i===protectedIndex;\n      partial(points,recording&&!locked?clamp(age/.16):1,locked?1:.65);\n      if(locked) {\n        line([[x+4,35],[x+4,38],[x+span-4,38],[x+span-4,35]],.72,accent());\n        rect(x-1,21,2,2,1,accent());rect(x+span-1,21,2,2,1,accent());\n      } else if(recording&&age<.16)rect(x+span*.2-1,y-1,2,2,1,accent());\n    });\n    if(event%4===0&&age<.12){const x=7+protectedIndex*span+span/2;line([[x-2,40],[x+2,40]],.85,accent());}\n  }\n  const routeMasks=[1,5,37,2,6,22];\n  function routing(time) {\n    const recording=state.mode==='record',step=hearing()?strike('hat').n:Math.floor(time/.76),age=hearing()?strike('hat').age:mod(time,.76),source=recording?Math.floor(step/3)%2:step%2,mask=hearing()?Array.from({length:6},(_,i)=>charge(['low','mid','high'][i%3],Math.floor(i/3)*.18)>.16?1<<i:0).reduce((a,b)=>a|b,0):recording?routeMasks[step%6]:(source?22:37);\n    const previous=recording&&step%3?routeMasks[(step-1)%6]:0,hold=age<.42,alpha=hold?1:.45;\n    for(let i=0;i<2;i++){const y=i?32:12;line([[4,y-4],[4,y+4],[10,y+4]],i===source?alpha:.17,i===source?accent():white);}\n    for(let i=0;i<6;i++) {\n      const x=30+(w-41)*(i%3)/2,y=i<3?12:32,selected=Boolean(mask&(1<<i)),newMember=selected&&!(previous&(1<<i));\n      const a=selected?alpha:.17;\n      line([[x-4,y-3],[x+4,y-3]],a);line([[x-4,y+3],[x+4,y+3]],a);\n      if(selected)line([[x,y-3],[x,y+3]],a,accent());\n      if(recording&&newMember&&age<.2)line([[x+6,y-2],[x+6,y+2]],1,accent());\n    }\n  }\n  const renderers={choke,vacancy,dock,recall,routing};\n  function draw() {ctx.clearRect(0,0,w,44);ctx.save();ctx.beginPath();ctx.rect(0,0,w,44);ctx.clip();renderers[state.style](t);ctx.restore();}\n  function sync() {\n    root.querySelectorAll('[data-style]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.style===state.style)));\n    root.querySelectorAll('[data-mode]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.mode===state.mode)));\n    const description=descriptions[state.style][state.mode==='record'?1:0];caption.textContent=description;canvas.setAttribute('aria-label',names[state.style]+': '+description);\n    root.querySelector('[data-record]').hidden=state.mode!=='record';pause.textContent=state.paused?'Devam et':'Duraklat';pause.setAttribute('aria-pressed',String(state.paused));draw();schedule();\n  }\n  function resize(){w=Math.max(1,canvas.getBoundingClientRect().width);dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(w*dpr);canvas.height=44*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);draw();}\n  function schedule(){if(!raf&&!state.paused&&visible&&!document.hidden&&root.isConnected){last=0;raf=requestAnimationFrame(frame);}}\n  function frame(now){raf=0;if(state.paused||!visible||document.hidden||!root.isConnected)return;if(!last)last=now;const elapsed=now-last;if(elapsed>=1000/30){const heard=hearing();if(heard?.source==='demo')t=heard.songTime;else t+=Math.min(elapsed/1000,.07)*conduct();last=now;draw();}raf=requestAnimationFrame(frame);}\n  root.querySelectorAll('[data-style]').forEach(el=>el.addEventListener('click',()=>{state.style=el.dataset.style;sync();}));\n  root.querySelectorAll('[data-mode]').forEach(el=>el.addEventListener('click',()=>{state.mode=el.dataset.mode;sync();}));\n  pause.addEventListener('click',()=>{state.paused=!state.paused;sync();});reduced.addEventListener('change',()=>{state.paused=reduced.matches;sync();});\n  document.addEventListener('visibilitychange',schedule);new ResizeObserver(resize).observe(canvas);\n  new IntersectionObserver(entries=>{const latest=entries.reduce((a,b)=>b.target===root&&(!a||b.time>=a.time)?b:a,null);if(latest){visible=latest.isIntersecting;schedule();}}).observe(root);\n  resize();sync();\n  if(globalThis.Tweak){const tweak=new Tweak({container:root.querySelector('.nr-phone'),onChange:sync});tweak.addToggle(state,'accent',{label:'Kehribar vurgu'});}\n})();\n</script>\n","css":":root{color-scheme:dark;--background:#000;--foreground:#eee;--muted-foreground:#999}*{box-sizing:border-box}body{margin:0;padding:24px;background:#000;color:#eee;font:16px/1.5 Arial,Helvetica,sans-serif}button{font:inherit;cursor:pointer}.viz-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:24px}.btn{color:#bbb;background:#141414;border:1px solid #333;border-radius:6px;min-height:44px;padding:9px 14px;text-align:left}.btn[aria-pressed=true]{color:#fff;border-color:#ddd;background:#262626}.btn-block{width:100%}.text-small{font-size:14px}.text-muted{color:#999}:focus-visible{outline:2px solid #fff;outline-offset:3px}[hidden]{display:none!important}h3{font-size:18px;font-weight:500}figcaption{font-size:16px}canvas{max-width:100%}@media(max-width:520px){body{padding:16px}}"}