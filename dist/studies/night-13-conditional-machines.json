{"html":"<div id=\"iwr-night-conditional\" aria-label=\"Set 13: Conditional Machines, beş hareketli ses ekranı\">\n  <div class=\"viz-controls\">\n    <button type=\"button\" class=\"btn\" data-mode=\"play\" aria-pressed=\"true\">Çalma</button>\n    <button type=\"button\" class=\"btn\" data-mode=\"record\" aria-pressed=\"false\">Kayıt</button>\n    <button type=\"button\" class=\"btn btn-ghost\" data-pause aria-pressed=\"false\">Duraklat</button>\n    <span class=\"text-small text-muted\">Örnek ses ritmi · sessiz demo</span>\n  </div>\n  <div class=\"nc-layout\">\n    <div class=\"nc-stage\">\n      <div class=\"nc-phone\" aria-label=\"iwrzwr: Conditional Machines önizlemesi\">\n        <div class=\"nc-header\">\n          <div class=\"nc-status\" aria-hidden=\"true\"><span>9:41</span><span data-record hidden>REC</span><span>••• &nbsp; ▰</span></div>\n          <div class=\"nc-controls\">\n            <div class=\"nc-circle\" aria-hidden=\"true\"></div>\n            <canvas role=\"img\" aria-label=\"Confidence Fence: tutarlı örnekler aralığı daraltıyor\"></canvas>\n            <div class=\"nc-circle\" aria-hidden=\"true\"><i data-lucide=\"plus\"></i></div>\n          </div>\n        </div>\n        <div class=\"nc-pads\" aria-hidden=\"true\"><div><i data-lucide=\"mic\"></i></div><div><i data-lucide=\"mic\"></i></div></div>\n      </div>\n      <div class=\"text-small text-muted nc-spec\">126px header · 44px alan · 24px boşluk</div>\n    </div>\n    <div class=\"nc-options\" role=\"group\" aria-label=\"Conditional Machines seçenekleri\">\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"confidence\" aria-pressed=\"true\">1 · Confidence Fence</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"closure\" aria-pressed=\"false\">2 · Vector Closure</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"escapement\" aria-pressed=\"false\">3 · Cycle Escapement</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"detour\" aria-pressed=\"false\">4 · Reversible Detour</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"mutation\" aria-pressed=\"false\">5 · Mutation Quota</button>\n    </div>\n  </div>\n  <div class=\"nc-caption\" data-description aria-live=\"polite\">Tahmin ile kayıt karşılaşıyor; uyuşmazlık dar aralığı yeniden açıyor.</div>\n</div>\n<style>\n  #iwr-night-conditional .nc-layout { display:grid; grid-template-columns:minmax(0,402px) minmax(190px,1fr); gap:24px; align-items:center; margin-top:20px; }\n  #iwr-night-conditional .nc-stage { min-width:0; }\n  #iwr-night-conditional .nc-options { display:grid; gap:8px; }\n  #iwr-night-conditional .nc-phone { --nc-screen:#000; --nc-pad:#cdcdcd; --nc-divider:#b6b6b6; --nc-ink:#f1f0e8; color:var(--nc-ink); background:var(--nc-pad); border-radius:30px; overflow:hidden; font-family:-apple-system,BlinkMacSystemFont,sans-serif; }\n  #iwr-night-conditional .nc-header { height:126px; position:relative; background:var(--nc-screen); border-radius:0 0 32px 40px; }\n  #iwr-night-conditional .nc-status { position:absolute; top:24px; left:28px; right:28px; display:flex; align-items:center; justify-content:space-between; font-size:13px; font-weight:500; }\n  #iwr-night-conditional [data-record] { color:#FF0000; font-family:ui-monospace,monospace; font-size:11px; }\n  #iwr-night-conditional [hidden] { display:none; }\n  #iwr-night-conditional .nc-controls { position:absolute; top:62px; left:20px; right:20px; display:flex; align-items:center; gap:24px; height:44px; }\n  #iwr-night-conditional .nc-circle { width:44px; height:44px; flex:none; display:grid; place-items:center; border-radius:50%; background:#141414; box-shadow:inset 0 0 0 1px #303030; }\n  #iwr-night-conditional .nc-circle svg { width:20px; height:20px; stroke-width:1.5; }\n  #iwr-night-conditional canvas { display:block; height:44px; width:100%; flex:1; min-width:0; }\n  #iwr-night-conditional .nc-pads { display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--nc-divider); }\n  #iwr-night-conditional .nc-pads>div { display:grid; place-items:center; height:120px; background:var(--nc-pad); color:#929292; }\n  #iwr-night-conditional .nc-pads svg { width:18px; height:18px; }\n  #iwr-night-conditional .nc-spec { margin-top:10px; }\n  #iwr-night-conditional .nc-caption { margin-top:16px; min-height:44px; }\n  @media(max-width:630px) { #iwr-night-conditional .nc-layout { grid-template-columns:minmax(0,1fr); gap:18px; } #iwr-night-conditional .nc-stage { width:100%; max-width:402px; margin:auto; } }\n</style>\n<script>\n(() => {\n  const root=document.getElementById('iwr-night-conditional');\n  const canvas=root.querySelector('canvas'),ctx=canvas.getContext('2d');\n  const pause=root.querySelector('[data-pause]'),caption=root.querySelector('[data-description]');\n  const reduced=matchMedia('(prefers-reduced-motion: reduce)');\n  const state={style:'confidence',mode:'play',paused:reduced.matches,accent:true};\n  const names={confidence:'Confidence Fence',closure:'Vector Closure',escapement:'Cycle Escapement',detour:'Reversible Detour',mutation:'Mutation Quota'};\n  const descriptions={\n    confidence:['Tahmin ile kayıt karşılaşıyor; uyuşmazlık dar aralığı yeniden açıyor.','Son üç örnek yakınsadıkça köşeler daralıyor; aykırı örnek aralığı genişletiyor.'],\n    closure:['İki güçlü hareket birbirini silebiliyor; üçüncü kenar her zaman tam toplamı kapatıyor.','İlk yön tutuluyor, ikinci ekleniyor; ancak ikisi tamamlanınca kapanış çiziliyor.'],\n    escapement:['Küçük sayaç her vuruşta ilerliyor; büyük iz yalnız dördüncü vuruşta yer değiştiriyor.','Üç girişten yalnız biri yeni bir çıkış yazıyor; diğer girişler küçük sayacı ilerletiyor.'],\n    detour:['Sağdaki geçici değişimler siliniyor; şekil soldaki özgün kayda eksiksiz dönüyor.','Değişiklikler sağda birikiyor; bırakınca tümü atılıyor, ilk kayıt aynen geri geliyor.'],\n    mutation:['Aynı yedi parça tekrar tekrar okunuyor; üç turda yalnız bir parça değişebiliyor.','Bir değişiklik hakkı geliyor; tur bitince tek parçaya harcanıyor, diğer altısı korunuyor.']\n  };\n  const white='#f1f0e8',amber='#FF0000';\n  let w=226,dpr=1,t=2.4,last=0,raf=0,visible=true;\n  const clamp=(x,a=0,b=1)=>Math.min(b,Math.max(a,x));\n  // Live sound seam: iwrSignal exists only inside the archive gallery. Without it, or with sound off, nothing changes.\n  const hearing=()=>typeof iwrSignal!=='undefined'&&iwrSignal.active?iwrSignal:null;\n  // Time-driven machines move on the beat and rest between hits; the studies' own dt clamps still apply first.\n  const conduct=()=>{const s=hearing();return s?0.25+4.2*s.hit:1;};\n  const mod=(x,n)=>(x%n+n)%n;\n  const accent=()=>state.accent?amber:white;\n  function ink(alpha=1,color=white){ctx.globalAlpha=clamp(alpha);ctx.fillStyle=color;ctx.strokeStyle=color;}\n  function rect(x,y,width,height,alpha=1,color=white){ink(alpha,color);ctx.fillRect(Math.round(x*dpr)/dpr,Math.round(y*dpr)/dpr,width,height);}\n  function line(points,alpha=1,color=white){if(points.length<2)return;ink(alpha,color);ctx.lineWidth=1;ctx.lineCap='butt';ctx.lineJoin='miter';ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(...p):ctx.moveTo(...p));ctx.stroke();}\n  // Synthetic observations and schedules only. No audio analysis or device access.\n  const observations=[-.45,.3,-.12,.07,.1,.08,.58,.13,.11,.1,-.35,.08];\n  function confidenceState(time,recording){\n    const phase=mod(time,9.6),event=Math.min(11,Math.floor((phase+1e-10)/.8)),age=Math.max(0,phase-event*.8);\n    const previous=[2,1,0].map(offset=>observations[mod(event-1-offset,12)]),prediction=previous.reduce((a,b)=>a+b,0)/3;\n    const actual=observations[event],revealed=recording||age>=.2;\n    const candidates=recording?[2,1,0].map(offset=>observations[mod(event-offset,12)]):(revealed?[prediction,actual]:[prediction]);\n    const center=candidates.reduce((a,b)=>a+b,0)/candidates.length;\n    const radius=Math.max(.075,...candidates.map(value=>Math.abs(value-center)+.04));\n    return {event,age,center,radius,candidates,prediction,actual,revealed};\n  }\n  function confidence(time){\n    const recording=state.mode==='record',s=confidenceState(time,recording),map=value=>w/2+value*(w-26)/1.5;\n    const l=map(s.center-s.radius),r=map(s.center+s.radius),c=map(s.center);\n    line([[l+5,10],[l,10],[l,16]],.75);line([[l,28],[l,34],[l+5,34]],.75);\n    line([[r-5,10],[r,10],[r,16]],.75);line([[r,28],[r,34],[r-5,34]],.75);\n    line([[c-2,20],[c+2,24]],1);\n    s.candidates.forEach((value,i)=>{const x=map(value),y=recording?16+i*6:(i?28:16);line([[x,y-3],[x,y+3]],.9,i===s.candidates.length-1&&s.age<.36?accent():white);});\n    if(!recording&&s.revealed&&Math.abs(s.actual-s.prediction)>.2&&s.age<.36)line([[map(s.prediction),37],[map(s.actual),37]],1,accent());\n  }\n  function closureState(time,recording){\n    const phase=mod(time,3.6),stage=Math.min(2,Math.floor((phase+1e-10)/1.2));\n    const sample=recording?Math.floor(time/3.6)*.91:time*.65;\n    const a=[w*(.34+.08*Math.sin(sample*.7)),11*Math.sin(sample)],sum=[w*.14*Math.sin(sample*1.7),12*Math.sin(sample*.8)];\n    const b=[sum[0]-a[0],sum[1]-a[1]],origin=[w*.24,22];\n    return {a,b,sum,origin,stage};\n  }\n  function closure(time){\n    const recording=state.mode==='record',{a,b,sum,origin:o,stage}=closureState(time,recording);\n    const p=[o[0]+a[0],o[1]+a[1]],q=[p[0]+b[0],p[1]+b[1]];\n    line([[o[0]-3,o[1]-3],[o[0]-3,o[1]+3],[o[0]+2,o[1]+3]],.45);\n    line([o,p],.65);line([[p[0]-2,p[1]-2],[p[0]+2,p[1]+2]],.9);\n    if(!recording||stage>=1){line([p,q],1);line([[q[0]-2,q[1]+2],[q[0]+2,q[1]-2]],1);}\n    if(!recording||stage>=2){line([q,o],.9,accent());if(Math.hypot(...sum)<3)rect(o[0]-1,o[1]-1,2,2,1,accent());}\n  }\n  function escapementState(time,n){const beat=Math.floor((time+1e-10)/.52);return {beat,remainder:beat%n,carry:Math.floor(beat/n),age:Math.max(0,time-beat*.52)};}\n  function escapement(time){\n    const recording=state.mode==='record',n=recording?3:4,s=escapementState(time,n),pitch=7;\n    for(let i=0;i<n;i++){const x=7+i*7,y=12+i*5;line([[x,y],[x+5,y],[x+5,y+3]],.35);}\n    const mx=7+s.remainder*7,my=12+s.remainder*5;\n    line([[mx-2,my-3],[mx+5,my-3]],1,s.age<.16?accent():white);\n    const left=46,span=w-left-10,output=mod(s.carry,5),x=left+span*(output+.5)/5;\n    line([[x,10],[x,34]],1);line([[x-5,10],[x,10],[x,15]],.85);line([[x,29],[x,34],[x+5,34]],.85);\n    if(s.remainder===0&&s.age<.18){line([[x-4,38],[x+4,38]],1,accent());if(recording)rect(x-1,5,2,2,1,accent());}\n  }\n  const references=[[-2,-10,7,-4,3],[5,-5,-9,8,-2],[-7,6,10,-6,2]];\n  const edits=[[0,5,-4,0,0],[0,0,5,-7,0],[0,-4,0,5,0]];\n  function detourState(time,recording){\n    const cycle=Math.floor((time+1e-10)/4.8),phase=Math.max(0,time-cycle*4.8),reference=references[mod(cycle,3)].slice();\n    const active=phase>=.8&&phase<3.2,change=active?Math.min(3,Math.floor((phase+1e-10)/.8)):0;\n    const current=reference.slice();\n    for(let e=0;e<change;e++)for(let j=0;j<5;j++)current[j]+=edits[e][j];\n    if(active&&!recording){const amount=2*Math.sin((phase-.8)*Math.PI/.8);current[2]+=amount;current[3]-=amount;}\n    return {cycle,phase,reference,current,active,restored:phase>=3.2};\n  }\n  function detour(time){\n    const s=detourState(time,state.mode==='record'),width=(w-34)/2,xs=[0,.17,.43,.78,1];\n    const points=(values,offset)=>values.map((value,i)=>[offset+xs[i]*width,22+value]);\n    line(points(s.reference,6),.6);line(points(s.current,w/2+11),1);\n    if(s.active){line([[w/2+11,38],[w/2+11+width,38]],.65,accent());}\n    else if(s.restored&&s.phase<3.4){line([[w/2-3,18],[w/2-3,26]],1,accent());}\n  }\n  const mutationSeed=[0,1,2,0,2,1,0];\n  function mutationState(time,recording){\n    const period=recording?1.4:1.12,cycle=period*63,phase=mod(time,cycle),pass=Math.min(62,Math.floor((phase+1e-10)/period)),age=Math.max(0,phase-pass*period),editsDone=Math.floor(pass/3);\n    const values=mutationSeed.slice();for(let e=0;e<editsDone;e++){const slot=e*3%7;values[slot]=(values[slot]+1)%3;}\n    const changed=pass%3===0?mod((editsDone-1)*3,7):-1,pending=pass%3===2&&age>=period*.65;\n    return {values,pass,age,period,changed,pending,reader:clamp(age/period),editsDone};\n  }\n  function mutation(time){\n    const recording=state.mode==='record',s=mutationState(time,recording),pitch=(w-20)/7;\n    s.values.forEach((value,i)=>{\n      const x=10+(i+.5)*pitch,half=3+(i%3),dx=value===0?-3:value===1?3:0;\n      line([[x-dx,22-half],[x+dx,22+half]],.95);\n      if(i===s.changed&&s.age<.2)line([[x-4,33],[x+4,33]],1,accent());\n    });\n    const x=10+s.reader*(w-20);line([[x,8],[x,13]],.9);\n    if(recording&&s.pending)line([[w-11,4],[w-5,4]],1,accent());\n  }\n  const renderers={confidence,closure,escapement,detour,mutation};\n  function draw(){ctx.clearRect(0,0,w,44);ctx.save();ctx.beginPath();ctx.rect(0,0,w,44);ctx.clip();renderers[state.style](t);ctx.restore();}\n  function sync(){\n    root.querySelectorAll('[data-style]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.style===state.style)));\n    root.querySelectorAll('[data-mode]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.mode===state.mode)));\n    const description=descriptions[state.style][state.mode==='record'?1:0];caption.textContent=description;canvas.setAttribute('aria-label',names[state.style]+': '+description);\n    root.querySelector('[data-record]').hidden=state.mode!=='record';pause.textContent=state.paused?'Devam et':'Duraklat';pause.setAttribute('aria-pressed',String(state.paused));draw();schedule();\n  }\n  function resize(){w=Math.max(1,canvas.getBoundingClientRect().width);dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(w*dpr);canvas.height=44*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);draw();}\n  function schedule(){if(!raf&&!state.paused&&visible&&!document.hidden&&root.isConnected){last=0;raf=requestAnimationFrame(frame);}}\n  function frame(now){raf=0;if(state.paused||!visible||document.hidden||!root.isConnected)return;if(!last)last=now;const elapsed=now-last;if(elapsed>=1000/30){t+=Math.min(elapsed/1000,.07)*conduct();last=now;draw();}raf=requestAnimationFrame(frame);}\n  root.querySelectorAll('[data-style]').forEach(el=>el.addEventListener('click',()=>{state.style=el.dataset.style;sync();}));\n  root.querySelectorAll('[data-mode]').forEach(el=>el.addEventListener('click',()=>{state.mode=el.dataset.mode;sync();}));\n  pause.addEventListener('click',()=>{state.paused=!state.paused;sync();});reduced.addEventListener('change',()=>{state.paused=reduced.matches;sync();});\n  document.addEventListener('visibilitychange',schedule);new ResizeObserver(resize).observe(canvas);\n  new IntersectionObserver(entries=>{const latest=entries.reduce((a,b)=>b.target===root&&(!a||b.time>=a.time)?b:a,null);if(latest){visible=latest.isIntersecting;schedule();}}).observe(root);\n  resize();sync();\n  if(globalThis.Tweak){const tweak=new Tweak({container:root.querySelector('.nc-phone'),onChange:sync});tweak.addToggle(state,'accent',{label:'Kehribar vurgu'});}\n})();\n</script>\n","css":":root{color-scheme:dark;--background:#000;--foreground:#eee;--muted-foreground:#999}*{box-sizing:border-box}body{margin:0;padding:24px;background:#000;color:#eee;font:16px/1.5 Arial,Helvetica,sans-serif}button{font:inherit;cursor:pointer}.viz-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:24px}.btn{color:#bbb;background:#141414;border:1px solid #333;border-radius:6px;min-height:44px;padding:9px 14px;text-align:left}.btn[aria-pressed=true]{color:#fff;border-color:#ddd;background:#262626}.btn-block{width:100%}.text-small{font-size:14px}.text-muted{color:#999}:focus-visible{outline:2px solid #fff;outline-offset:3px}[hidden]{display:none!important}h3{font-size:18px;font-weight:500}figcaption{font-size:16px}canvas{max-width:100%}@media(max-width:520px){body{padding:16px}}"}