{"html":"<div id=\"iwr-night-procedural\" aria-label=\"Set 15: Procedural Marks, beş hareketli ses ekranı\">\n  <div class=\"viz-controls\">\n    <button type=\"button\" class=\"btn\" data-mode=\"play\" aria-pressed=\"true\">Çalma</button>\n    <button type=\"button\" class=\"btn\" data-mode=\"record\" aria-pressed=\"false\">Kayıt</button>\n    <button type=\"button\" class=\"btn btn-ghost\" data-pause aria-pressed=\"false\">Duraklat</button>\n    <span class=\"text-small text-muted\">Örnek ses ritmi · sessiz demo</span>\n  </div>\n  <div class=\"pm-layout\">\n    <div class=\"pm-stage\">\n      <div class=\"pm-phone\" aria-label=\"iwrzwr: Procedural Marks önizlemesi\">\n        <div class=\"pm-header\">\n          <div class=\"pm-status\" aria-hidden=\"true\"><span>9:41</span><span data-record hidden>REC</span><span>••• &nbsp; ▰</span></div>\n          <div class=\"pm-controls\">\n            <div class=\"pm-circle\" aria-hidden=\"true\"></div>\n            <canvas role=\"img\" aria-label=\"Order Residue: aynı aralığa iki işlem sırasının etkisi\"></canvas>\n            <div class=\"pm-circle\" aria-hidden=\"true\"><i data-lucide=\"plus\"></i></div>\n          </div>\n        </div>\n        <div class=\"pm-pads\" aria-hidden=\"true\"><div><i data-lucide=\"mic\"></i></div><div><i data-lucide=\"mic\"></i></div></div>\n      </div>\n      <div class=\"text-small text-muted pm-spec\">126px header · 44px alan · 24px boşluk</div>\n    </div>\n    <div class=\"pm-options\" role=\"group\" aria-label=\"Procedural Marks seçenekleri\">\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"order\" aria-pressed=\"true\">1 · Order Residue</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"packing\" aria-pressed=\"false\">2 · Euclidean Packing</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"escrow\" aria-pressed=\"false\">3 · Error Escrow</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"product\" aria-pressed=\"false\">4 · Series Product</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"nested\" aria-pressed=\"false\">5 · Nested Span</button>\n    </div>\n  </div>\n  <div class=\"pm-caption\" data-description aria-live=\"polite\">Üst: kes → kaydır. Alt: kaydır → kes. Vurgu yalnız sonuçların farklı kalan parçalarında.</div>\n</div>\n<style>\n  #iwr-night-procedural .pm-layout { display:grid; grid-template-columns:minmax(0,402px) minmax(190px,1fr); gap:24px; align-items:center; margin-top:20px; }\n  #iwr-night-procedural .pm-stage { min-width:0; }\n  #iwr-night-procedural .pm-options { display:grid; gap:8px; }\n  #iwr-night-procedural .pm-phone { --pm-screen:#000; --pm-pad:#cdcdcd; --pm-divider:#b6b6b6; --pm-ink:#f1f0e8; color:var(--pm-ink); background:var(--pm-pad); border-radius:30px; overflow:hidden; font-family:-apple-system,BlinkMacSystemFont,sans-serif; }\n  #iwr-night-procedural .pm-header { height:126px; position:relative; background:var(--pm-screen); border-radius:0 0 32px 40px; }\n  #iwr-night-procedural .pm-status { position:absolute; top:24px; left:28px; right:28px; display:flex; align-items:center; justify-content:space-between; font-size:13px; font-weight:500; }\n  #iwr-night-procedural [data-record] { color:#FF0000; font-family:ui-monospace,monospace; font-size:11px; }\n  #iwr-night-procedural [hidden] { display:none; }\n  #iwr-night-procedural .pm-controls { position:absolute; top:62px; left:20px; right:20px; display:flex; align-items:center; gap:24px; height:44px; }\n  #iwr-night-procedural .pm-circle { width:44px; height:44px; flex:none; display:grid; place-items:center; border-radius:50%; background:#141414; box-shadow:inset 0 0 0 1px #303030; }\n  #iwr-night-procedural .pm-circle svg { width:20px; height:20px; stroke-width:1.5; }\n  #iwr-night-procedural canvas { display:block; height:44px; width:100%; flex:1; min-width:0; }\n  #iwr-night-procedural .pm-pads { display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--pm-divider); }\n  #iwr-night-procedural .pm-pads>div { display:grid; place-items:center; height:120px; background:var(--pm-pad); color:#929292; }\n  #iwr-night-procedural .pm-pads svg { width:18px; height:18px; }\n  #iwr-night-procedural .pm-spec { margin-top:10px; }\n  #iwr-night-procedural .pm-caption { margin-top:16px; min-height:44px; }\n  @media(max-width:630px) { #iwr-night-procedural .pm-layout { grid-template-columns:minmax(0,1fr); gap:18px; } #iwr-night-procedural .pm-stage { width:100%; max-width:402px; margin:auto; } }\n</style>\n<script>\n(() => {\n  const root=document.getElementById('iwr-night-procedural');\n  const canvas=root.querySelector('canvas'),ctx=canvas.getContext('2d');\n  const pause=root.querySelector('[data-pause]'),caption=root.querySelector('[data-description]');\n  const reduced=matchMedia('(prefers-reduced-motion: reduce)');\n  const state={style:'order',mode:'play',paused:reduced.matches,accent:true};\n  const names={order:'Order Residue',packing:'Euclidean Packing',escrow:'Error Escrow',product:'Series Product',nested:'Nested Span'};\n  const descriptions={\n    order:['Üst: kes → kaydır. Alt: kaydır → kes. Vurgu yalnız sonuçların farklı kalan parçalarında.','Önce aynı girdi toplanıyor; bırakılınca iki işlem sırası aynı donmuş aralığa uygulanıyor.'],\n    packing:['Aynı işaretler korunuyor; aralarındaki döngüsel boşluklar dengeleniyor.','Darbeler önce birikiyor; sonra işaret eklemeden veya silmeden yerleri dağıtılıyor.'],\n    escrow:['Soluk uçlar istek, düz gövde yuvarlanmış değer; kısa alt kol taşınan artı/eksi fark.','Her yeni istek önceki yuvarlama farkını devralıyor; fark hiçbir adımda kaybolmuyor.'],\n    product:['Üç çarpan çifti aynı çıkışı veriyor; ortadaki ölçü yine de farklı kalıyor.','Bir çarpan yazılıyor; yalnız ona bağlı sonraki ölçüler değişiyor.'],\n    nested:['Soldaki üst aralık değişince alt aralıkları miras alıyor; sağ dal sabit kalıyor.','Her darbe tek üst sınırı yazıyor; alt dalların göreli payları aynen korunuyor.']\n  };\n  const white='#f1f0e8',amber='#FF0000';\n  let w=226,dpr=1,t=2.4,last=0,raf=0,visible=true;\n  const clamp=(x,a=0,b=1)=>Math.min(b,Math.max(a,x)),mod=(x,n)=>(x%n+n)%n,mix=(a,b,q)=>a+(b-a)*q;\n  function phaseAt(time,period) { const cycle=Math.floor((time+1e-10)/period);return {cycle,clock:Math.max(0,time-cycle*period)}; }\n  const accent=()=>state.accent?amber:white;\n  function ink(alpha=1,color=white) { ctx.globalAlpha=clamp(alpha);ctx.fillStyle=color;ctx.strokeStyle=color; }\n  function rect(x,y,width,height,alpha=1,color=white) { ink(alpha,color);ctx.fillRect(Math.round(x*dpr)/dpr,Math.round(y*dpr)/dpr,width,height); }\n  function line(points,alpha=1,color=white) { if(points.length<2)return;ink(alpha,color);ctx.lineWidth=1;ctx.lineCap='butt';ctx.lineJoin='miter';ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]));ctx.stroke(); }\n  // Deterministic synthetic transactions. No microphone, audio playback, or device emulation.\n  function intersect(interval,bounds=[-.5,.5]) { if(!interval)return null;const a=Math.max(interval[0],bounds[0]),b=Math.min(interval[1],bounds[1]);return a<=b?[a,b]:null; }\n  function translate(interval,offset) { return interval?interval.map(value=>value+offset):null; }\n  function subtract(interval,other) {\n    if(!interval)return [];const overlap=intersect(interval,other||[Infinity,Infinity]);\n    if(!overlap)return [interval];const pieces=[];if(interval[0]<overlap[0])pieces.push([interval[0],overlap[0]]);if(overlap[1]<interval[1])pieces.push([overlap[1],interval[1]]);return pieces;\n  }\n  function orderedResults(input,shift) { const first=[intersect(input),translate(input,shift)],final=[translate(first[0],shift),intersect(first[1])];return {first,final,difference:[subtract(final[0],final[1]),subtract(final[1],final[0])]}; }\n  const orderInputs=[[-.8,-.3,.08,.62,.8],[-.42,-.21,.06,.2,.41],[-.65,-.24,.02,.18,.45]],orderShifts=[.3,0,-.25];\n  function orderModel(time,recording) {\n    const period=recording?5.2:3.2,{cycle,clock}=phaseAt(time,period),phrase=mod(cycle,3),samples=orderInputs[phrase];\n    const count=recording?Math.min(5,Math.floor((clock+1e-10)/.4)+1):5,intake=recording&&clock<2,values=samples.slice(0,count),input=[Math.min(...values),Math.max(...values)],shift=orderShifts[phrase],result=orderedResults(input,shift);\n    const stage=recording?(clock<2?0:clock<2.7?1:2):(clock<.55?0:clock<1.2?1:2);\n    return {clock,phrase,count,input,shift,stage,intake,...result,shown:stage===0?[input,input]:stage===1?result.first:result.final};\n  }\n  function order(time) {\n    const m=orderModel(time,state.mode==='record'),x=value=>8+(value+1.25)/2.5*(w-16);\n    line([[x(m.input[0]),22],[x(m.input[1]),22]],.22);line([[x(0),20],[x(0),24]],.42);\n    [12,32].forEach((y,lane)=>{\n      const interval=m.shown[lane];\n      for(const bound of[-.5,.5])line([[x(bound),y-6],[x(bound),y-4]],.3);\n      if(interval){line([[x(interval[0]),y],[x(interval[1]),y]],.95);line([[x(interval[0]),y-3],[x(interval[0]),y+3]],.7);line([[x(interval[1]),y-3],[x(interval[1]),y+3]],.7);}\n      if(m.stage===2)m.difference[lane].forEach(piece=>line([[x(piece[0]),y],[x(piece[1]),y]],1,accent()));\n    });\n  }\n  const packingCohorts=[[0,1,7,8,15],[0,1,2,7,9,14,15]];\n  function balancedSlots(slots,count) { return Array.from({length:count},(_,i)=>Math.floor(i*slots/count)); }\n  function circularGaps(positions,slots) { return positions.map((position,i)=>i+1<positions.length?positions[i+1]-position:slots+positions[0]-position); }\n  function packingModel(time,recording) {\n    const period=recording?6:4.8,{cycle,clock}=phaseAt(time,period),phrase=mod(cycle,2),source=packingCohorts[phrase],target=balancedSlots(16,source.length);\n    const count=recording?Math.min(source.length,Math.floor((clock+1e-10)/.4)+1):source.length,begin=recording?3:.7,duration=recording?.9:1.2,amount=clamp((clock-begin)/duration);\n    const events=source.slice(0,count).map((slot,index)=>({id:phrase+':'+index,source:slot,target:target[index],position:mix(slot,target[index],amount)}));\n    return {clock,phrase,count,source,target,events,amount,packing:amount>0&&amount<1};\n  }\n  function packing(time) {\n    const m=packingModel(time,state.mode==='record'),x=position=>8+position/16*(w-16);\n    for(let slot=0;slot<16;slot++)line([[x(slot),33],[x(slot),35]],.28);\n    line([[8,37],[8,40],[12,40]],.28);line([[w-12,40],[w-8,40],[w-8,37]],.28);\n    for(const event of m.events) {\n      if(m.packing)line([[x(event.source)-1.5,8],[x(event.source)+1.5,8]],.32);\n      const at=x(event.position);line([[at-1.5,15],[at+1.5,15]],.94,m.packing?accent():white);line([[at,15],[at,27]],.94,m.packing?accent():white);\n    }\n  }\n  const requests=[9.5,10.5,7.25,13.75,11.5,8.5,14.25,5.75,9,7,12.5,10.5];\n  function quantizeSeries(values,initial=0,step=4) {\n    let residual=initial,requested=0,committed=0;\n    return values.map((request,index)=>{const incoming=residual,adjusted=request+incoming,quantized=step*Math.round(adjusted/step);residual=adjusted-quantized;requested+=request;committed+=quantized;return {index,request,incoming,adjusted,quantized,residual,requested,committed};});\n  }\n  const quantizedRequests=quantizeSeries(requests);\n  function escrowModel(time,recording) {\n    const {clock}=phaseAt(time,6),reading=clock<4.8,active=reading?Math.min(11,Math.floor((clock+1e-10)/.4)):-1,count=recording?(reading?active+1:12):12;\n    return {clock,active,count,records:quantizedRequests.slice(0,count),residual:count?quantizedRequests[count-1].residual:0};\n  }\n  function escrow(time) {\n    const m=escrowModel(time,state.mode==='record'),x=index=>8+(index+.5)*(w-16)/12;\n    m.records.forEach(record=>{\n      const at=x(record.index),active=record.index===m.active;\n      line([[at-2,22-record.request/2],[at+2,22-record.request/2]],.38);line([[at-2,22+record.request/2],[at+2,22+record.request/2]],.38);\n      line([[at,22-record.quantized/2],[at,22+record.quantized/2]],.92,active?accent():white);\n      if(active){line([[at,35],[at,39]],.35);line([[at,37],[at+record.residual*2,37]],1,accent());if(Math.abs(record.residual)<1e-10)line([[at-1,37],[at+1,37]],.6);}\n    });\n  }\n  const gainPairs=[[.5,2],[1,1],[2,.5],[1,.5],[2,1],[.5,1]],gainEdits=[[0,.5],[1,2],[0,1],[1,1],[0,2],[1,.5],[0,1],[1,1]];\n  const recordedGains=[];let gainSeed=[1,1];for(const [index,value] of gainEdits){gainSeed=[...gainSeed];gainSeed[index]=value;recordedGains.push(gainSeed);}\n  function seriesProduct(input,gains) { const intermediate=input*gains[0],output=intermediate*gains[1];return [input,intermediate,output]; }\n  function productModel(time,recording) {\n    const period=recording?.9:1.4,{cycle:step,clock:age}=phaseAt(time,period),index=mod(step,recording?8:6),gains=recording?recordedGains[index]:gainPairs[index],changed=recording?gainEdits[index][0]:-1;\n    return {gains,lengths:seriesProduct(8,gains),changed,age};\n  }\n  function product(time) {\n    const m=productModel(time,state.mode==='record'),centers=[w*.17,w*.5,w*.83];\n    [w*.335,w*.665].forEach(x=>line([[x,18],[x,26]],.22));\n    m.lengths.forEach((length,index)=>{\n      const center=centers[index],left=center-length/2,right=center+length/2,affected=m.changed>=0&&index>m.changed;\n      line([[left,18],[left,26]],.74);line([[left,22],[right,22]],.98,affected&&m.age<.25?accent():white);line([[right,18],[right,26]],.74);\n      line([[center-4,32],[center+4,32]],.22);\n    });\n  }\n  const treeTemplate=[\n    {id:'A',span:[.06,.54],children:[\n      {id:'A1',span:[.06,.38],children:[{id:'A1a',span:[.2,.74]}]},\n      {id:'A2',span:[.55,.93],children:[{id:'A2a',span:[.35,.85]}]}\n    ]},\n    {id:'B',span:[.67,.96],children:[\n      {id:'B1',span:[.08,.43],children:[{id:'B1a',span:[.1,.56]}]},\n      {id:'B2',span:[.62,.92],children:[{id:'B2a',span:[.26,.9]}]}\n    ]}\n  ];\n  const savedSpans=[[.06,.54],[.11,.44],[.035,.59],[.14,.55]],spanEdits=[[1,.44],[0,.12],[1,.59],[0,.035],[1,.54],[0,.06]];\n  const recordedSpans=[];let spanSeed=[.06,.54];for(const [index,value] of spanEdits){spanSeed=[...spanSeed];spanSeed[index]=value;recordedSpans.push(spanSeed);}\n  function mapNested(roots,override) {\n    const nodes=[];\n    function visit(node,parent=[0,1],depth=0,parentId=null) {\n      const fractions=node.id==='A'?override:node.span,world=fractions.map(value=>parent[0]+value*(parent[1]-parent[0]));\n      nodes.push({id:node.id,parentId,depth,fractions:[...fractions],world});(node.children||[]).forEach(child=>visit(child,world,depth+1,node.id));\n    }\n    roots.forEach(node=>visit(node));return nodes;\n  }\n  function nestedModel(time,recording) {\n    let span,changed=-1,age=0;\n    if(recording){const phase=phaseAt(time,.8),index=mod(phase.cycle,6);span=recordedSpans[index];changed=spanEdits[index][0];age=phase.clock;}\n    else {const phase=phaseAt(time,1.4),index=mod(phase.cycle,4),previous=savedSpans[mod(index-1,4)];span=previous.map((value,i)=>mix(value,savedSpans[index][i],clamp(phase.clock/.65)));}\n    return {span,changed,age,nodes:mapNested(treeTemplate,span)};\n  }\n  function nested(time) {\n    const m=nestedModel(time,state.mode==='record'),x=value=>5+value*(w-10);\n    m.nodes.forEach(node=>{\n      const left=x(node.world[0]),right=x(node.world[1]),y=8+node.depth*13,primary=node.depth===0;\n      line([[left,y+3],[left,y],[right,y],[right,y+3]],primary?.9:.76);\n      if(node.depth<2&&node.parentId){const middle=(left+right)/2;line([[middle,y-8],[middle,y-4]],.2);}\n      if(node.id==='A'&&m.changed>=0&&m.age<.25){const edge=m.changed?right:left;line([[edge,y-2],[edge,y+4]],1,accent());}\n    });\n  }\n  const renderers={order,packing,escrow,product,nested};\n  function draw() { ctx.clearRect(0,0,w,44);ctx.save();ctx.beginPath();ctx.rect(0,0,w,44);ctx.clip();renderers[state.style](t);ctx.restore(); }\n  function sync() {\n    root.querySelectorAll('[data-style]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.style===state.style)));\n    root.querySelectorAll('[data-mode]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.mode===state.mode)));\n    const description=descriptions[state.style][state.mode==='record'?1:0];caption.textContent=description;canvas.setAttribute('aria-label',names[state.style]+': '+description);\n    root.querySelector('[data-record]').hidden=state.mode!=='record';pause.textContent=state.paused?'Devam et':'Duraklat';pause.setAttribute('aria-pressed',String(state.paused));draw();schedule();\n  }\n  function resize() { w=Math.max(1,canvas.getBoundingClientRect().width);dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(w*dpr);canvas.height=44*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);draw(); }\n  function schedule() { if(!raf&&!state.paused&&visible&&!document.hidden&&root.isConnected) { last=0;raf=requestAnimationFrame(frame); } }\n  function frame(now) { raf=0;if(state.paused||!visible||document.hidden||!root.isConnected)return;if(!last)last=now;const elapsed=now-last;if(elapsed>=1000/30){t+=Math.min(elapsed/1000,.07);last=now;draw();}raf=requestAnimationFrame(frame); }\n  root.querySelectorAll('[data-style]').forEach(el=>el.addEventListener('click',()=>{state.style=el.dataset.style;sync();}));\n  root.querySelectorAll('[data-mode]').forEach(el=>el.addEventListener('click',()=>{state.mode=el.dataset.mode;sync();}));\n  pause.addEventListener('click',()=>{state.paused=!state.paused;sync();});\n  reduced.addEventListener('change',()=>{state.paused=reduced.matches;sync();});\n  document.addEventListener('visibilitychange',schedule);\n  new ResizeObserver(resize).observe(canvas);\n  new IntersectionObserver(entries=>{\n    const latest=entries.filter(entry=>entry.target===root).reduce((a,b)=>!a||b.time>=a.time?b:a,null);\n    if(latest){visible=latest.isIntersecting;schedule();}\n  }).observe(root);\n  resize();sync();\n  if(globalThis.Tweak){const tweak=new Tweak({container:root.querySelector('.pm-phone'),onChange:sync});tweak.addToggle(state,'accent',{label:'Kehribar vurgu'});}\n})();\n</script>\n","css":":root{color-scheme:dark;--background:#000;--foreground:#eee;--muted-foreground:#999}*{box-sizing:border-box}body{margin:0;padding:24px;background:#000;color:#eee;font:16px/1.5 Arial,Helvetica,sans-serif}button{font:inherit;cursor:pointer}.viz-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:24px}.btn{color:#bbb;background:#141414;border:1px solid #333;border-radius:6px;min-height:44px;padding:9px 14px;text-align:left}.btn[aria-pressed=true]{color:#fff;border-color:#ddd;background:#262626}.btn-block{width:100%}.text-small{font-size:14px}.text-muted{color:#999}:focus-visible{outline:2px solid #fff;outline-offset:3px}[hidden]{display:none!important}h3{font-size:18px;font-weight:500}figcaption{font-size:16px}canvas{max-width:100%}@media(max-width:520px){body{padding:16px}}"}