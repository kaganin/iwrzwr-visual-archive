{"html":"<div id=\"iwr-night-laws\" aria-label=\"Set 09: Control Laws, beş hareketli ses ekranı\">\n  <div class=\"viz-controls\">\n    <button type=\"button\" class=\"btn\" data-mode=\"play\" aria-pressed=\"true\">Çalma</button>\n    <button type=\"button\" class=\"btn\" data-mode=\"record\" aria-pressed=\"false\">Kayıt</button>\n    <button type=\"button\" class=\"btn btn-ghost\" data-pause aria-pressed=\"false\">Duraklat</button>\n    <span class=\"text-small text-muted\">Örnek ses ritmi · sessiz demo</span>\n  </div>\n  <div class=\"nl-layout\">\n    <div class=\"nl-stage\">\n      <div class=\"nl-phone\" aria-label=\"iwrzwr: Control Laws önizlemesi\">\n        <div class=\"nl-header\">\n          <div class=\"nl-status\" aria-hidden=\"true\"><span>9:41</span><span data-record hidden>REC</span><span>••• &nbsp; ▰</span></div>\n          <div class=\"nl-controls\">\n            <div class=\"nl-circle\" aria-hidden=\"true\"></div>\n            <canvas role=\"img\" aria-label=\"Quantized Handoff: sıradaki örnek ancak cümle bitiminde devreye giriyor\"></canvas>\n            <div class=\"nl-circle\" aria-hidden=\"true\"><i data-lucide=\"plus\"></i></div>\n          </div>\n        </div>\n        <div class=\"nl-pads\" aria-hidden=\"true\"><div><i data-lucide=\"mic\"></i></div><div><i data-lucide=\"mic\"></i></div></div>\n      </div>\n      <div class=\"text-small text-muted nl-spec\">126px header · 44px alan · 24px boşluk</div>\n    </div>\n    <div class=\"nl-options\" role=\"group\" aria-label=\"Control Laws seçenekleri\">\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"handoff\" aria-pressed=\"true\">1 · Quantized Handoff</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"clipped\" aria-pressed=\"false\">2 · Clipped Travel</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"ratchet\" aria-pressed=\"false\">3 · Retrigger Ratchet</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"lease\" aria-pressed=\"false\">4 · Context Lease</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"schmitt\" aria-pressed=\"false\">5 · Schmitt Memory</button>\n    </div>\n  </div>\n  <div class=\"nl-caption\" data-description aria-live=\"polite\">Sonraki örnek hazır bekliyor; yalnız dört vuruşluk cümle bitince devreye giriyor.</div>\n</div>\n<style>\n  #iwr-night-laws .nl-layout { display:grid; grid-template-columns:minmax(0,402px) minmax(190px,1fr); gap:24px; align-items:center; margin-top:20px; }\n  #iwr-night-laws .nl-stage { min-width:0; }\n  #iwr-night-laws .nl-options { display:grid; gap:8px; }\n  #iwr-night-laws .nl-phone { --nl-screen:#000; --nl-pad:#cdcdcd; --nl-divider:#b6b6b6; --nl-ink:#f1f0e8; color:var(--nl-ink); background:var(--nl-pad); border-radius:30px; overflow:hidden; font-family:-apple-system,BlinkMacSystemFont,sans-serif; }\n  #iwr-night-laws .nl-header { height:126px; position:relative; background:var(--nl-screen); border-radius:0 0 32px 40px; }\n  #iwr-night-laws .nl-status { position:absolute; top:24px; left:28px; right:28px; display:flex; align-items:center; justify-content:space-between; font-size:13px; font-weight:500; }\n  #iwr-night-laws [data-record] { color:#FF0000; font-family:ui-monospace,monospace; font-size:11px; }\n  #iwr-night-laws [hidden] { display:none; }\n  #iwr-night-laws .nl-controls { position:absolute; top:62px; left:20px; right:20px; display:flex; align-items:center; gap:24px; height:44px; }\n  #iwr-night-laws .nl-circle { width:44px; height:44px; flex:none; display:grid; place-items:center; border-radius:50%; background:#141414; box-shadow:inset 0 0 0 1px #303030; }\n  #iwr-night-laws .nl-circle svg { width:20px; height:20px; stroke-width:1.5; }\n  #iwr-night-laws canvas { display:block; height:44px; width:100%; flex:1; min-width:0; }\n  #iwr-night-laws .nl-pads { display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--nl-divider); }\n  #iwr-night-laws .nl-pads>div { display:grid; place-items:center; height:120px; background:var(--nl-pad); color:#929292; }\n  #iwr-night-laws .nl-pads svg { width:18px; height:18px; }\n  #iwr-night-laws .nl-spec { margin-top:10px; }\n  #iwr-night-laws .nl-caption { margin-top:16px; min-height:44px; }\n  @media(max-width:630px) { #iwr-night-laws .nl-layout { grid-template-columns:minmax(0,1fr); gap:18px; } #iwr-night-laws .nl-stage { width:100%; max-width:402px; margin:auto; } }\n</style>\n<script>\n(() => {\n  const root=document.getElementById('iwr-night-laws');\n  const canvas=root.querySelector('canvas'),ctx=canvas.getContext('2d');\n  const pause=root.querySelector('[data-pause]'),caption=root.querySelector('[data-description]');\n  const reduced=matchMedia('(prefers-reduced-motion: reduce)');\n  const state={style:'handoff',mode:'play',paused:reduced.matches,accent:true};\n  const names={handoff:'Quantized Handoff',clipped:'Clipped Travel',ratchet:'Retrigger Ratchet',lease:'Context Lease',schmitt:'Schmitt Memory'};\n  const descriptions={\n    handoff:['Sonraki örnek hazır bekliyor; yalnız dört vuruşluk cümle bitince devreye giriyor.','Darbeler bekleyen örneği değiştiriyor; cümle sınırına kadar etkin kayıt değişmiyor.'],\n    clipped:['Soluk sürücü ilerlese de beyaz imleç belirlenmiş sınırın dışına çıkamıyor.','Önce iki sınır yazılıyor; sonraki taşmaların son iki teması hafızada tutuluyor.'],\n    ratchet:['İmleç kısa bir aralığı birkaç kez okuyor; tekrar sayısı dolunca sonrakine geçiyor.','Yeni aralığın bitişi ve tekrar çentikleri yazılıyor; tamamlanan aralık korunuyor.'],\n    lease:['Sabit bir adres kısa süreliğine olay kodunu gösteriyor; sonra kendi adına dönüyor.','Geçici kod adresin altına kaydediliyor; üstteki kimlik geri gelirken son kod korunuyor.'],\n    schmitt:['Üst eşik açıyor, alt eşik kapatıyor; aradaki bölgede önceki durum korunuyor.','Aynı iki eşik çalışıyor; yalnız durum değiştiren geçişler alttaki hafızaya yazılıyor.']\n  };\n  const white='#f1f0e8',amber='#FF0000';\n  let w=226,dpr=1,t=2.4,last=0,raf=0,visible=true;\n  const clamp=(x,a=0,b=1)=>Math.min(b,Math.max(a,x));\n  // Live sound seam: iwrSignal exists only inside the archive gallery. Without it, or with sound off, nothing changes.\n  const hearing=()=>typeof iwrSignal!=='undefined'&&iwrSignal.active?iwrSignal:null;\n  // Geometry reads audio features. Transport and history have separate clocks.\n  const charge=(band='amp',age=0)=>{const s=hearing();return s?clamp(s.bandAt?s.bandAt(band,age):(s[band]??s.level??0)):0;};\n  const strike=(kind='kick')=>{const s=hearing();return s?.eventAt?s.eventAt(kind):{n:Math.floor(s?.beat??0),age:s?.[kind+'Age']??30};};\n  // Time-driven machines move on the beat and rest between hits; the studies' own dt clamps still apply first.\n  const conduct=()=>{const s=hearing();return s?0.25+4.2*s.hit:1;};\n  const mod=(x,n)=>(x%n+n)%n;\n  const fract=x=>x-Math.floor(x);\n  const hash=n=>fract(Math.sin(n*127.1+43.7)*43758.5453);\n  const accent=()=>state.accent?amber:white;\n  function ink(alpha=1,color=white) { ctx.globalAlpha=clamp(alpha);ctx.fillStyle=color;ctx.strokeStyle=color; }\n  function rect(x,y,width,height,alpha=1,color=white) { ink(alpha,color);ctx.fillRect(Math.round(x*dpr)/dpr,Math.round(y*dpr)/dpr,width,height); }\n  function line(points,alpha=1,color=white) { if(!points.length)return;ink(alpha,color);ctx.lineWidth=1;ctx.lineCap='butt';ctx.lineJoin='miter';ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(...p):ctx.moveTo(...p));ctx.stroke(); }\n  function box(x,y,width,height,alpha=1,color=white) { line([[x,y],[x+width,y],[x+width,y+height],[x,y+height],[x,y]],alpha,color); }\n  function diamond(x,y,r=3,alpha=1,color=white) { line([[x-r,y],[x,y-r],[x+r,y],[x,y+r],[x-r,y]],alpha,color); }\n  function text(value,x,y,alpha=1,color=white) { ink(alpha,color);ctx.font='11px ui-monospace, SFMono-Regular, Menlo, monospace';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(value,x,y); }\n  function signature(x,y,id,alpha,color=white) {\n    for(let lane=0;lane<3;lane++) {\n      const tilt=Math.floor(hash(id*9+lane)*3)-1,offset=hash(id+lane*13)*4;\n      line([[x-10,y-6+lane*6],[x-3+offset,y-6+lane*6],[x+4,y-6+lane*6+tilt*3],[x+10,y-6+lane*6+tilt*3]],alpha,color);\n    }\n  }\n  // Synthetic event state and transport only; no MIDI, audio, or calibrated units.\n  function handoff(time) {\n    const phrase=hearing()?Math.floor(strike('note').n/4):Math.floor(time/2.4),position=hearing()?strike('note').age:mod(time,2.4),beat=hearing()?mod(strike('note').n,4):Math.floor(position/.6),recording=state.mode==='record';\n    const active=recording?(phrase-1)*4+3:phrase,pending=recording?phrase*4+beat:phrase+1;\n    const distance=Math.min(76,w*.43),left=w/2-distance/2,right=w/2+distance/2;\n    signature(left,18,active,.95,position<.12?accent():white);\n    signature(right,18,pending,.56);\n    line([[left-13,30],[left+13,30]],.9,accent());\n    line([[right-13,30],[right-8,30]],.33);line([[right+8,30],[right+13,30]],.33);\n    if(recording&&mod(position,.6)<.11)box(right-13,6,26,24,.65,accent());\n    for(let i=0;i<4;i++) {\n      const x=w/2-21+i*14;\n      rect(x,40,7,1,i<=beat?.85:.16,i===beat?accent():white);\n    }\n  }\n  function clipped(time) {\n    const recording=state.mode==='record',phrase=Math.floor(time/4.8),phase=mod(time,4.8),span=w-24;\n    const targetLow=.26+hash(phrase)*.1,targetHigh=.61+hash(phrase+3)*.12;\n    const lo=recording?.2+(targetLow-.2)*clamp(phase/.6):.32;\n    const hi=recording?.8+(targetHigh-.8)*clamp((phase-.6)/.6):.68;\n    const driver=hearing()?charge('amp'):.5+.44*Math.sin(time*1.7),position=clamp(driver,lo,hi),x=12+driver*span,pin=12+position*span;\n    line([[12,25],[w-12,25]],.16);\n    line([[12+lo*span,17],[12+lo*span,33]],.75);line([[12+hi*span,17],[12+hi*span,33]],.75);\n    diamond(x,10,3,.55);\n    line([[x,14],[x,19]],.3);\n    rect(pin-1,20,2,10,1,accent());\n    if(Math.abs(x-pin)>3) {\n      const direction=x>pin?1:-1;\n      for(let i=1;i<=3;i++) {\n        const at=pin+(x-pin)*i/4;\n        line([[at-direction,25],[at+direction,25]],.4);\n      }\n    }\n    if(recording) {\n      const contacts=[];let previousSide=0;\n      for(let age=1.2;age<=phase;age+=.04) {\n        const value=.5+.44*Math.sin((phrase*4.8+age)*1.7),side=value<lo?-1:value>hi?1:0;\n        if(side&&side!==previousSide)contacts.push(side<0?lo:hi);\n        previousSide=side;\n      }\n      contacts.slice(-2).forEach((value,i)=>line([[12+value*span-4,38+i*4],[12+value*span+4,38+i*4]],.7,accent()));\n    }\n  }\n  const intervals=[.23,.46,.31],repeats=[3,2,4],repeatSum=repeats.reduce((a,b)=>a+b,0);\n  function ratchet(time) {\n    const span=w-12,recording=state.mode==='record';\n    let start=6;\n    if(recording) {\n      const step=Math.floor(time/1.3),active=mod(step,3),phase=mod(time,1.3)/1.3;\n      intervals.forEach((fraction,i)=>{\n        const width=fraction*span-7;\n        line([[start,18],[start,34]],.42);\n        const extent=i===active?width*clamp(phase/.63):width;\n        line([[start,27],[start+extent,27]],i===active?1:.32,i===active?accent():white);\n        if(i===active)line([[start+extent,19],[start+extent,34]],1,accent());\n        else line([[start+width,23],[start+width,31]],.4);\n        const count=i===active?Math.floor(clamp((phase-.64)/.3)*repeats[i]):repeats[i];\n        for(let j=0;j<count;j++)rect(start+j*5,9,2,2,i===active?.9:.35,i===active?accent():white);\n        start+=fraction*span;\n      });\n    } else {\n      const heardRepeats=hearing()?['low','mid','high'].map(b=>1+Math.floor(charge(b)*3)):repeats;\n      const step=hearing()?mod(strike('hat').n,heardRepeats.reduce((a,b)=>a+b,0)):mod(Math.floor(time/.34),repeatSum),phase=hearing()?clamp(strike('hat').age/.18):fract(time/.34);\n      let passed=0;\n      intervals.forEach((fraction,i)=>{\n        const width=fraction*span-7,active=step>=passed&&step<passed+heardRepeats[i],read=step-passed;\n        line([[start,18],[start,34]],.42);line([[start,27],[start+width,27]],active?.6:.24);line([[start+width,23],[start+width,31]],.4);\n        for(let j=0;j<heardRepeats[i];j++)rect(start+j*5,9,2,2,active&&j<=read?.9:.2,active&&j===read?accent():white);\n        if(active) {const x=start+phase*width;line([[x,19],[x,34]],1,accent());}\n        start+=fraction*span;passed+=heardRepeats[i];\n      });\n    }\n  }\n  function lease(time) {\n    const event=hearing()?strike('note').n:Math.floor(time/.9),phase=hearing()?strike('note').age:mod(time,.9),active=mod(event,3),pitch=(w-6)/3,recording=state.mode==='record';\n    const code=id=>'+'+String(Math.floor((hearing()?charge('mid'):hash(id+19))*99)).padStart(3,'0');\n    for(let i=0;i<3;i++) {\n      const x=3+pitch*(i+.5),temporary=i===active&&phase<.68,identity=['A.01','B.02','C.03'][i];\n      text(temporary?code(event):identity,x,14,temporary?1:.66,temporary?accent():white);\n      if(recording) {\n        const committed=event-mod(event-i,3)-(i===active&&phase<.68?3:0);\n        text(code(committed),x,33,i===active&&phase>=.68?.9:.32,i===active&&phase>=.68?accent():white);\n      } else line([[x-10,32],[x+10,32]],.15);\n      if(temporary)rect(x-10,24,20*(1-phase/.68),1,.65,accent());\n    }\n  }\n  const drive=[.12,.47,.79,.59,.54,.62,.46,.31,.12];\n  const low=.35,high=.68;\n  function schmittState(index,progress) {\n    let on=false;\n    for(let i=0;i<=index;i++){if(drive[i]>=high)on=true;else if(drive[i]<=low)on=false;}\n    const value=drive[index]+(drive[index+1]-drive[index])*progress;\n    if(value>=high)on=true;else if(value<=low)on=false;\n    return {value,on};\n  }\n  let soundLatch=false;\n  function schmitt(time) {\n    const duration=.5,phase=mod(time,duration*(drive.length-1))/duration,index=Math.floor(phase),progress=fract(phase),current=hearing()?(()=>{const value=charge('amp');if(value>=high)soundLatch=true;else if(value<=low)soundLatch=false;return {value,on:soundLatch};})():schmittState(index,progress),span=w-24;\n    const x=value=>12+value*span,upper=11,lower=30;\n    line([[12,lower],[x(high),lower],[x(high),upper],[w-12,upper]],current.on?.19:.64);\n    line([[w-12,upper],[x(low),upper],[x(low),lower],[12,lower]],current.on?.64:.19);\n    line([[x(low)-3,36],[x(low)+3,36]],.55);line([[x(high)-3,36],[x(high)+3,36]],.55);\n    const at=x(current.value),y=current.on?upper:lower;\n    diamond(at,y,3,1,accent());\n    if(current.value>low&&current.value<high)line([[at,y],[at,21]],.27,accent());\n    rect(w-7,y-3,2,6,.9,accent());\n    if(state.mode==='record') {\n      const history=[];let previous=false;\n      for(let i=0;i<=index;i++) {\n        const checked=schmittState(i,i===index?progress:1);\n        if(checked.on!==previous)history.push({on:checked.on,at:i});\n        previous=checked.on;\n      }\n      history.forEach((entry,i)=>line([[12+i*18,42],[21+i*18,42]],.9,entry.on?accent():white));\n    }\n  }\n  const renderers={handoff,clipped,ratchet,lease,schmitt};\n  function draw() { ctx.clearRect(0,0,w,44);ctx.save();ctx.beginPath();ctx.rect(0,0,w,44);ctx.clip();renderers[state.style](t);ctx.restore(); }\n  function sync() {\n    root.querySelectorAll('[data-style]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.style===state.style)));\n    root.querySelectorAll('[data-mode]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.mode===state.mode)));\n    const description=descriptions[state.style][state.mode==='record'?1:0];caption.textContent=description;canvas.setAttribute('aria-label',names[state.style]+': '+description);\n    root.querySelector('[data-record]').hidden=state.mode!=='record';\n    pause.textContent=state.paused?'Devam et':'Duraklat';pause.setAttribute('aria-pressed',String(state.paused));draw();schedule();\n  }\n  function resize() { w=Math.max(1,canvas.getBoundingClientRect().width);dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(w*dpr);canvas.height=44*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);draw(); }\n  function schedule() { if(!raf&&!state.paused&&visible&&!document.hidden&&root.isConnected) { last=0;raf=requestAnimationFrame(frame); } }\n  function frame(now) { raf=0;if(state.paused||!visible||document.hidden||!root.isConnected)return;if(!last)last=now;const elapsed=now-last;if(elapsed>=1000/30){const heard=hearing();if(heard?.source==='demo')t=heard.songTime;else t+=Math.min(elapsed/1000,.07)*conduct();last=now;draw();}raf=requestAnimationFrame(frame); }\n  root.querySelectorAll('[data-style]').forEach(el=>el.addEventListener('click',()=>{state.style=el.dataset.style;sync();}));\n  root.querySelectorAll('[data-mode]').forEach(el=>el.addEventListener('click',()=>{state.mode=el.dataset.mode;sync();}));\n  pause.addEventListener('click',()=>{state.paused=!state.paused;sync();});\n  reduced.addEventListener('change',()=>{state.paused=reduced.matches;sync();});\n  document.addEventListener('visibilitychange',schedule);\n  new ResizeObserver(resize).observe(canvas);\n  new IntersectionObserver(entries=>{\n    const latest=entries.filter(entry=>entry.target===root).reduce((a,b)=>!a||b.time>=a.time?b:a,null);\n    if(latest){visible=latest.isIntersecting;schedule();}\n  }).observe(root);\n  resize();sync();\n  if(globalThis.Tweak){const tweak=new Tweak({container:root.querySelector('.nl-phone'),onChange:sync});tweak.addToggle(state,'accent',{label:'Kehribar vurgu'});}\n})();\n</script>\n","css":":root{color-scheme:dark;--background:#000;--foreground:#eee;--muted-foreground:#999}*{box-sizing:border-box}body{margin:0;padding:24px;background:#000;color:#eee;font:16px/1.5 Arial,Helvetica,sans-serif}button{font:inherit;cursor:pointer}.viz-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:24px}.btn{color:#bbb;background:#141414;border:1px solid #333;border-radius:6px;min-height:44px;padding:9px 14px;text-align:left}.btn[aria-pressed=true]{color:#fff;border-color:#ddd;background:#262626}.btn-block{width:100%}.text-small{font-size:14px}.text-muted{color:#999}:focus-visible{outline:2px solid #fff;outline-offset:3px}[hidden]{display:none!important}h3{font-size:18px;font-weight:500}figcaption{font-size:16px}canvas{max-width:100%}@media(max-width:520px){body{padding:16px}}"}