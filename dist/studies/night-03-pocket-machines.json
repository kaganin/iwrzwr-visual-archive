{"html":"<div id=\"iwr-night-pocket\" aria-label=\"Set 03: Pocket Machines, beş hareketli ses ekranı\">\n  <div class=\"viz-controls\">\n    <button type=\"button\" class=\"btn\" data-mode=\"play\" aria-pressed=\"true\">Çalma</button>\n    <button type=\"button\" class=\"btn\" data-mode=\"record\" aria-pressed=\"false\">Kayıt</button>\n    <button type=\"button\" class=\"btn btn-ghost\" data-pause aria-pressed=\"false\">Duraklat</button>\n    <span class=\"text-small text-muted\">Örnek ses ritmi · sessiz demo</span>\n  </div>\n  <div class=\"np-layout\">\n    <div class=\"np-stage\">\n      <div class=\"np-phone\" aria-label=\"iwrzwr: Pocket Machines önizlemesi\">\n        <div class=\"np-header\">\n          <div class=\"np-status\" aria-hidden=\"true\"><span>9:41</span><span data-record hidden>REC</span><span>••• &nbsp; ▰</span></div>\n          <div class=\"np-controls\">\n            <div class=\"np-circle\" aria-hidden=\"true\"></div>\n            <canvas role=\"img\" aria-label=\"Segment Relay: sabit segmentler arasında sinyal aktarımı\"></canvas>\n            <div class=\"np-circle\" aria-hidden=\"true\"><i data-lucide=\"plus\"></i></div>\n          </div>\n        </div>\n        <div class=\"np-pads\" aria-hidden=\"true\"><div><i data-lucide=\"mic\"></i></div><div><i data-lucide=\"mic\"></i></div></div>\n      </div>\n      <div class=\"text-small text-muted np-spec\">126px header · 44px alan · 24px boşluk</div>\n    </div>\n    <div class=\"np-options\" role=\"group\" aria-label=\"Pocket Machines seçenekleri\">\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"relay\" aria-pressed=\"true\">1 · Segment Relay</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"treaty\" aria-pressed=\"false\">2 · Compression Treaty</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"loom\" aria-pressed=\"false\">3 · Splice Loom</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"orbit\" aria-pressed=\"false\">4 · Orbit Punchcard</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"hold\" aria-pressed=\"false\">5 · Sample Hold Ladder</button>\n    </div>\n  </div>\n  <div class=\"np-caption\" data-description aria-live=\"polite\">Sinyal, özel bir segment alfabesindeki kontakları sırayla açıyor.</div>\n</div>\n<style>\n  #iwr-night-pocket .np-layout { display:grid; grid-template-columns:minmax(0,402px) minmax(190px,1fr); gap:24px; align-items:center; margin-top:20px; }\n  #iwr-night-pocket .np-stage { min-width:0; }\n  #iwr-night-pocket .np-options { display:grid; gap:8px; }\n  #iwr-night-pocket .np-phone { --np-screen:#000; --np-pad:#cdcdcd; --np-divider:#b6b6b6; --np-ink:#f1f0e8; color:var(--np-ink); background:var(--np-pad); border-radius:30px; overflow:hidden; font-family:-apple-system,BlinkMacSystemFont,sans-serif; }\n  #iwr-night-pocket .np-header { height:126px; position:relative; background:var(--np-screen); border-radius:0 0 32px 40px; }\n  #iwr-night-pocket .np-status { position:absolute; top:24px; left:28px; right:28px; display:flex; align-items:center; justify-content:space-between; font-size:13px; font-weight:500; }\n  #iwr-night-pocket [data-record] { color:#FF0000; font-family:ui-monospace,monospace; font-size:11px; }\n  #iwr-night-pocket [hidden] { display:none; }\n  #iwr-night-pocket .np-controls { position:absolute; top:62px; left:20px; right:20px; display:flex; align-items:center; gap:24px; height:44px; }\n  #iwr-night-pocket .np-circle { width:44px; height:44px; flex:none; display:grid; place-items:center; border-radius:50%; background:#141414; box-shadow:inset 0 0 0 1px #303030; }\n  #iwr-night-pocket .np-circle svg { width:20px; height:20px; stroke-width:1.5; }\n  #iwr-night-pocket canvas { display:block; height:44px; width:100%; flex:1; min-width:0; }\n  #iwr-night-pocket .np-pads { display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--np-divider); }\n  #iwr-night-pocket .np-pads>div { display:grid; place-items:center; height:120px; background:var(--np-pad); color:#929292; }\n  #iwr-night-pocket .np-pads svg { width:18px; height:18px; }\n  #iwr-night-pocket .np-spec { margin-top:10px; }\n  #iwr-night-pocket .np-caption { margin-top:16px; min-height:44px; }\n  @media(max-width:630px) { #iwr-night-pocket .np-layout { grid-template-columns:minmax(0,1fr); gap:18px; } #iwr-night-pocket .np-stage { width:100%; max-width:402px; margin:auto; } }\n</style>\n<script>\n(() => {\n  const root=document.getElementById('iwr-night-pocket');\n  const canvas=root.querySelector('canvas'),ctx=canvas.getContext('2d');\n  const pause=root.querySelector('[data-pause]'),caption=root.querySelector('[data-description]');\n  const reduced=matchMedia('(prefers-reduced-motion: reduce)');\n  const state={style:'relay',mode:'play',paused:reduced.matches,accent:true,gain:.82};\n  const names={relay:'Segment Relay',treaty:'Compression Treaty',loom:'Splice Loom',orbit:'Orbit Punchcard',hold:'Sample Hold Ladder'};\n  const descriptions={\n    relay:['Sinyal, özel bir segment alfabesindeki kontakları sırayla açıyor.','Her darbe bir segmenti yazıp kilitliyor; tamamlanan modül yerinde kalıyor.'],\n    treaty:['Üst ve alt dişler, sesin basıncıyla ortak bir aralık bırakıyor.','Yeni darbeler sağda iz bırakıyor; karşı kuvvet biraz gecikerek cevaplıyor.'],\n    loom:['Üç ince ses şeridi, bir kesme noktasında yer değiştiriyor.','Yeni şerit ortada dokunuyor, tamamlanan parçalar yanlara ayrılıyor.'],\n    orbit:['Üç farklı uzunlukta ritim halkası, sabit okuma çizgisinde buluşuyor.','Halkalar sabit; kayıt kafaları geçtikleri duraklara yeni delikler yazıyor.'],\n    hold:['Sabit seviyeleri okuyan bir imleç: küçük bir örnek-tut hafızası.','Her darbe yalnız bir basamağı güncelliyor; diğerleri son değerini tutuyor.']\n  };\n  const white='#f1f0e8',amber='#FF0000';\n  let w=226,dpr=1,t=2.4,last=0,raf=0,visible=true;\n  const clamp=(x,a=0,b=1)=>Math.min(b,Math.max(a,x));\n  // Live sound seam: iwrSignal exists only inside the archive gallery. Without it, or with sound off, nothing changes.\n  const hearing=()=>typeof iwrSignal!=='undefined'&&iwrSignal.active?iwrSignal:null;\n  // Time-driven machines move on the beat and rest between hits; the studies' own dt clamps still apply first.\n  const conduct=()=>{const s=hearing();return s?0.25+4.2*s.hit:1;};\n  // Whatever time env() is asked for, answer from the last 3.4 s that was actually heard.\n  const heardEnv=(s,time)=>{const age=Math.abs(t-time)%3.4;return 0.12+0.88*Math.max(s.levelAt(age),s.hitAt(age));};\n  const mod=(x,n)=>(x%n+n)%n;\n  const fract=x=>x-Math.floor(x);\n  const hash=n=>fract(Math.sin(n*127.1+43.7)*43758.5453);\n  const accent=()=>state.accent?amber:white;\n  // Synthetic energy and transport clocks. No compressor, spectral or pitch measurement.\n  function env(time) { const s=hearing(); if(s)return clamp(heardEnv(s,time)*state.gain); return clamp((.15+.55*Math.pow(Math.max(0,Math.sin(time*2.7)),6)+.28*Math.pow(Math.max(0,Math.sin(time*6.1+1)),12))*state.gain); }\n  function ink(alpha=1,color=white) { ctx.globalAlpha=clamp(alpha);ctx.fillStyle=color;ctx.strokeStyle=color; }\n  function rect(x,y,width,height,alpha=1,color=white) { ink(alpha,color);ctx.fillRect(Math.round(x*dpr)/dpr,Math.round(y*dpr)/dpr,width,height); }\n  function line(points,alpha=1,color=white) { if(!points.length)return;ink(alpha,color);ctx.lineWidth=1;ctx.lineCap='butt';ctx.lineJoin='miter';ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(...p):ctx.moveTo(...p));ctx.stroke(); }\n  function box(x,y,width,height,alpha=1,color=white) { line([[x,y],[x+width,y],[x+width,y+height],[x,y+height],[x,y]],alpha,color); }\n  function arc(x,y,r,a,b,alpha=1,color=white) { ink(alpha,color);ctx.lineWidth=1;ctx.beginPath();ctx.arc(x,y,r,a,b);ctx.stroke(); }\n  function relay(time) {\n    const count=Math.max(3,Math.min(6,Math.floor(w/33))),pitch=(w-4)/count,step=Math.floor(time*4),phase=fract(time*4);\n    for(let i=0;i<count;i++) {\n      const x=2+i*pitch,span=pitch-8,middle=x+span*.5;\n      const live=mod(step,count)===i,mask=state.mode==='record'?mod(step-i+count,4):live?3:0;\n      const segments=[[[x,12],[x+span,12]],[[middle,12],[middle,32]],[[x,32],[x+span,32]]];\n      segments.forEach((points,k)=>line(points,mask>=k+1?.95:.13,live?accent():white));\n      rect(x,21,2,2,.5);rect(x+span-1,21,2,2,.5);\n      if(i<count-1)line([[x+span+3,22],[x+pitch-3,22]],.25);\n      if(live)rect(x+span*phase,20.5,3,3,1,accent());\n    }\n  }\n  function treaty(time) {\n    const pitch=4,n=Math.ceil(w/pitch),speed=state.mode==='record'?1:0.6;\n    for(let i=0;i<n;i++) {\n      const u=i/(n-1),age=(1-u)*4.4;\n      const a=env(time*speed-age),b=env(time*speed-age-.25);\n      const low=2+17*a,high=2+Math.max(0,b-.3)*20;\n      rect(i*pitch,22+3,1,low,.78);\n      rect(i*pitch,22-3-high,1,high,.85,accent());\n      if(a>.57)rect(i*pitch,22+3+low+2,1,1,.4);\n    }\n    line([[0,22],[w,22]],.16);\n    if(state.mode==='record')line([[w-1,3],[w-1,41]],.75,accent());\n  }\n  function loom(time) {\n    const middle=w*.52,ys=[10,22,34],speed=state.mode==='record'?24:19;\n    if(state.mode==='record') {\n      for(let lane=0;lane<3;lane++) {\n        const y=ys[lane];\n        line([[0,y],[middle-28,y],[middle,22],[middle+28,y],[w,y]],.14);\n        for(const direction of [-1,1])for(let j=0;j<Math.ceil(w/48);j++) {\n          const distance=j*25+mod(time*speed+lane*6,25),x=middle+direction*distance;\n          const len=6+hash(j+lane*13)*10;\n          const mapY=px=>22+(y-22)*clamp(Math.abs(px-middle)/28);\n          const end=x+direction*len;\n          line([[x,mapY(x)],[end,mapY(end)]],distance<25?1:.65,distance<25?accent():white);\n          line([[end,mapY(end)-2],[end,mapY(end)+2]],.5);\n        }\n      }\n      rect(middle-1,18-env(time)*9,2,8+env(time)*18,1,accent());\n      return;\n    }\n    for(let lane=0;lane<3;lane++) {\n      const y=ys[lane],next=ys[(lane+1)%3];\n      line([[0,y],[middle-10,y],[middle+10,next],[w,next]],.16);\n      for(let j=-1;j<Math.ceil(w/24)+2;j++) {\n        const raw=j*24-mod(time*speed+lane*8,24),len=7+hash(j+lane*9)*11;\n        const mapY=x=>x<middle-10?y:x>middle+10?next:y+(next-y)*(x-(middle-10))/20;\n        const points=[];\n        for(let k=0;k<=6;k++){const x=raw+k/6*len;points.push([x,mapY(x)]);}\n        const live=raw<middle&&raw+len>middle;\n        line(points,live?1:.75,live?accent():white);\n        line([[raw,mapY(raw)-2],[raw,mapY(raw)+2]],.45);\n        if(state.mode==='record'&&Math.abs(raw-middle)<20)rect(raw,mapY(raw)-1,3,3,.9,accent());\n      }\n    }\n    line([[middle-6,2],[middle+6,2]],.6,accent());\n    line([[middle-6,42],[middle+6,42]],.6,accent());\n  }\n  function orbit(time) {\n    const count=w<160?2:3,pitch=w/count,r=16;\n    for(let ring=0;ring<count;ring++) {\n      const cx=pitch*(ring+.5),n=[12,9,7][ring],rotation=state.mode==='record'?0:time*(.45+ring*.11),head=mod(time*(1.1+ring*.17),Math.PI*2);\n      arc(cx,22,r,0,Math.PI*2,.16);\n      for(let i=0;i<n;i++) {\n        const angle=i/n*Math.PI*2+rotation-Math.PI/2,on=mod(i*5+ring*3,n)<n*.45;\n        const fresh=state.mode==='record'&&mod(head-i/n*Math.PI*2,Math.PI*2)<.8;\n        const hit=state.mode==='play'&&Math.abs(Math.sin(angle+Math.PI/2))<.17&&Math.cos(angle+Math.PI/2)>0;\n        const x=cx+Math.cos(angle)*r,y=22+Math.sin(angle)*r;\n        if(on||fresh)rect(x-1,y-1,2,2,hit||fresh?1:.65,hit||fresh?accent():white);\n        else rect(x,y,1,1,.18);\n      }\n      const a=state.mode==='record'?head-Math.PI/2:-Math.PI/2;\n      line([[cx+Math.cos(a)*6,22+Math.sin(a)*6],[cx+Math.cos(a)*20,22+Math.sin(a)*20]],.85,accent());\n      rect(cx-1,21,2,2,.65);\n    }\n  }\n  function hold(time) {\n    const n=Math.max(4,Math.min(7,Math.floor(w/29))),pitch=(w-4)/n,step=Math.floor(time*2.7),active=mod(step,n),phase=fract(time*2.7);\n    let previous;\n    for(let i=0;i<n;i++) {\n      const cycle=state.mode==='record'?Math.floor((step-i+n)/n):1;\n      const target=7+hash(i+cycle*17)*29,old=7+hash(i+(cycle-1)*17)*29;\n      // Latch: only the currently written slot moves; stored values remain fixed.\n      const y=state.mode==='record'&&i===active?old+(target-old)*clamp(phase/.22):target;\n      const x=2+i*pitch;\n      if(previous)line([[previous.x,previous.y],[x,previous.y],[x,y]],.16);\n      line([[x,y],[x+pitch-5,y]],i===active?1:.72,i===active?accent():white);\n      rect(x,39,2,1,.2);rect(x+pitch-5,39,2,1,.2);\n      if(i===active) {box(x+pitch*.5-2,y-2,4,4,1,accent());line([[x+pitch*.5,3],[x+pitch*.5,7]],.65,accent());}\n      previous={x:x+pitch-5,y};\n    }\n  }\n  const renderers={relay,treaty,loom,orbit,hold};\n  function draw() { ctx.clearRect(0,0,w,44);ctx.save();ctx.beginPath();ctx.rect(0,0,w,44);ctx.clip();renderers[state.style](t);ctx.restore(); }\n  function sync() {\n    root.querySelectorAll('[data-style]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.style===state.style)));\n    root.querySelectorAll('[data-mode]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.mode===state.mode)));\n    const description=descriptions[state.style][state.mode==='record'?1:0];caption.textContent=description;canvas.setAttribute('aria-label',names[state.style]+': '+description);\n    root.querySelector('[data-record]').hidden=state.mode!=='record';\n    pause.textContent=state.paused?'Devam et':'Duraklat';pause.setAttribute('aria-pressed',String(state.paused));draw();schedule();\n  }\n  function resize() { w=Math.max(1,canvas.getBoundingClientRect().width);dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(w*dpr);canvas.height=44*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);draw(); }\n  function schedule() { if(!raf&&!state.paused&&visible&&!document.hidden&&root.isConnected) { last=0;raf=requestAnimationFrame(frame); } }\n  function frame(now) { raf=0;if(state.paused||!visible||document.hidden||!root.isConnected)return;if(!last)last=now;const elapsed=now-last;if(elapsed>=1000/30){t+=Math.min(elapsed/1000,.07)*conduct();last=now;draw();}raf=requestAnimationFrame(frame); }\n  root.querySelectorAll('[data-style]').forEach(el=>el.addEventListener('click',()=>{state.style=el.dataset.style;sync();}));\n  root.querySelectorAll('[data-mode]').forEach(el=>el.addEventListener('click',()=>{state.mode=el.dataset.mode;sync();}));\n  pause.addEventListener('click',()=>{state.paused=!state.paused;sync();});\n  reduced.addEventListener('change',()=>{state.paused=reduced.matches;sync();});\n  document.addEventListener('visibilitychange',schedule);\n  new ResizeObserver(resize).observe(canvas);\n  new IntersectionObserver(entries=>{const latest=entries.reduce((a,b)=>b.target===root&&(!a||b.time>=a.time)?b:a,null);if(latest){visible=latest.isIntersecting;schedule();}}).observe(root);\n  resize();sync();\n  if(globalThis.Tweak){const tweak=new Tweak({container:root.querySelector('.np-phone'),onChange:sync});tweak.addToggle(state,'accent',{label:'Kehribar vurgu'});tweak.addSlider(state,'gain',{label:'Tepki yoğunluğu',min:.3,max:1.2,step:.1});}\n})();\n</script>\n","css":":root{color-scheme:dark;--background:#000;--foreground:#eee;--muted-foreground:#999}*{box-sizing:border-box}body{margin:0;padding:24px;background:#000;color:#eee;font:16px/1.5 Arial,Helvetica,sans-serif}button{font:inherit;cursor:pointer}.viz-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:24px}.btn{color:#bbb;background:#141414;border:1px solid #333;border-radius:6px;min-height:44px;padding:9px 14px;text-align:left}.btn[aria-pressed=true]{color:#fff;border-color:#ddd;background:#262626}.btn-block{width:100%}.text-small{font-size:14px}.text-muted{color:#999}:focus-visible{outline:2px solid #fff;outline-offset:3px}[hidden]{display:none!important}h3{font-size:18px;font-weight:500}figcaption{font-size:16px}canvas{max-width:100%}@media(max-width:520px){body{padding:16px}}"}