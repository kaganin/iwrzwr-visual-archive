{"html":"<div id=\"iwr-geek-waves\" aria-label=\"Teletext ve bilimkurgu arayüzlerinden esinlenen beş ses animasyonu\">\n  <div class=\"viz-controls\">\n    <button type=\"button\" class=\"btn\" data-mode=\"play\" aria-pressed=\"true\">Çalma</button>\n    <button type=\"button\" class=\"btn\" data-mode=\"record\" aria-pressed=\"false\">Kayıt</button>\n    <button type=\"button\" class=\"btn btn-ghost\" data-pause aria-pressed=\"false\">Duraklat</button>\n    <span class=\"text-small text-muted\">Örnek sinyal · sessiz önizleme</span>\n  </div>\n  <div class=\"gx-layout\">\n    <div class=\"gx-stage\">\n      <div class=\"gx-phone\" aria-label=\"iwrzwr ses animasyonu önizlemesi\">\n        <div class=\"gx-header\">\n          <div class=\"gx-status\" aria-hidden=\"true\"><span>9:41</span><span>••• &nbsp; ▰</span></div>\n          <div class=\"gx-controls\">\n            <div class=\"gx-button\" aria-hidden=\"true\"></div>\n            <div class=\"gx-activity\">\n              <div class=\"gx-record\" hidden><span class=\"gx-dot\"></span><span data-clock>00:00</span></div>\n              <canvas role=\"img\" aria-label=\"Wireframe Echo: sesle yükselip alçalan tel kafes yüzey\"></canvas>\n            </div>\n            <div class=\"gx-button\" aria-hidden=\"true\"></div>\n          </div>\n        </div>\n        <div class=\"gx-pads\" aria-hidden=\"true\"><div><i data-lucide=\"mic\"></i></div><div><i data-lucide=\"mic\"></i></div></div>\n      </div>\n      <div class=\"text-small text-muted gx-spec\">44px alan · 24px boşluk · merkez hizalı</div>\n    </div>\n    <div class=\"gx-choices\" role=\"group\" aria-label=\"Beş alternatif\">\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"teletext\" aria-pressed=\"false\">1 · Teletext Pulse</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"scope\" aria-pressed=\"false\">2 · Vector Scope</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"wireframe\" aria-pressed=\"true\">3 · Wireframe Echo</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"ascii\" aria-pressed=\"false\">4 · ASCII Stream</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"spectral\" aria-pressed=\"false\">5 · Spectral Tape</button>\n    </div>\n  </div>\n  <div class=\"gx-caption\" aria-live=\"polite\" data-description>Silk’in katman hissi, tel kafes bir araziye dönüşüyor; sesle kabarıp geriye akıyor.</div>\n</div>\n<style>\n  #iwr-geek-waves .gx-layout { display:grid; grid-template-columns:minmax(0,402px) minmax(150px,1fr); gap:24px; align-items:center; margin-top:20px; }\n  #iwr-geek-waves .gx-stage { min-width:0; }\n  #iwr-geek-waves .gx-choices { display:grid; gap:8px; }\n  #iwr-geek-waves .gx-phone { width:100%; background:#cdcdcd; color:#fff; font-family:-apple-system,BlinkMacSystemFont,sans-serif; border-radius:30px; overflow:hidden; }\n  #iwr-geek-waves .gx-header { height:126px; position:relative; background:#000; border-radius:0 0 32px 40px; }\n  #iwr-geek-waves .gx-status { position:absolute; top:24px; left:28px; right:28px; display:flex; justify-content:space-between; font-size:13px; line-height:16px; font-weight:500; }\n  #iwr-geek-waves .gx-controls { position:absolute; top:62px; left:20px; right:20px; display:flex; align-items:center; gap:24px; height:44px; }\n  #iwr-geek-waves .gx-button { flex:none; width:44px; height:44px; border-radius:50%; background:#141414; box-shadow:inset 0 0 0 1px #303030; }\n  #iwr-geek-waves .gx-activity { display:flex; flex:1; min-width:0; height:44px; gap:8px; align-items:center; }\n  #iwr-geek-waves canvas { display:block; flex:1; min-width:0; width:100%; height:44px; }\n  #iwr-geek-waves .gx-record { display:flex; flex:none; width:60px; align-items:center; gap:6px; color:#fff; font-family:ui-monospace,monospace; font-size:11px; line-height:14px; font-variant-numeric:tabular-nums; }\n  #iwr-geek-waves .gx-record[hidden] { display:none; }\n  #iwr-geek-waves .gx-dot { width:6px; height:6px; border-radius:50%; flex:none; background:#ff413a; }\n  #iwr-geek-waves .gx-pads { display:grid; grid-template-columns:1fr 1fr; gap:1px; background:#b4b4b4; }\n  #iwr-geek-waves .gx-pads>div { display:grid; place-items:center; height:120px; background:#cdcdcd; color:#909090; }\n  #iwr-geek-waves .gx-pads svg { width:18px; height:18px; }\n  #iwr-geek-waves .gx-spec { margin-top:10px; }\n  #iwr-geek-waves .gx-caption { margin-top:18px; min-height:44px; }\n  @media(max-width:610px) { #iwr-geek-waves .gx-layout { grid-template-columns:minmax(0,1fr); gap:18px; } #iwr-geek-waves .gx-stage { width:100%; max-width:402px; margin:auto; } #iwr-geek-waves .gx-choices { grid-template-columns:repeat(2,minmax(0,1fr)); } }\n</style>\n<script>\n(() => {\n  const root=document.getElementById('iwr-geek-waves');\n  const canvas=root.querySelector('canvas');\n  const ctx=canvas.getContext('2d');\n  const record=root.querySelector('.gx-record');\n  const clock=root.querySelector('[data-clock]');\n  const description=root.querySelector('[data-description]');\n  const pause=root.querySelector('[data-pause]');\n  const reduced=matchMedia('(prefers-reduced-motion: reduce)');\n  const state={style:'wireframe',mode:'play',paused:false,tone:'white',gain:0.8};\n  const captions={\n    teletext:'Basamaklı, dikdörtgen mozaikler; ses yükseldikçe merkezden açılan teletext dalgası.',\n    scope:'İnce vektör izi ve sönümlenen katmanlar; laboratuvar osiloskobu gibi kıvrılan bir sinyal.',\n    wireframe:'Silk’in katman hissi, tel kafes bir araziye dönüşüyor; sesle kabarıp geriye akıyor.',\n    ascii:'Nokta, iki nokta, yıldız ve # karakterleri; sesin yoğunluğunu yazıya çeviren terminal dokusu.',\n    spectral:'Frekans izi hissi veren piksel sütunları; sağdan yazılıp sola akan bir sinyal şeridi.'\n  };\n  const names={teletext:'Teletext Pulse',scope:'Vector Scope',wireframe:'Wireframe Echo',ascii:'ASCII Stream',spectral:'Spectral Tape'};\n  const colors={white:'#f1f1ee',green:'#a0f0b0',amber:'#FF0000'};\n  let w=226,h=44,t=3.2,last=0,level=0.5,recordTime=0;\n  // Live sound seam: iwrSignal exists only inside the archive gallery. Without it, or with sound off, nothing changes.\n  const live=()=>typeof iwrSignal!=='undefined'&&iwrSignal.active?iwrSignal:null;\n  const heard=(s,time)=>{const age=Math.max(0,t-time);return 0.13+0.87*Math.max(s.levelAt(age),s.hitAt(age));};\n  function clamp(v,lo=0,hi=1){return Math.min(hi,Math.max(lo,v));}\n  function amp(time){const s=live();if(s)return heard(s,time);return 0.15+0.52*Math.pow(Math.sin(time*1.65),4)+0.26*Math.pow(Math.sin(time*3.15+0.7),8);}\n  function audio(time){return Math.sin(time*15)*0.55+Math.sin(time*24.3+0.8)*0.28+Math.sin(time*37.7)*0.17;}\n  function tint(alpha=1){ctx.fillStyle=colors[state.tone];ctx.strokeStyle=colors[state.tone];ctx.globalAlpha=alpha;}\n  function line(points,alpha=1,width=1){\n    ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]));\n    tint(alpha);ctx.lineWidth=width;ctx.lineCap='butt';ctx.stroke();ctx.globalAlpha=1;\n  }\n  function teletext(time,gain){\n    const cols=Math.max(8,Math.floor(w/7)),rows=8,pitch=w/cols;\n    const tick=Math.floor(time*9)/9;\n    for(let c=0;c<cols;c++){\n      const x=c/(cols-1);\n      const local=state.mode==='record'?amp(tick-(1-x)*2.5):gain*(0.4+0.6*Math.abs(audio(tick+x*0.6)));\n      const extent=Math.max(1,Math.round(local*4));\n      for(let r=0;r<rows;r++){\n        const d=Math.abs(r-3.5),lit=d<extent;\n        if(!lit)continue;\n        tint(d>extent-1?0.9:0.43+0.22*local);\n        ctx.fillRect(Math.floor(c*pitch)+1,3+r*4.75,Math.max(2,Math.floor(pitch)-1.5),4);\n      }\n    }\n    ctx.globalAlpha=1;\n  }\n  function scope(time,gain){\n    const cy=22,cx=w/2;\n    line([[1,cy],[w-1,cy]],0.13,0.7);\n    line([[cx,2],[cx,42]],0.13,0.7);\n    for(let x=10;x<w;x+=12)line([[x,cy-1.5],[x,cy+1.5]],0.2,0.7);\n    for(let trail=5;trail>=0;trail--){\n      const age=trail*0.045,phase=time-age;\n      const sx=(w/2-5)*(0.55+gain*0.4),sy=5+gain*14;\n      const points=[];\n      for(let i=0;i<=220;i++){\n        const a=i/220*Math.PI*2;\n        const x=cx+sx*Math.sin(a*2+Math.sin(phase*0.6)*0.48);\n        const y=cy+sy*Math.sin(a*3+phase*(state.mode==='record'?0.6:0.38));\n        points.push([x,y]);\n      }\n      line(points,trail===0?0.95:0.08+(5-trail)*0.015,trail===0?1:0.65);\n    }\n  }\n  function terrainPoint(u,v,time,gain){\n    const perspective=0.60+v*0.40;\n    const x=w/2+(u-0.5)*(w-4)*perspective;\n    const swell=0.6+0.4*Math.sin(time*1.8-v*4.5);\n    const shape=Math.pow(Math.sin(Math.PI*u),1.1)*(0.45*Math.sin(u*14+v*3.4-time*1.6)+0.55*Math.sin(u*8-time*1.1-v*1.7));\n    const baseline=7+30*v;\n    const height=Math.min(3+gain*9,baseline-2,42-baseline);\n    return [x,baseline+shape*height*swell];\n  }\n  function wireframe(time,gain){\n    for(let r=0;r<9;r++){\n      const v=r/8,points=[];\n      for(let c=0;c<=58;c++)points.push(terrainPoint(c/58,v,time,gain));\n      line(points,0.16+v*0.64,0.75);\n    }\n    for(let c=0;c<23;c++){\n      const points=[];\n      for(let r=0;r<=32;r++)points.push(terrainPoint(c/22,r/32,time,gain));\n      line(points,0.30,0.5);\n    }\n  }\n  function ascii(time,gain){\n    const chars=['.',':','+','*','#','@'];\n    const cols=Math.max(4,Math.floor(w/7)),pitch=w/cols;\n    const tick=Math.floor(time*7)/7;\n    ctx.font='11px ui-monospace, SFMono-Regular, Menlo, monospace';ctx.textAlign='center';ctx.textBaseline='middle';\n    for(let r=0;r<3;r++)for(let c=0;c<cols;c++){\n      const x=c/(cols-1),sample=amp(tick-(1-x)*(state.mode==='record'?3:1.6))*state.gain/0.8;\n      const mod=0.62+0.38*Math.sin(c*0.6+tick*4-r*2);\n      const density=clamp(sample*mod+(r===1?0.19:-0.05));\n      const index=Math.min(chars.length-1,Math.floor(density*chars.length));\n      tint(0.19+0.80*density);\n      ctx.fillText(chars[index],c*pitch+pitch/2,9+r*13);\n    }\n    ctx.globalAlpha=1;\n  }\n  function spectrumAt(time,freq){\n    const s=live();if(s?.spectrumAt)return s.spectrumAt(freq,Math.max(0,t-time));\n    const f1=0.24+0.1*Math.sin(time*0.7),f2=0.6+0.18*Math.sin(time*1.3);\n    const a=Math.exp(-Math.pow((freq-f1)/0.14,2));\n    const b=Math.exp(-Math.pow((freq-f2)/0.095,2));\n    const noise=0.5+0.5*Math.sin(time*9+freq*22)*Math.cos(time*4-freq*34);\n    return clamp((a+b*0.78)*amp(time)*1.22+noise*0.08);\n  }\n  function spectral(time,gain){\n    const rows=11,cols=Math.max(10,Math.floor(w/3));\n    const tick=Math.floor(time*10)/10;\n    const speed=state.mode==='record'?0.12:0.075;\n    const pitch=w/cols;\n    for(let c=0;c<cols;c++)for(let r=0;r<rows;r++){\n      const sample=spectrumAt(tick-(cols-1-c)*speed,1-r/(rows-1))*state.gain/0.8;\n      if(sample<0.10)continue;\n      tint(Math.round(clamp(sample)*5)/5*0.88+0.08);\n      ctx.fillRect(Math.floor(c*pitch),r*4,Math.max(1,Math.floor(pitch)-0.75),3);\n    }\n    line([[w-0.5,1],[w-0.5,43]],0.64,1);\n    ctx.globalAlpha=1;\n  }\n  function draw(){\n    ctx.clearRect(0,0,w,h);\n    const time=reduced.matches?3.2:t;\n    const gain=reduced.matches?0.4+level*0.15:level;\n    ({teletext,scope,wireframe,ascii,spectral})[state.style](time,gain);\n  }\n  function resize(){\n    w=Math.max(1,canvas.getBoundingClientRect().width);\n    const dpr=Math.min(devicePixelRatio||1,3);\n    canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr);\n    ctx.setTransform(dpr,0,0,dpr,0,0);draw();\n  }\n  function sync(){\n    root.querySelectorAll('[data-style]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.style===state.style)));\n    root.querySelectorAll('[data-mode]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.mode===state.mode)));\n    record.hidden=state.mode!=='record';\n    pause.textContent=state.paused?'Devam et':'Duraklat';pause.setAttribute('aria-pressed',String(state.paused));\n    description.textContent=captions[state.style];\n    canvas.setAttribute('aria-label',names[state.style]+': '+captions[state.style]);\n    resize();\n  }\n  root.querySelectorAll('[data-style]').forEach(b=>b.addEventListener('click',()=>{state.style=b.dataset.style;sync();}));\n  root.querySelectorAll('[data-mode]').forEach(b=>b.addEventListener('click',()=>{state.mode=b.dataset.mode;recordTime=0;sync();}));\n  pause.addEventListener('click',()=>{state.paused=!state.paused;sync();});\n  function frame(now){\n    if(!root.isConnected)return;\n    const dt=last?Math.min((now-last)/1000,0.05):0;last=now;\n    if(!state.paused&&!document.hidden){\n      t+=dt;recordTime+=dt;\n      const target=clamp(amp(t)*state.gain/0.8);\n      level+=(target-level)*(1-Math.exp(-dt/(target>level?0.08:0.24)));\n      draw();\n      const n=Math.floor(recordTime*100)%6000;\n      clock.textContent=String(Math.floor(n/100)).padStart(2,'0')+':'+String(n%100).padStart(2,'0');\n    }\n    requestAnimationFrame(frame);\n  }\n  const observer=new ResizeObserver(resize);observer.observe(canvas);\n  sync();requestAnimationFrame(frame);\n  if(globalThis.Tweak){\n    const tweaks=new Tweak({container:root.querySelector('.gx-phone'),onChange:sync});\n    tweaks.addSelect(state,'tone',{label:'Fosfor rengi',options:[{label:'Beyaz',value:'white'},{label:'Yeşil',value:'green'},{label:'Amber',value:'amber'}]});\n    tweaks.addSlider(state,'gain',{label:'Sinyal yoğunluğu',min:0.2,max:1,step:0.05});\n  }\n})();\n</script>\n","css":":root{color-scheme:dark;--background:#000;--foreground:#eee;--muted-foreground:#999}*{box-sizing:border-box}body{margin:0;padding:24px;background:#000;color:#eee;font:16px/1.5 Arial,Helvetica,sans-serif}button{font:inherit;cursor:pointer}.viz-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:24px}.btn{color:#bbb;background:#141414;border:1px solid #333;border-radius:6px;min-height:44px;padding:9px 14px;text-align:left}.btn[aria-pressed=true]{color:#fff;border-color:#ddd;background:#262626}.btn-block{width:100%}.text-small{font-size:14px}.text-muted{color:#999}:focus-visible{outline:2px solid #fff;outline-offset:3px}[hidden]{display:none!important}h3{font-size:18px;font-weight:500}figcaption{font-size:16px}canvas{max-width:100%}@media(max-width:520px){body{padding:16px}}"}