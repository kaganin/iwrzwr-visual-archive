{"html":"<div id=\"fan-satellites-refined\">\n  <div class=\"viz-controls\">\n    <button class=\"btn\" type=\"button\" data-audio aria-pressed=\"false\">Örnek sesi aç</button>\n    <button class=\"btn\" type=\"button\" data-pause aria-pressed=\"false\">Duraklat</button>\n    <span class=\"text-small\" data-status role=\"status\" aria-live=\"polite\">Sessiz önizleme · 108 BPM</span>\n  </div>\n  <div data-series></div>\n</div>\n<style>\n#fan-satellites-refined .sound-series{margin-top:28px}\n#fan-satellites-refined h3{margin:0 0 14px}\n#fan-satellites-refined .sound-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 24px}\n#fan-satellites-refined figure{margin:0;min-width:0}\n#fan-satellites-refined .sound-screen{background:#000;padding:26px 12px}\n#fan-satellites-refined canvas{display:block;width:100%;height:44px}\n#fan-satellites-refined figcaption{margin-top:8px;color:var(--foreground)}\n#fan-satellites-refined .sound-mapping{display:block;margin-top:3px;color:var(--muted-foreground)}\n@media(max-width:520px){#fan-satellites-refined .sound-grid{grid-template-columns:1fr}}\n</style>\n<script>\n(()=>{\n'use strict';\nconst root=document.getElementById('fan-satellites-refined');\nconst series=[\n {name:'',items:[\n ['Spectral Fan','8 frekans bandı · hücresel yelpaze'],\n ['Band Satellites','Bas / orta / tiz · yumuşak yörüngeler']]}\n];\nconst container=root.querySelector('[data-series]'),panels=[];\nseries.forEach((group,g)=>{\n const section=document.createElement('section'),heading=document.createElement('h3'),grid=document.createElement('div');\n section.className='sound-series';heading.textContent=group.name;grid.className='sound-grid';if(group.name)section.append(heading);section.append(grid);container.append(section);\n group.items.forEach(([name,mapping],i)=>{\n  const figure=document.createElement('figure'),screen=document.createElement('div'),c=document.createElement('canvas'),caption=document.createElement('figcaption'),label=document.createElement('span');\n  screen.className='sound-screen';c.setAttribute('role','img');c.setAttribute('aria-label',name+'. '+mapping);caption.textContent=String(i+1).padStart(2,'0')+' · '+name;label.className='sound-mapping text-small';label.textContent=mapping;caption.append(label);screen.append(c);figure.append(screen,caption);grid.append(figure);\n  panels.push({id:g*5+i,c,figure,ctx:c.getContext('2d'),w:300,visible:true});\n });\n});\n// One original, local stereo sound loop. The silent preview and audible mode\n// read the SAME PCM-derived envelopes, spectra and waveform samples.\nconst rate=32000,step=60/108/2,N=Math.round(step*32*rate),duration=N/rate;\nconst pcm=[new Float32Array(N),new Float32Array(N)],mono=new Float32Array(N);\nconst events={kick:[0,6,8,16,22],snare:[4,12,20],hat:[2,3,6,10,11,14,18,19,22],note:[1,7,9,15,17,23]};\nconst notes=[146.83,220,196,293.66,164.81,220];\nlet seed=17471;\nfunction noise(){seed=(Math.imul(seed,1664525)+1013904223)|0;return (seed>>>0)/2147483648-1;}\nfunction voice(type,at,index){\n const length=type==='note'?.85:type==='kick'?.6:type==='snare'?.28:.1;\n const first=Math.round(at*rate),count=Math.round(length*rate),pan=type==='note'?(index%2?.65:-.65):type==='hat'?(index%2?.4:-.4):0;\n const gainL=Math.sqrt((1-pan)/2),gainR=Math.sqrt((1+pan)/2);\n let previousNoise=0;\n for(let j=0;j<count&&first+j<N;j++){\n  const t=j/rate,rise=Math.min(1,t/.003);let value=0;\n  if(type==='kick')value=Math.sin(2*Math.PI*(48*t+120/32*(1-Math.exp(-32*t))))*Math.exp(-12*t)*.8*rise;\n  if(type==='snare')value=(noise()*.68+Math.sin(2*Math.PI*185*t)*.25)*Math.exp(-23*t)*rise*.5;\n  if(type==='hat'){const n=noise();value=(n-previousNoise)*Math.exp(-65*t)*rise*.17;previousNoise=n;}\n  if(type==='note'){const f=notes[index%notes.length];value=(Math.sin(2*Math.PI*f*t)+.3*Math.sin(2*Math.PI*f*2*t)+.12*Math.sin(2*Math.PI*f*4*t))*Math.exp(-6.8*t)*rise*.35;}\n  pcm[0][first+j]+=value*gainL;pcm[1][first+j]+=value*gainR;\n }\n}\nObject.entries(events).forEach(([kind,steps])=>steps.forEach((s,i)=>voice(kind,s*step,i)));\nlet peak=0;for(let i=0;i<N;i++)peak=Math.max(peak,Math.abs(pcm[0][i]),Math.abs(pcm[1][i]));\nfor(let i=0;i<N;i++){pcm[0][i]*=.24/peak;pcm[1][i]*=.24/peak;mono[i]=(pcm[0][i]+pcm[1][i])*.5;}\nconst hop=400,frameCount=Math.ceil(N/hop),frameTime=hop/rate;\nconst cutoffs=[100,220,480,1000,2200,4800,9600],coeff=cutoffs.map(f=>1-Math.exp(-2*Math.PI*f/rate));\nconst filtered=new Float64Array(7),frames=[],maxima=new Float64Array(8);\nlet peakRms=0;\nfor(let start=0;start<N;start+=hop){\n const sums=new Float64Array(8);let all=0,l=0,r=0;\n for(let i=start;i<Math.min(start+hop,N);i++){\n  const sample=mono[i];let previous=0;\n  for(let b=0;b<7;b++){filtered[b]+=coeff[b]*(sample-filtered[b]);const band=filtered[b]-previous;sums[b]+=band*band;previous=filtered[b];}\n  sums[7]+=(sample-previous)**2;all+=sample*sample;l+=pcm[0][i]**2;r+=pcm[1][i]**2;\n }\n const bins=Array.from(sums,v=>Math.sqrt(v/hop));bins.forEach((v,i)=>maxima[i]=Math.max(maxima[i],v));\n const rms=Math.sqrt(all/hop);peakRms=Math.max(peakRms,rms);frames.push({bins,rms,l:Math.sqrt(l/hop),r:Math.sqrt(r/hop),travel:0});\n}\nconst clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v)),mod=(v,n)=>(v%n+n)%n,frac=v=>v-Math.floor(v),tau=Math.PI*2,tri=v=>1-4*Math.abs(frac(v)-.5);\nlet travel=0;\nframes.forEach(f=>{\n f.bins=f.bins.map((v,i)=>clamp(v/(maxima[i]*.8||1)));f.amp=clamp(f.rms/(peakRms*.8));\n f.low=(f.bins[0]+f.bins[1])/2;f.mid=(f.bins[2]+f.bins[3]+f.bins[4])/3;f.high=(f.bins[5]+f.bins[6]+f.bins[7])/3;\n f.balance=(f.r-f.l)/(f.l+f.r+.0001);f.left=clamp(f.l/(peakRms*.9));f.right=clamp(f.r/(peakRms*.9));\n travel+=Math.max(0,f.amp-.025)*frameTime;f.travel=travel;\n});\nconst cycleTravel=travel;\nfunction signal(t){\n const cycle=Math.floor(t/duration),pos=mod(t,duration)/frameTime,i=Math.min(frameCount-1,Math.floor(pos)),j=Math.min(frameCount-1,i+1),q=pos-i,a=frames[i],b=frames[j];\n const f={bins:a.bins.map((v,k)=>v+(b.bins[k]-v)*q)};\n for(const key of ['low','mid','high','amp','balance','left','right','travel'])f[key]=a[key]+(b[key]-a[key])*q;\n f.travel+=cycle*cycleTravel;return f;\n}\nfunction hit(t,kind){const sequence=events[kind],local=mod(t,duration);let index=-1;for(let i=0;i<sequence.length;i++)if(sequence[i]*step<=local)index=i;return {age:index<0?local+duration-sequence[sequence.length-1]*step:local-sequence[index]*step,n:Math.floor(t/duration)*sequence.length+index+1};}\nfunction wave(t,u){const at=Math.floor(mod(t-.032+u*.032,duration)*rate);return mono[Math.min(N-1,at)]/(peakRms*3);}\nconst reduced=matchMedia('(prefers-reduced-motion: reduce)'),soundButton=root.querySelector('[data-audio]'),pauseButton=root.querySelector('[data-pause]'),status=root.querySelector('[data-status]');\nlet time=1.72,last=0,raf=0,paused=reduced.matches,visible=true,audible=false,context=null,source=null,buffer=null,startTime=0,startOffset=0,audioPending=false;\n// Live sound seam: iwrSignal exists only inside the archive gallery. Without it, or with sound off, nothing changes.\n// The shared demo loop is this study's own sample, so its audible position is the study clock.\nconst live=()=>typeof iwrSignal!=='undefined'&&iwrSignal.active?iwrSignal:null;\nfunction sync(){soundButton.textContent=audible?'Sesi kapat':'Örnek sesi aç';soundButton.setAttribute('aria-pressed',String(audible));pauseButton.textContent=paused?'Devam et':'Duraklat';pauseButton.setAttribute('aria-pressed',String(paused));status.textContent=paused?'Duraklatıldı':audible?'Örnek ses açık · 108 BPM':'Sessiz önizleme · 108 BPM';}\nfunction clock(){return audible&&context&&source?startOffset+context.currentTime-startTime:time;}\nfunction stopSound(){if(audible)time=clock();if(source){try{source.stop();}catch(e){}source.disconnect();source=null;}audible=false;sync();}\nasync function startSound(){\n if(audioPending)return;audioPending=true;soundButton.disabled=true;\n try{\n  const AC=window.AudioContext||window.webkitAudioContext;if(!AC)throw new Error('audio-unavailable');\n  if(!context)context=new AC();await context.resume();\n  if(context.state!=='running')throw new Error('audio-blocked');\n  if(!root.isConnected)return;\n  if(!buffer){buffer=context.createBuffer(2,N,rate);buffer.copyToChannel(pcm[0],0);buffer.copyToChannel(pcm[1],1);}\n  source=context.createBufferSource();source.buffer=buffer;source.loop=true;source.connect(context.destination);\n  startOffset=time;startTime=context.currentTime;source.start(0,mod(time,duration));audible=true;paused=false;sync();schedule();\n }catch(error){stopSound();status.textContent='Ses burada açılamadı; sessiz önizleme devam ediyor.';}\n finally{audioPending=false;soundButton.disabled=false;}\n}\n// A periodic envelope follower keeps audio-hop changes out of geometry.\n// Warm-up passes settle the follower before storing the final cyclic trace.\nconst softFrames=[];\nconst follower=new Float64Array(8);\nfor(let pass=0;pass<4;pass++){\n for(let i=0;i<frames.length;i++){\n  const dt=Math.min(frameTime,duration-i*frameTime);\n  if(pass===3)softFrames.push({bins:Array.from(follower)});\n  frames[i].bins.forEach((target,k)=>{\n   const seconds=target>follower[k] ? .08 : .28;\n   follower[k]+=(target-follower[k])*(1-Math.exp(-dt/seconds));\n  });\n }\n}\nconst phaseTotal=[0,0,0];\nsoftFrames.forEach((f,i)=>{\n f.bands=[(f.bins[0]+f.bins[1])/2,(f.bins[2]+f.bins[3]+f.bins[4])/3,(f.bins[5]+f.bins[6]+f.bins[7])/3];\n f.phase=phaseTotal.slice();\n const dt=Math.min(frameTime,duration-i*frameTime);\n f.bands.forEach((level,k)=>{phaseTotal[k]+=Math.sqrt(level)*1.6*(.85+k*.15)*dt;});\n});\nfunction softSignal(t){\n const cycle=Math.floor(t/duration),local=mod(t,duration);\n const i=Math.min(softFrames.length-1,Math.floor(local/frameTime));\n const last=i===softFrames.length-1,a=softFrames[i],b=softFrames[last?0:i+1];\n const q=(local-i*frameTime)/(last?duration-i*frameTime:frameTime);\n return {\n  bins:a.bins.map((v,k)=>v+(b.bins[k]-v)*q),\n  bands:a.bands.map((v,k)=>v+(b.bands[k]-v)*q),\n  phase:a.phase.map((v,k)=>cycle*phaseTotal[k]+v+((last?phaseTotal[k]:b.phase[k])-v)*q)\n };\n}\nfunction drawPanel(panel,t){\n const {ctx,w,id}=panel,f=softSignal(t);\n ctx.clearRect(0,0,w,44);\n const cols=Math.max(2,Math.floor((w-4)/4)),rows=10;\n const ox=Math.round((w-((cols-1)*4+2))/2),oy=3;\n if(id===0){\n  // Filled angular fields: eight separated wedges, never vector spokes.\n  const spread=1.23,sector=spread*2/8;\n  for(let r=0;r<rows;r++)for(let c=0;c<cols;c++){\n   const dx=(c/(cols-1)*2-1)*1.05,dy=(rows-1-r)/9+.035;\n   const radius=Math.hypot(dx,dy),angle=Math.atan2(dx,dy);\n   const band=Math.floor((angle+spread)/sector);\n   if(band<0||band>7)continue;\n   const gap=Math.min(angle+spread-band*sector,(band+1)*sector-angle-spread);\n   const gapAlpha=clamp((gap-.025)/.025);\n   if(!gapAlpha)continue;\n   const e=f.bins[band],front=.19+.97*Math.sqrt(e);\n   const coverage=clamp((front-radius)/.085);\n   if(!coverage)continue;\n   const edge=clamp(1-Math.abs(front-radius-.045)/.13);\n   const body=(.15+.58*Math.sqrt(e))*(.8+.2*clamp(radius/front));\n   const alpha=coverage*gapAlpha*(body*(1-edge)+edge*.98);\n   const white=Math.round(255*(1-edge));\n   ctx.globalAlpha=alpha;\n   ctx.fillStyle='rgb(255,'+white+','+white+')';\n   ctx.fillRect(ox+c*4,oy+r*4,2,2);\n  }\n }else{\n  // Light is distributed between fixed neighboring square cells. The heads\n  // move continuously, but the cell size and lattice never swim or blur.\n  const lights=new Float32Array(cols*rows*3);\n  function cell(c,r,power,redness){\n   if(c<0||c>=cols||r<0||r>=rows)return;\n   const k=(r*cols+c)*3;\n   lights[k]+=power;lights[k+1]+=power*(1-redness);lights[k+2]+=power*(1-redness);\n  }\n  function splat(x,y,power,redness=0){\n   const gx=(x+1)*.5*(cols-1),gy=(y+1)*.5*(rows-1);\n   const c=Math.floor(gx),r=Math.floor(gy),fx=gx-c,fy=gy-r;\n   cell(c,r,power*(1-fx)*(1-fy),redness);\n   cell(c+1,r,power*fx*(1-fy),redness);\n   cell(c,r+1,power*(1-fx)*fy,redness);\n   cell(c+1,r+1,power*fx*fy,redness);\n  }\n  for(let band=0;band<3;band++){\n   const rx=.30+band*.27,ry=.24+band*.28,level=f.bands[band];\n   const phase=f.phase[band]+band*2;\n   // Guides stay still; only the satellites move.\n   const count=28+band*20;\n   for(let n=0;n<count;n++){\n    const a=n/count*tau;\n    splat(Math.cos(a)*rx,Math.sin(a)*ry,.30);\n   }\n   for(let j=20;j>=0;j--){\n    const a=phase-j*.038;\n    const fade=Math.exp(-j*.16)*(.42+Math.sqrt(level)*1.15);\n    const redness=Math.exp(-j*.5);\n    splat(Math.cos(a)*rx,Math.sin(a)*ry,fade,redness);\n   }\n   splat(Math.cos(phase)*rx,Math.sin(phase)*ry,1.25,1);\n  }\n  ctx.globalAlpha=1;\n  for(let r=0;r<rows;r++)for(let c=0;c<cols;c++){\n   const k=(r*cols+c)*3,max=Math.max(lights[k],lights[k+1],lights[k+2]);\n   if(max<.002)continue;\n   const scale=255/(1+max*.32);\n   ctx.fillStyle='rgb('+Math.round(clamp(lights[k]*scale,0,255))+','+Math.round(clamp(lights[k+1]*scale,0,255))+','+Math.round(clamp(lights[k+2]*scale,0,255))+')';\n   ctx.fillRect(ox+c*4,oy+r*4,2,2);\n  }\n }\n ctx.globalAlpha=1;\n}\nfunction draw(){panels.forEach(p=>{if(p.visible)drawPanel(p,time);});}\nfunction resize(){const dpr=Math.min(devicePixelRatio||1,2);panels.forEach(p=>{p.w=Math.max(1,p.c.getBoundingClientRect().width);p.c.width=Math.round(p.w*dpr);p.c.height=44*dpr;p.ctx.setTransform(dpr,0,0,dpr,0,0);drawPanel(p,time);});}\nfunction schedule(){if(!raf&&!paused&&visible&&!document.hidden&&root.isConnected){last=0;raf=requestAnimationFrame(frame);}}\nfunction frame(now){raf=0;if(!root.isConnected){stopSound();if(context)context.close();return;}if(paused||!visible||document.hidden)return;if(!last)last=now;const dt=now-last;if(dt>=1000/60-1){time=audible?clock():live()?live().songTime:time+Math.min(dt/1000,.08);last=now;draw();}raf=requestAnimationFrame(frame);}\nsoundButton.addEventListener('click',()=>audible?stopSound():startSound());\npauseButton.addEventListener('click',()=>{if(!paused)stopSound();paused=!paused;sync();schedule();});\nreduced.addEventListener('change',e=>{if(e.matches)stopSound();paused=e.matches;sync();schedule();});\ndocument.addEventListener('visibilitychange',()=>{if(document.hidden)stopSound();else schedule();});\nwindow.addEventListener('pagehide',()=>{stopSound();if(context)context.close();});\nnew ResizeObserver(resize).observe(container);\nconst observer=new IntersectionObserver(entries=>{entries.forEach(e=>{const panel=panels.find(p=>p.figure===e.target);if(panel){panel.visible=e.isIntersecting;if(panel.visible)drawPanel(panel,time);}else{visible=e.isIntersecting;if(!visible)stopSound();}});schedule();});\nobserver.observe(root);panels.forEach(p=>observer.observe(p.figure));\nsync();resize();schedule();\n})();\n</script>\n","css":":root{color-scheme:dark;--background:#000;--foreground:#eee;--muted-foreground:#999}*{box-sizing:border-box}body{margin:0;padding:24px;background:#000;color:#eee;font:16px/1.5 Arial,Helvetica,sans-serif}button{font:inherit;cursor:pointer}.viz-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:24px}.btn{color:#bbb;background:#141414;border:1px solid #333;border-radius:6px;min-height:44px;padding:9px 14px;text-align:left}.btn[aria-pressed=true]{color:#fff;border-color:#ddd;background:#262626}.btn-block{width:100%}.text-small{font-size:14px}.text-muted{color:#999}:focus-visible{outline:2px solid #fff;outline-offset:3px}[hidden]{display:none!important}h3{font-size:18px;font-weight:500}figcaption{font-size:16px}canvas{max-width:100%}@media(max-width:520px){body{padding:16px}}"}