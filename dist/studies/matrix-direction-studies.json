{"html":"<div id=\"matrix-directions-v1\">\n  <div class=\"viz-controls\"><button type=\"button\" class=\"btn\" data-pause aria-pressed=\"false\">Duraklat</button><span class=\"text-small\">Örnek ritim · sessiz demo</span></div>\n  <div class=\"direction-grid\"></div>\n</div>\n<style>\n#matrix-directions-v1 .direction-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:16px}\n#matrix-directions-v1 figure{margin:0;min-width:0}\n#matrix-directions-v1 .matrix-screen{background:#000;padding:28px 12px}\n#matrix-directions-v1 canvas{display:block;width:100%;height:44px}\n#matrix-directions-v1 figcaption{margin-top:8px;color:var(--foreground)}\n#matrix-directions-v1 .direction-label{display:block;margin-top:3px;color:var(--muted-foreground)}\n@media(max-width:520px){#matrix-directions-v1 .direction-grid{grid-template-columns:1fr}}\n</style>\n<script>\n(()=>{\nconst root=document.getElementById('matrix-directions-v1');\nconst studies=[\n ['01 · Gravity Curtain','Yukarıdan aşağıya','Hücre perdeleri aşağıya akar; kırmızı ön kenarı gri izler takip eder.'],\n ['02 · Oblique Relay','Sol üstten sağ alta','Paralel çapraz hücre şeritleri tek bir yönde ilerler.'],\n ['03 · Twin Helix','Birbirine dolanan iki akış','İki hücre bandı karşıt fazlarda ilerleyip ortada kesişir.'],\n ['04 · Spiral Sink','Dönerek merkeze','Spiral hücre kolları dönerek merkeze çekilir.'],\n ['05 · Corner Tide','Köşeden karşı köşeye','Köşeler sırayla dalga üretir; hücre halkaları karşı kenarlara genişler.']\n];\nconst grid=root.querySelector('.direction-grid');\nconst panels=studies.map(([name,direction,description])=>{\n const figure=document.createElement('figure'),screen=document.createElement('div'),canvas=document.createElement('canvas'),caption=document.createElement('figcaption'),label=document.createElement('span');\n screen.className='matrix-screen';canvas.setAttribute('role','img');canvas.setAttribute('aria-label',name+'. '+description);caption.textContent=name;label.className='direction-label text-small';label.textContent=direction;caption.append(label);screen.append(canvas);figure.append(screen,caption);grid.append(figure);\n return {canvas,ctx:canvas.getContext('2d'),width:300};\n});\nconst reduced=matchMedia('(prefers-reduced-motion: reduce)'),pause=root.querySelector('[data-pause]');\nlet paused=reduced.matches,visible=true,time=1.8,last=0,raf=0;\nconst tau=Math.PI*2,mod=(n,d)=>(n%d+d)%d,fract=x=>x-Math.floor(x);\nfunction draw(){\n panels.forEach((panel,id)=>{\n  const {ctx,width}=panel,cols=Math.max(12,Math.floor((width-4)/4)),left=(width-cols*4)/2;\n  ctx.clearRect(0,0,width,44);\n  for(let c=0;c<cols;c++)for(let r=0;r<10;r++){\n   const u=(c/(cols-1)-.5)*2,v=(r/9-.5)*2;\n   let strength=0,red=false;\n   if(id===0){\n    const head=mod(time*2.2+Math.cos(u*3.5)*1.3,15)-2;\n    const age=mod(head-r,15),gate=mod(c,4)!==3;\n    if(gate&&age<5){strength=age<.85?3:age<2.6?2:1;red=age<.85;}\n   }else if(id===1){\n    const flow=mod(u*1.5+v*.55-time*.24,1.25);\n    if(flow<.32){strength=flow<.07?3:flow<.17?2:1;red=flow<.07;}\n   }else if(id===2){\n    const phase=u*4.3-time*.85,track=Math.sin(phase)*.72;\n    const d1=Math.abs(v-track),d2=Math.abs(v+track);\n    if(d1<.23||d2<.23){strength=Math.min(d1,d2)<.12?3:1;red=d1<.12&&mod(c-Math.floor(time*5),17)<5;}\n    if(mod(c,7)===0&&v>Math.min(track,-track)&&v<Math.max(track,-track))strength=Math.max(strength,1);\n   }else if(id===3){\n    const radius=Math.hypot(u,v*.92),angle=Math.atan2(v*.92,u);\n    const turn=mod(angle/tau+radius*.95+time*.11,1/3);\n    if(radius<1.04&&radius>.1&&turn<.09){strength=turn<.027?3:turn<.055?2:1;red=turn<.027&&mod(radius+time*.11,.45)<.14;}\n    if(radius<.11){strength=3;red=true;}\n   }else{\n    const corner=Math.floor(time/7)%4,phase=fract(time/7),corners=[[-1,-1],[1,1],[1,-1],[-1,1]],origin=corners[corner];\n    const distance=Math.hypot(u-origin[0],(v-origin[1])*.65),front=phase*3.1;\n    const age=front-distance;\n    if(age>=0&&age<1.25){const band=mod(age,.34);if(band<.15){strength=age<.15?3:age<.65?2:1;red=age<.15;}}\n   }\n   if(strength){ctx.fillStyle=red?'#FF0000':strength===3?'#FFFFFF':strength===2?'#8F8F8F':'#525252';ctx.fillRect(left+c*4,3+r*4,2,2);}\n  }\n });\n}\nfunction resize(){const dpr=Math.min(devicePixelRatio||1,2);panels.forEach(p=>{p.width=Math.max(1,p.canvas.getBoundingClientRect().width);p.canvas.width=Math.round(p.width*dpr);p.canvas.height=44*dpr;p.ctx.setTransform(dpr,0,0,dpr,0,0);});draw();}\nfunction sync(){pause.textContent=paused?'Devam et':'Duraklat';pause.setAttribute('aria-pressed',String(paused));}\nfunction schedule(){if(!raf&&!paused&&visible&&!document.hidden&&root.isConnected){last=0;raf=requestAnimationFrame(frame);}}\nfunction frame(now){raf=0;if(paused||!visible||document.hidden||!root.isConnected)return;if(!last)last=now;const delta=now-last;if(delta>=1000/30){time+=Math.min(delta/1000,.08);last=now;draw();}raf=requestAnimationFrame(frame);}\npause.addEventListener('click',()=>{paused=!paused;sync();schedule();});\nreduced.addEventListener('change',e=>{paused=e.matches;sync();schedule();});\ndocument.addEventListener('visibilitychange',schedule);\nnew ResizeObserver(resize).observe(grid);\nnew IntersectionObserver(entries=>{visible=entries[entries.length-1].isIntersecting;schedule();}).observe(root);\nsync();resize();schedule();\n})();\n</script>\n","css":":root{color-scheme:dark;--background:#000;--foreground:#eee;--muted-foreground:#999}*{box-sizing:border-box}body{margin:0;padding:24px;background:#000;color:#eee;font:16px/1.5 Arial,Helvetica,sans-serif}button{font:inherit;cursor:pointer}.viz-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:24px}.btn{color:#bbb;background:#141414;border:1px solid #333;border-radius:6px;min-height:44px;padding:9px 14px;text-align:left}.btn[aria-pressed=true]{color:#fff;border-color:#ddd;background:#262626}.btn-block{width:100%}.text-small{font-size:14px}.text-muted{color:#999}:focus-visible{outline:2px solid #fff;outline-offset:3px}[hidden]{display:none!important}h3{font-size:18px;font-weight:500}figcaption{font-size:16px}canvas{max-width:100%}@media(max-width:520px){body{padding:16px}}"}