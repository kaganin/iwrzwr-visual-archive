{"html":"<div id=\"iwr-night-fieldops\" aria-label=\"Set 10: Field Operations, beş hareketli ses ekranı\">\n  <div class=\"viz-controls\">\n    <button type=\"button\" class=\"btn\" data-mode=\"play\" aria-pressed=\"true\">Çalma</button>\n    <button type=\"button\" class=\"btn\" data-mode=\"record\" aria-pressed=\"false\">Kayıt</button>\n    <button type=\"button\" class=\"btn btn-ghost\" data-pause aria-pressed=\"false\">Duraklat</button>\n    <span class=\"text-small text-muted\">Örnek ses ritmi · sessiz demo</span>\n  </div>\n  <div class=\"fo-layout\">\n    <div class=\"fo-stage\">\n      <div class=\"fo-phone\" aria-label=\"iwrzwr: Field Operations önizlemesi\">\n        <div class=\"fo-header\">\n          <div class=\"fo-status\" aria-hidden=\"true\"><span>9:41</span><span data-record hidden>REC</span><span>••• &nbsp; ▰</span></div>\n          <div class=\"fo-controls\">\n            <div class=\"fo-circle\" aria-hidden=\"true\"></div>\n            <canvas role=\"img\" aria-label=\"Section Gate: sabit tel çerçevenin içinden alınan hareketli kesit\"></canvas>\n            <div class=\"fo-circle\" aria-hidden=\"true\"><i data-lucide=\"plus\"></i></div>\n          </div>\n        </div>\n        <div class=\"fo-pads\" aria-hidden=\"true\"><div><i data-lucide=\"mic\"></i></div><div><i data-lucide=\"mic\"></i></div></div>\n      </div>\n      <div class=\"text-small text-muted fo-spec\">126px header · 44px alan · 24px boşluk</div>\n    </div>\n    <div class=\"fo-options\" role=\"group\" aria-label=\"Field Operations seçenekleri\">\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"section\" aria-pressed=\"true\">1 · Section Gate</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"strain\" aria-pressed=\"false\">2 · Field Strain</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"atlas\" aria-pressed=\"false\">3 · Compression Atlas</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"flare\" aria-pressed=\"false\">4 · Flare Stem</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"slots\" aria-pressed=\"false\">5 · Event Slots</button>\n    </div>\n  </div>\n  <div class=\"fo-caption\" data-description aria-live=\"polite\">Sabit hacmi kesen düzlem, altı çizginin gerçek kesişimlerini ortaya çıkarıyor.</div>\n</div>\n<style>\n  #iwr-night-fieldops .fo-layout { display:grid; grid-template-columns:minmax(0,402px) minmax(190px,1fr); gap:24px; align-items:center; margin-top:20px; }\n  #iwr-night-fieldops .fo-stage { min-width:0; }\n  #iwr-night-fieldops .fo-options { display:grid; gap:8px; }\n  #iwr-night-fieldops .fo-phone { --fo-screen:#000; --fo-pad:#cdcdcd; --fo-divider:#b6b6b6; --fo-ink:#f1f0e8; color:var(--fo-ink); background:var(--fo-pad); border-radius:30px; overflow:hidden; font-family:-apple-system,BlinkMacSystemFont,sans-serif; }\n  #iwr-night-fieldops .fo-header { height:126px; position:relative; background:var(--fo-screen); border-radius:0 0 32px 40px; }\n  #iwr-night-fieldops .fo-status { position:absolute; top:24px; left:28px; right:28px; display:flex; align-items:center; justify-content:space-between; font-size:13px; font-weight:500; }\n  #iwr-night-fieldops [data-record] { color:#FF0000; font-family:ui-monospace,monospace; font-size:11px; }\n  #iwr-night-fieldops [hidden] { display:none; }\n  #iwr-night-fieldops .fo-controls { position:absolute; top:62px; left:20px; right:20px; display:flex; align-items:center; gap:24px; height:44px; }\n  #iwr-night-fieldops .fo-circle { width:44px; height:44px; flex:none; display:grid; place-items:center; border-radius:50%; background:#141414; box-shadow:inset 0 0 0 1px #303030; }\n  #iwr-night-fieldops .fo-circle svg { width:20px; height:20px; stroke-width:1.5; }\n  #iwr-night-fieldops canvas { display:block; height:44px; width:100%; flex:1; min-width:0; }\n  #iwr-night-fieldops .fo-pads { display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--fo-divider); }\n  #iwr-night-fieldops .fo-pads>div { display:grid; place-items:center; height:120px; background:var(--fo-pad); color:#929292; }\n  #iwr-night-fieldops .fo-pads svg { width:18px; height:18px; }\n  #iwr-night-fieldops .fo-spec { margin-top:10px; }\n  #iwr-night-fieldops .fo-caption { margin-top:16px; min-height:44px; }\n  @media(max-width:630px) { #iwr-night-fieldops .fo-layout { grid-template-columns:minmax(0,1fr); gap:18px; } #iwr-night-fieldops .fo-stage { width:100%; max-width:402px; margin:auto; } }\n</style>\n<script>\n(() => {\n  const root=document.getElementById('iwr-night-fieldops');\n  const canvas=root.querySelector('canvas'),ctx=canvas.getContext('2d');\n  const pause=root.querySelector('[data-pause]'),caption=root.querySelector('[data-description]');\n  const reduced=matchMedia('(prefers-reduced-motion: reduce)');\n  const state={style:'section',mode:'play',paused:reduced.matches,accent:true};\n  const names={section:'Section Gate',strain:'Field Strain',atlas:'Compression Atlas',flare:'Flare Stem',slots:'Event Slots'};\n  const descriptions={\n    section:['Sabit hacmi kesen düzlem, altı çizginin gerçek kesişimlerini ortaya çıkarıyor.','Yeni kesit katman katman yazılıyor; önceki beş kesit yerinde kalıyor.'],\n    strain:['Bağlı koordinat çizgileri yerel bir çekimle bükülüyor; kenarlar hep aynı yerde.','Her darbe sabit bir kavşağı çekip bırakıyor; sessizlikte bütün alan yeniden düz.'],\n    atlas:['Altmış işaret korunuyor; yalnız bir hücrenin yerleşimi dönüşüyor.','Sıradaki on iki işaret bekleme rafından açılıyor; yazılmış hücreler sabit kalıyor.'],\n    flare:['Beş çizgi tek boğazdan açılıyor; ses yalnız ortak açıklığı değiştiriyor.','Boğaz darbeyle açılıp kapanıyor; biten darbeler uçlarda küçük çentikler bırakıyor.'],\n    slots:['Basamak yüksekliği ses şiddeti değil, geçen süre; imleç dolu ve boş aralıkları okuyor.','Süre basamakları açık uçtan büyüyor; ses bitince kapanıyor, sessizlik boş kalıyor.']\n  };\n  const white='#f1f0e8',amber='#FF0000';\n  let w=226,dpr=1,t=2.4,last=0,raf=0,visible=true;\n  const clamp=(x,a=0,b=1)=>Math.min(b,Math.max(a,x));\n  // Live sound seam: iwrSignal exists only inside the archive gallery. Without it, or with sound off, nothing changes.\n  const hearing=()=>typeof iwrSignal!=='undefined'&&iwrSignal.active?iwrSignal:null;\n  // Time-driven machines move on the beat and rest between hits; the studies' own dt clamps still apply first.\n  const conduct=()=>{const s=hearing();return s?0.25+4.2*s.hit:1;};\n  const fract=x=>x-Math.floor(x),mod=(x,n)=>(x%n+n)%n,mix=(a,b,p)=>a+(b-a)*p;\n  const accent=()=>state.accent?amber:white;\n  // Silent deterministic timing, not microphone input or a physical simulation.\n  function pulse(time,period=1.8,length=.95) { const s=hearing(); if(s){const heard=Math.abs(t-time)%3.4;return Math.max(s.hitAt(heard),.8*s.levelAt(heard));} const age=mod(time,period);return age>=length?0:Math.pow(Math.sin(Math.PI*age/length),2); }\n  function ink(alpha=1,color=white) { ctx.globalAlpha=clamp(alpha);ctx.fillStyle=color;ctx.strokeStyle=color; }\n  function rect(x,y,width,height,alpha=1,color=white) { ink(alpha,color);ctx.fillRect(Math.round(x*dpr)/dpr,Math.round(y*dpr)/dpr,width,height); }\n  function line(points,alpha=1,color=white) { if(!points.length)return;ink(alpha,color);ctx.lineWidth=1;ctx.lineCap='butt';ctx.lineJoin='miter';ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]));ctx.stroke(); }\n  function area(points,alpha=.12,color=white) { if(points.length<3)return;ink(alpha,color);ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]));ctx.closePath();ctx.fill(); }\n  function marker(x,y,alpha=1,color=white,size=2) { rect(x-size/2,y-size/2,size,size,alpha,color); }\n  function project(x,y,z) { return [10+x*(w-30)+z*10,22-y*12-z*6]; }\n  function sectionCurve(x,z,take=0) { return .48*Math.sin(x*5.5+take*.7)+.24*Math.cos(z*4.4+x*2.1+take*.4); }\n  function section(time) {\n    const recording=state.mode==='record',step=Math.floor(time*.85),phase=fract(time*.85),active=mod(step,6),cut=recording?(active+.5)/6:.08+fract(time*.18)*.84;\n    for(const z of[0,1])line([project(0,-1,z),project(1,-1,z),project(1,1,z),project(0,1,z),project(0,-1,z)],.24);\n    for(const x of[0,1])for(const y of[-1,1])line([project(x,y,0),project(x,y,1)],.24);\n    const plane=[project(cut,-1,0),project(cut,-1,1),project(cut,1,1),project(cut,1,0),project(cut,-1,0)];\n    area(plane,.035,accent());line(plane,.6,accent());\n    if(recording) {\n      for(let station=0;station<6;station++) {\n        const x=(station+.5)/6,take=step-mod(step-station,6),live=station===active,extent=live?phase:1,points=[];\n        for(let j=0;j<=12;j++) { const z=j/12;if(z>extent)break;points.push(project(x,sectionCurve(x,z,take),z)); }\n        if(live)points.push(project(x,sectionCurve(x,extent,take),extent));\n        line(points,live?1:.36,live?accent():white);\n        if(live&&points.length){const p=points[points.length-1];marker(p[0],p[1],1,accent(),3);}\n      }\n    } else {\n      const cross=[];\n      for(let rail=0;rail<6;rail++) {\n        const z=rail/5,points=[],slice=[];\n        for(let j=0;j<=24;j++){const x=j/24;points.push(project(x,sectionCurve(x,z),z));}\n        line(points,.13);\n        for(let j=0;j<=6;j++){const x=clamp(cut-.04+j*.08/6);slice.push(project(x,sectionCurve(x,z),z));}\n        line(slice,.9);\n        const hit=project(cut,sectionCurve(cut,z),z);cross.push(hit);marker(hit[0],hit[1],1,accent(),2);\n      }\n      line(cross,.9,accent());\n    }\n  }\n  function strainPoint(u,v,loci) {\n    const pin=Math.sin(Math.PI*u)*Math.sin(Math.PI*v);let dx=0,dy=0;\n    for(const locus of loci) {\n      const a=(u-locus.u)/.2,b=(v-locus.v)/.42,influence=Math.exp(-(a*a+b*b))*locus.force*pin;\n      dx+=(locus.u-u)*.38*influence;dy+=locus.pull*.32*influence;\n    }\n    return [5+(u+dx)*(w-10),5+(v+dy)*34];\n  }\n  function strain(time) {\n    const recording=state.mode==='record',loci=[];\n    if(recording) {\n      const step=Math.floor(time/1.8),age=mod(time,1.8),u=[.25,.5,.75][mod(step,3)],v=mod(step,2)?.75:.25;\n      const force=age<.85?Math.pow(1-age/.85,2):0;\n      loci.push({u,v,force,pull:mod(step,2)?-1:1});\n    } else {\n      loci.push({u:.15+fract(time*.12)*.7,v:.5,force:pulse(time),pull:Math.sin(time*.8)>=0?1:-1});\n    }\n    for(let row=0;row<5;row++) {\n      const points=[];for(let j=0;j<=28;j++)points.push(strainPoint(j/28,row/4,loci));line(points,row===2?.56:.31);\n    }\n    for(let col=0;col<9;col++) {\n      const points=[];for(let j=0;j<=16;j++)points.push(strainPoint(col/8,j/16,loci));line(points,.32);\n    }\n    for(const locus of loci)if(locus.force>.005) {\n      const p=strainPoint(locus.u,locus.v,loci),radius=2+locus.force*2;\n      line([[p[0]-radius,p[1]],[p[0]+radius,p[1]]],.95,accent());line([[p[0],p[1]-radius],[p[0],p[1]+radius]],.95,accent());\n    }\n  }\n  function atlasPosition(pattern,index,width) {\n    const col=index%3,row=Math.floor(index/3);\n    switch(mod(pattern,5)) {\n      case 0:return [width*(.2+col*.3),9+row*8];\n      case 1:return [width*(.13+(index%6)*.148),14+Math.floor(index/6)*15];\n      case 2:{const side=Math.floor(index/3),q=index%3;return [[width*(.2+q*.2),9],[width*.8,9+q*8],[width*(.8-q*.2),33],[width*.2,33-q*8]][side];}\n      case 3:return [width*(.36+(index%2)*.28),7+Math.floor(index/2)*5.8];\n      default:return [width*(.14+col*.28+row*.055),8+row*8+col*1.5];\n    }\n  }\n  function atlas(time) {\n    const recording=state.mode==='record',step=Math.floor(time*.8),phase=fract(time*.8),active=mod(step,5),epoch=Math.floor(step/5),cell=(w-8)/5;\n    for(let i=0;i<5;i++) {\n      const origin=4+i*cell,width=cell-3;\n      line([[origin,40],[origin+width,40]],i===active?.8:.2,i===active?accent():white);\n      for(let index=0;index<12;index++) {\n        let a,b,q;\n        if(recording) {\n          const rack=[width*(.12+(index%6)*.15),32+Math.floor(index/6)*5];\n          const target=atlasPosition(i+epoch,index,width);\n          a=rack;b=target;q=i<active?1:i>active?0:clamp(phase/.38);\n        } else {\n          const pattern=i+epoch+(i<active?1:0);a=atlasPosition(pattern,index,width);b=atlasPosition(pattern+1,index,width);q=i===active?phase:0;\n        }\n        const x=origin+mix(a[0],b[0],q),y=mix(a[1],b[1],q);\n        marker(x,y,i===active?.96:recording&&i>active?.38:.7,i===active?accent():white,2);\n      }\n    }\n  }\n  function flare(time) {\n    const recording=state.mode==='record',step=Math.floor(time/1.8),age=mod(time,1.8),beat=pulse(time),opening=recording?1+beat*6:1.2+pulse(time,2.4,1.65)*6,throat=w*.2,shoulder=w*.38,rim=w*.76;\n    line([[4,22],[throat,22]],.85);\n    line([[throat-3,18],[throat-3,26]],.36);\n    for(let track=0;track<5;track++) {\n      const offset=track-2,endpoint=8+track*7,points=[[throat,22],[shoulder,22+offset*.7],[rim,22+offset*opening],[w-9,endpoint]];\n      line(points,track===2?.8:.66,recording&&track===mod(step,5)?accent():white);\n      line([[w-7,endpoint],[w-3,endpoint]],.35);\n      if(recording&&track<=mod(step,5)&&(track<mod(step,5)||age>.95)) {\n        line([[w-10,endpoint-2],[w-7,endpoint-2],[w-7,endpoint+2],[w-4,endpoint+2]],track===mod(step,5)?1:.65,track===mod(step,5)?accent():white);\n      }\n    }\n    if(!recording)line([[rim-3,22-opening*2-3],[rim,22-opening*2-3],[rim,22+opening*2+3],[rim-3,22+opening*2+3]],.48,accent());\n  }\n  const slotPhrases=[{start:0,length:3},{start:4,length:2},{start:8,length:4},{start:13,length:2}];\n  function slots(time) {\n    const recording=state.mode==='record',units=16,cursor=mod(time*2.2,units),pitch=(w-8)/units,base=37;\n    line([[4,base],[w-4,base]],.25);\n    for(let i=0;i<=units;i++)line([[4+i*pitch,39],[4+i*pitch,41]],.18);\n    for(const phrase of slotPhrases) {\n      const elapsed=recording?clamp(cursor-phrase.start,0,phrase.length):phrase.length;\n      if(elapsed<=0)continue;\n      const start=4+phrase.start*pitch,top=[[start,base]],live=cursor>=phrase.start&&cursor<phrase.start+phrase.length;\n      for(let cell=0;cell<Math.ceil(elapsed);cell++) {\n        const x=start+cell*pitch,y=base-(cell+1)*6,end=start+Math.min(elapsed,cell+1)*pitch;\n        top.push([x,y],[end,y]);\n      }\n      const end=top[top.length-1],closed=!recording||elapsed===phrase.length;\n      area([...top,[end[0],base]],live?.17:.09,live?accent():white);\n      line(top,live?.95:.57,live?accent():white);\n      if(closed)line([end,[end[0],base]],.57);\n      else {marker(end[0],end[1],1,accent(),3);line([[end[0]-2,base+2],[end[0]+2,base+2]],.85,accent());}\n    }\n    const x=4+cursor*pitch;\n    if(!recording) {line([[x,5],[x,base+1]],.6,accent());line([[x-2,4],[x,6],[x+2,4]],.9,accent());}\n    else line([[x-2,4],[x+2,4]],.9,accent());\n  }\n  const renderers={section,strain,atlas,flare,slots};\n  function draw() { ctx.clearRect(0,0,w,44);ctx.save();ctx.beginPath();ctx.rect(0,0,w,44);ctx.clip();renderers[state.style](t);ctx.restore(); }\n  function sync() {\n    root.querySelectorAll('[data-style]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.style===state.style)));\n    root.querySelectorAll('[data-mode]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.mode===state.mode)));\n    const description=descriptions[state.style][state.mode==='record'?1:0];caption.textContent=description;canvas.setAttribute('aria-label',names[state.style]+': '+description);\n    root.querySelector('[data-record]').hidden=state.mode!=='record';pause.textContent=state.paused?'Devam et':'Duraklat';pause.setAttribute('aria-pressed',String(state.paused));draw();schedule();\n  }\n  function resize() { w=Math.max(1,canvas.getBoundingClientRect().width);dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(w*dpr);canvas.height=44*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);draw(); }\n  function schedule() { if(!raf&&!state.paused&&visible&&!document.hidden&&root.isConnected) { last=0;raf=requestAnimationFrame(frame); } }\n  function frame(now) { raf=0;if(state.paused||!visible||document.hidden||!root.isConnected)return;if(!last)last=now;const elapsed=now-last;if(elapsed>=1000/30){t+=Math.min(elapsed/1000,.07)*conduct();last=now;draw();}raf=requestAnimationFrame(frame); }\n  root.querySelectorAll('[data-style]').forEach(el=>el.addEventListener('click',()=>{state.style=el.dataset.style;sync();}));\n  root.querySelectorAll('[data-mode]').forEach(el=>el.addEventListener('click',()=>{state.mode=el.dataset.mode;sync();}));\n  pause.addEventListener('click',()=>{state.paused=!state.paused;sync();});\n  reduced.addEventListener('change',()=>{state.paused=reduced.matches;sync();});\n  document.addEventListener('visibilitychange',schedule);\n  new ResizeObserver(resize).observe(canvas);\n  new IntersectionObserver(entries=>{\n    const latest=entries.filter(entry=>entry.target===root).reduce((a,b)=>!a||b.time>=a.time?b:a,null);\n    if(latest){visible=latest.isIntersecting;schedule();}\n  }).observe(root);\n  resize();sync();\n  if(globalThis.Tweak){const tweak=new Tweak({container:root.querySelector('.fo-phone'),onChange:sync});tweak.addToggle(state,'accent',{label:'Kehribar vurgu'});}\n})();\n</script>\n","css":":root{color-scheme:dark;--background:#000;--foreground:#eee;--muted-foreground:#999}*{box-sizing:border-box}body{margin:0;padding:24px;background:#000;color:#eee;font:16px/1.5 Arial,Helvetica,sans-serif}button{font:inherit;cursor:pointer}.viz-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:24px}.btn{color:#bbb;background:#141414;border:1px solid #333;border-radius:6px;min-height:44px;padding:9px 14px;text-align:left}.btn[aria-pressed=true]{color:#fff;border-color:#ddd;background:#262626}.btn-block{width:100%}.text-small{font-size:14px}.text-muted{color:#999}:focus-visible{outline:2px solid #fff;outline-offset:3px}[hidden]{display:none!important}h3{font-size:18px;font-weight:500}figcaption{font-size:16px}canvas{max-width:100%}@media(max-width:520px){body{padding:16px}}"}