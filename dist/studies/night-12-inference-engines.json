{"html":"<div id=\"iwr-night-inference\" aria-label=\"Set 12: Inference Engines, beş hareketli ses ekranı\">\n  <div class=\"viz-controls\">\n    <button type=\"button\" class=\"btn\" data-mode=\"play\" aria-pressed=\"true\">Çalma</button>\n    <button type=\"button\" class=\"btn\" data-mode=\"record\" aria-pressed=\"false\">Kayıt</button>\n    <button type=\"button\" class=\"btn btn-ghost\" data-pause aria-pressed=\"false\">Duraklat</button>\n    <span class=\"text-small text-muted\">Örnek ses ritmi · sessiz demo</span>\n  </div>\n  <div class=\"ie-layout\">\n    <div class=\"ie-stage\">\n      <div class=\"ie-phone\" aria-label=\"iwrzwr: Inference Engines önizlemesi\">\n        <div class=\"ie-header\">\n          <div class=\"ie-status\" aria-hidden=\"true\"><span>9:41</span><span data-record hidden>REC</span><span>••• &nbsp; ▰</span></div>\n          <div class=\"ie-controls\">\n            <div class=\"ie-circle\" aria-hidden=\"true\"></div>\n            <canvas role=\"img\" aria-label=\"Ricochet Register: sabit sınırlar arasında yansıyan düz yollar\"></canvas>\n            <div class=\"ie-circle\" aria-hidden=\"true\"><i data-lucide=\"plus\"></i></div>\n          </div>\n        </div>\n        <div class=\"ie-pads\" aria-hidden=\"true\"><div><i data-lucide=\"mic\"></i></div><div><i data-lucide=\"mic\"></i></div></div>\n      </div>\n      <div class=\"text-small text-muted ie-spec\">126px header · 44px alan · 24px boşluk</div>\n    </div>\n    <div class=\"ie-options\" role=\"group\" aria-label=\"Inference Engines seçenekleri\">\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"ricochet\" aria-pressed=\"true\">1 · Ricochet Register</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"identity\" aria-pressed=\"false\">2 · Identity Hold</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"critical\" aria-pressed=\"false\">3 · Critical Sections</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"deferred\" aria-pressed=\"false\">4 · Deferred Yield</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"range\" aria-pressed=\"false\">5 · Range Reduction</button>\n    </div>\n  </div>\n  <div class=\"ie-caption\" data-description aria-live=\"polite\">Bir kayıtlı yol okunuyor; her çarpışmada geliş ve yansıma açısı aynı kalıyor.</div>\n</div>\n<style>\n  #iwr-night-inference .ie-layout { display:grid; grid-template-columns:minmax(0,402px) minmax(190px,1fr); gap:24px; align-items:center; margin-top:20px; }\n  #iwr-night-inference .ie-stage { min-width:0; }\n  #iwr-night-inference .ie-options { display:grid; gap:8px; }\n  #iwr-night-inference .ie-phone { --ie-screen:#000; --ie-pad:#cdcdcd; --ie-divider:#b6b6b6; --ie-ink:#f1f0e8; color:var(--ie-ink); background:var(--ie-pad); border-radius:30px; overflow:hidden; font-family:-apple-system,BlinkMacSystemFont,sans-serif; }\n  #iwr-night-inference .ie-header { height:126px; position:relative; background:var(--ie-screen); border-radius:0 0 32px 40px; }\n  #iwr-night-inference .ie-status { position:absolute; top:24px; left:28px; right:28px; display:flex; align-items:center; justify-content:space-between; font-size:13px; font-weight:500; }\n  #iwr-night-inference [data-record] { color:#FF0000; font-family:ui-monospace,monospace; font-size:11px; }\n  #iwr-night-inference [hidden] { display:none; }\n  #iwr-night-inference .ie-controls { position:absolute; top:62px; left:20px; right:20px; display:flex; align-items:center; gap:24px; height:44px; }\n  #iwr-night-inference .ie-circle { width:44px; height:44px; flex:none; display:grid; place-items:center; border-radius:50%; background:#141414; box-shadow:inset 0 0 0 1px #303030; }\n  #iwr-night-inference .ie-circle svg { width:20px; height:20px; stroke-width:1.5; }\n  #iwr-night-inference canvas { display:block; height:44px; width:100%; flex:1; min-width:0; }\n  #iwr-night-inference .ie-pads { display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--ie-divider); }\n  #iwr-night-inference .ie-pads>div { display:grid; place-items:center; height:120px; background:var(--ie-pad); color:#929292; }\n  #iwr-night-inference .ie-pads svg { width:18px; height:18px; }\n  #iwr-night-inference .ie-spec { margin-top:10px; }\n  #iwr-night-inference .ie-caption { margin-top:16px; min-height:44px; }\n  @media(max-width:630px) { #iwr-night-inference .ie-layout { grid-template-columns:minmax(0,1fr); gap:18px; } #iwr-night-inference .ie-stage { width:100%; max-width:402px; margin:auto; } }\n</style>\n<script>\n(() => {\n  const root=document.getElementById('iwr-night-inference');\n  const canvas=root.querySelector('canvas'),ctx=canvas.getContext('2d');\n  const pause=root.querySelector('[data-pause]'),caption=root.querySelector('[data-description]');\n  const reduced=matchMedia('(prefers-reduced-motion: reduce)');\n  const state={style:'ricochet',mode:'play',paused:reduced.matches,accent:true};\n  const names={ricochet:'Ricochet Register',identity:'Identity Hold',critical:'Critical Sections',deferred:'Deferred Yield',range:'Range Reduction'};\n  const descriptions={\n    ricochet:['Bir kayıtlı yol okunuyor; her çarpışmada geliş ve yansıma açısı aynı kalıyor.','Her darbe tek bir çıkış açısı yazıyor; diğer iki kayıtlı yol değişmiyor.'],\n    identity:['Kör bölgede kesik çizgi yalnız tahmin; yeniden gözlenince aynı işaret devam ediyor.','Yeni örnekler izi doğruluyor; doğrulama gecikirse kısa tahminin süresi doluyor.'],\n    critical:['Tek düzlemde adacıklar birleşip ayrılıyor; değişen şey bağlantı sayısı.','Her darbe bir eşik kesitini saklıyor; köprüler ve ayrılmalar sonraki darbeye kadar tutuluyor.'],\n    deferred:['Kayıtlı tamamlanma sırası okunuyor; bekleyen ve hazır kesitler ayrı görünüyor.','Üst iz yaş, alt tikler biriken girdi; ikisi dolmadan köşeler birleşmiyor.'],\n    range:['Aynı beş örnek min–maks aralığına ve medyana daralıyor, sonra aynen geri açılıyor.','Yeni örnekler aynı grubu güncelliyor; özet yalnız min, maks veya medyan değişince oynuyor.']\n  };\n  const white='#f1f0e8',amber='#FF0000';\n  let w=226,dpr=1,t=2.4,last=0,raf=0,visible=true;\n  const clamp=(x,a=0,b=1)=>Math.min(b,Math.max(a,x)),fract=x=>x-Math.floor(x),mod=(x,n)=>(x%n+n)%n,mix=(a,b,q)=>a+(b-a)*q;\n  const accent=()=>state.accent?amber:white;\n  function ink(alpha=1,color=white) { ctx.globalAlpha=clamp(alpha);ctx.fillStyle=color;ctx.strokeStyle=color; }\n  function rect(x,y,width,height,alpha=1,color=white) { ink(alpha,color);ctx.fillRect(Math.round(x*dpr)/dpr,Math.round(y*dpr)/dpr,width,height); }\n  function line(points,alpha=1,color=white,dash=[]) { if(!points.length)return;ink(alpha,color);ctx.lineWidth=1;ctx.lineCap='butt';ctx.lineJoin='miter';ctx.setLineDash(dash);ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]));ctx.stroke();ctx.setLineDash([]); }\n  function marker(x,y,alpha=1,color=white,size=2) { rect(x-size/2,y-size/2,size,size,alpha,color); }\n  function partial(path,progress) {\n    const lengths=path.slice(1).map((p,i)=>Math.hypot(p[0]-path[i][0],p[1]-path[i][1]));let distance=clamp(progress)*lengths.reduce((a,b)=>a+b,0),out=[path[0]];\n    for(let i=0;i<lengths.length;i++){if(distance<lengths[i]){const q=lengths[i]?distance/lengths[i]:0;out.push([mix(path[i][0],path[i+1][0],q),mix(path[i][1],path[i+1][1],q)]);break;}out.push(path[i+1]);distance-=lengths[i];}\n    return out;\n  }\n  // Deterministic illustrative geometry and data; no audio input or output.\n  function rayPath(slope,startY) {\n    let x=0,y=startY,direction=slope;const points=[[x,y]];\n    for(let segment=0;segment<4&&x<1-1e-9;segment++) {\n      const boundary=direction>0?1:0,travel=(boundary-y)/direction;\n      if(x+travel>=1){y+=(1-x)*direction;x=1;}else{x+=travel;y=boundary;direction=-direction;}\n      points.push([x,y]);\n    }\n    return points;\n  }\n  function ricochet(time) {\n    const recording=state.mode==='record',step=Math.floor(time*.55),phase=fract(time*.55),active=mod(step,3);\n    line([[5,8],[w-5,8]],.27);line([[5,36],[w-5,36]],.27);\n    for(let i=0;i<3;i++) {\n      const launch=recording?step-mod(step-i,3):i,slope=2.1+mod(launch,6)*.27,start=.3+mod(launch,3)*.1;\n      const path=rayPath(slope,start).map(p=>[5+p[0]*(w-10),8+p[1]*28]),live=i===active;\n      const shown=recording&&live?partial(path,clamp(phase/.36)):path;\n      line(shown,live?.88:.18,recording&&live?accent():white);\n      if(live) {\n        const read=recording?shown:partial(path,phase),point=read[read.length-1];marker(point[0],point[1],1,accent(),3);\n        path.slice(1,-1).forEach(p=>line([[p[0]-2,p[1]],[p[0]+2,p[1]]],.64));\n      }\n    }\n  }\n  function identityModel(time,recording) {\n    const period=4.2,cycle=Math.floor(time/period),u=mod(time,period)/period,lastObserved=.42,gapEnd=recording&&mod(cycle,2)? .79:.57;\n    const missing=u>=.43&&u<gapEnd,age=Math.max(0,u-lastObserved),lease=.18;\n    return {u,gapEnd,lastObserved,age,lease,status:!missing?'observed':age<=lease?'predicted':'unresolved',sampleU:recording?Math.floor(u/.025)*.025:u};\n  }\n  function identity(time) {\n    const recording=state.mode==='record',m=identityModel(time,recording),position=u=>[5+u*(w-10),13+u*16],left=position(.43)[0],right=position(.57)[0];\n    line([[left,11],[left,7],[right,7],[right,11]],.35);line([[left,33],[left,37],[right,37],[right,33]],.35);\n    const confirmed=m.status==='observed'?m.sampleU:m.lastObserved,tailStart=m.status==='observed'&&confirmed>m.gapEnd?Math.max(m.gapEnd,confirmed-.16):Math.max(0,confirmed-.16);\n    line([position(tailStart),position(confirmed)],.75);\n    for(let i=0;i<3;i++){const u=Math.max(tailStart,confirmed-i*.045),p=position(u);marker(p[0],p[1],.35);}\n    if(m.status==='observed') {\n      const p=position(m.sampleU);line([[p[0]-3,p[1]],[p[0],p[1]-3],[p[0]+3,p[1]],[p[0],p[1]+3],[p[0]-3,p[1]]],1,accent());\n    } else if(m.status==='predicted') {\n      const p=position(m.u);line([position(m.lastObserved),p],.9,accent(),[3,3]);line([[p[0]-3,p[1]-3],[p[0]+3,p[1]-3],[p[0]+3,p[1]+3],[p[0]-3,p[1]+3]],.8,accent(),[2,2]);\n    } else {\n      const p=position(m.lastObserved);line([[p[0]-3,p[1]-4],[p[0]-3,p[1]+4],[p[0]+1,p[1]+4]],.9,accent());\n    }\n  }\n  const fieldColumns=48,fieldRows=12,peaks=[[.22,.48,1],[.5,.55,.93],[.78,.44,.86]];\n  const scalarField=Array.from({length:fieldColumns*fieldRows},(_,index)=>{\n    const x=(index%fieldColumns+.5)/fieldColumns,y=(Math.floor(index/fieldColumns)+.5)/fieldRows;\n    return Math.max(...peaks.map(([cx,cy,height])=>height-((x-cx)/.2)**2-((y-cy)/.36)**2));\n  });\n  const topologyCache=new Map();let lastComponents=null,changedAt=-100;\n  function topology(threshold) {\n    const key=Math.round(clamp(threshold,0,1.04)*50);if(topologyCache.has(key))return topologyCache.get(key);\n    const inside=scalarField.map(value=>value>=key/50),seen=new Set(),edges=[];let components=0;\n    for(let index=0;index<inside.length;index++)if(inside[index]) {\n      const x=index%fieldColumns,y=Math.floor(index/fieldColumns);\n      if(y===0||!inside[index-fieldColumns])edges.push([[x,y],[x+1,y]]);\n      if(x===fieldColumns-1||!inside[index+1])edges.push([[x+1,y],[x+1,y+1]]);\n      if(y===fieldRows-1||!inside[index+fieldColumns])edges.push([[x+1,y+1],[x,y+1]]);\n      if(x===0||!inside[index-1])edges.push([[x,y+1],[x,y]]);\n      if(!seen.has(index)) {\n        components++;const queue=[index];seen.add(index);\n        for(let head=0;head<queue.length;head++) {\n          const cell=queue[head],column=cell%fieldColumns;\n          for(const next of[column>0?cell-1:-1,column<fieldColumns-1?cell+1:-1,cell-fieldColumns,cell+fieldColumns])if(next>=0&&next<inside.length&&inside[next]&&!seen.has(next)){seen.add(next);queue.push(next);}\n        }\n      }\n    }\n    const result={threshold:key/50,components,edges};topologyCache.set(key,result);return result;\n  }\n  function critical(time) {\n    const recording=state.mode==='record',cycle=fract(time/5),level=recording?[.74,.42,.14,.52,.9,1.02][mod(Math.floor(time),6)]:.12+.9*(1-Math.abs(cycle*2-1)),shape=topology(level);\n    if(lastComponents!==null&&lastComponents!==shape.components)changedAt=time;lastComponents=shape.components;\n    for(const [x,y,dx,dy] of[[4,4,1,1],[w-4,4,-1,1],[4,40,1,-1],[w-4,40,-1,-1]])line([[x+dx*5,y],[x,y],[x,y+dy*5]],.35);\n    ink(.82);ctx.lineWidth=1;ctx.lineCap='butt';ctx.lineJoin='miter';ctx.beginPath();\n    for(const edge of shape.edges){ctx.moveTo(6+edge[0][0]*(w-12)/fieldColumns,6+edge[0][1]*32/fieldRows);ctx.lineTo(6+edge[1][0]*(w-12)/fieldColumns,6+edge[1][1]*32/fieldRows);}ctx.stroke();\n    if(time-changedAt<.24)line([[w/2-3,42],[w/2,40],[w/2+3,42]],1,accent());\n  }\n  const jobs=[\n    {born:0,minAge:1.8,target:4,pulses:[[.2,4]]},\n    {born:.6,minAge:.8,target:4,pulses:[[.2,1],[.7,1],[1.5,2]]},\n    {born:1.2,minAge:1.2,target:4,pulses:[[.3,1],[.9,1],[1.8,2]]}\n  ];\n  function maturityTime(job) { let budget=0,budgetTime=Infinity;for(const [age,amount] of job.pulses){budget+=amount;if(budget>=job.target){budgetTime=age;break;}}return job.born+Math.max(job.minAge,budgetTime); }\n  function jobState(job,time) {\n    const age=Math.max(0,time-job.born),exists=time>=job.born,budget=exists?job.pulses.reduce((sum,[at,amount])=>sum+(age>=at?amount:0),0):0;\n    return {age,budget,exists,ageReady:exists&&age>=job.minAge,budgetReady:budget>=job.target,mature:exists&&age>=job.minAge&&budget>=job.target};\n  }\n  function deferred(time) {\n    const recording=state.mode==='record',clock=mod(time,5.4);\n    for(let i=0;i<jobs.length;i++) {\n      const job=jobs[i],status=jobState(job,clock),x=w*(.18+i*.32),path=[[x-10,29],[x-10,23],[x-3,23],[x+3,21],[x+10,21],[x+10,15]],readyAt=maturityTime(job);\n      if(recording) {\n        line(path.slice(0,3),status.exists?.82:.18,status.budgetReady?accent():white);line(path.slice(3),status.exists?.82:.18,status.ageReady?accent():white);\n        if(status.mature)line(path,.96,accent());\n        line([[x-12,7],[x+12,7]],.18);line([[x-12,7],[x-12+clamp(status.age/job.minAge)*24,7]],status.exists?.8:0,status.ageReady?accent():white);\n        for(let tick=0;tick<4;tick++)line([[x-10+tick*6,36],[x-7+tick*6,36]],status.budget>tick?.95:.16,status.budgetReady?accent():white);\n      } else {\n        line(path,status.mature?.9:.22);\n        if(clock>=readyAt&&clock-readyAt<.45)line(path,1,accent());\n        line([[x-2,35],[x+2,35]],status.mature?.7:.18);\n      }\n    }\n    if(!recording){line([[4,40],[w-4,40]],.2);marker(4+clock/5.4*(w-8),40,1,accent(),2);}\n  }\n  const cohorts=[[.2,.8,.5,.5,.35],[.7,.28,.48,.9,.1]],sampleOffsets=[-8,5,-3,9,0];\n  function summary(values) {\n    if(!values.length)return null;const ordered=[...values].sort((a,b)=>a-b),mid=Math.floor(ordered.length/2);\n    return {min:ordered[0],max:ordered[ordered.length-1],median:ordered.length%2?ordered[mid]:(ordered[mid-1]+ordered[mid])/2};\n  }\n  function range(time) {\n    const recording=state.mode==='record',cycle=fract(time/5),collapse=cycle<.15?0:cycle<.4?(cycle-.15)/.25:cycle<.65?1:cycle<.9?1-(cycle-.65)/.25:0,clock=mod(time,6),total=clamp(Math.floor(clock/.45)+1,0,10),cell=(w-16)/2;\n    for(let group=0;group<2;group++) {\n      const origin=5+group*(cell+6),count=recording?clamp(total-group*5,0,5):5,values=cohorts[group].slice(0,count),stats=summary(values),x=value=>origin+value*cell;\n      line([[origin,39],[origin+cell,39]],.19);\n      for(let index=0;index<values.length;index++) {\n        const y=22+sampleOffsets[index]*(recording?1:1-collapse),current=recording&&index===count-1&&total<=group*5+5;\n        marker(x(values[index]),y,recording?.9:1-collapse,current?accent():white,2);\n        if(current)line([[x(values[index]),y-4],[x(values[index]),y-2]],.6,accent());\n      }\n      if(stats) {\n        const opacity=recording?.85:collapse;\n        line([[x(stats.min),18],[x(stats.min),26]],opacity);line([[x(stats.max),18],[x(stats.max),26]],opacity);line([[x(stats.min),22],[x(stats.max),22]],opacity*.7);\n        line([[x(stats.median),16],[x(stats.median),28]],opacity,accent());\n      }\n    }\n  }\n  const renderers={ricochet,identity,critical,deferred,range};\n  function draw() { ctx.clearRect(0,0,w,44);ctx.save();ctx.beginPath();ctx.rect(0,0,w,44);ctx.clip();renderers[state.style](t);ctx.restore(); }\n  function sync() {\n    root.querySelectorAll('[data-style]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.style===state.style)));\n    root.querySelectorAll('[data-mode]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.mode===state.mode)));\n    const description=descriptions[state.style][state.mode==='record'?1:0];caption.textContent=description;canvas.setAttribute('aria-label',names[state.style]+': '+description);\n    root.querySelector('[data-record]').hidden=state.mode!=='record';pause.textContent=state.paused?'Devam et':'Duraklat';pause.setAttribute('aria-pressed',String(state.paused));draw();schedule();\n  }\n  function resize() { w=Math.max(1,canvas.getBoundingClientRect().width);dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(w*dpr);canvas.height=44*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);draw(); }\n  function schedule() { if(!raf&&!state.paused&&visible&&!document.hidden&&root.isConnected) { last=0;raf=requestAnimationFrame(frame); } }\n  function frame(now) { raf=0;if(state.paused||!visible||document.hidden||!root.isConnected)return;if(!last)last=now;const elapsed=now-last;if(elapsed>=1000/30){t+=Math.min(elapsed/1000,.07);last=now;draw();}raf=requestAnimationFrame(frame); }\n  root.querySelectorAll('[data-style]').forEach(el=>el.addEventListener('click',()=>{state.style=el.dataset.style;sync();}));\n  root.querySelectorAll('[data-mode]').forEach(el=>el.addEventListener('click',()=>{state.mode=el.dataset.mode;sync();}));\n  pause.addEventListener('click',()=>{state.paused=!state.paused;sync();});\n  reduced.addEventListener('change',()=>{state.paused=reduced.matches;sync();});\n  document.addEventListener('visibilitychange',schedule);\n  new ResizeObserver(resize).observe(canvas);\n  new IntersectionObserver(entries=>{\n    const latest=entries.filter(entry=>entry.target===root).reduce((a,b)=>!a||b.time>=a.time?b:a,null);\n    if(latest){visible=latest.isIntersecting;schedule();}\n  }).observe(root);\n  resize();sync();\n  if(globalThis.Tweak){const tweak=new Tweak({container:root.querySelector('.ie-phone'),onChange:sync});tweak.addToggle(state,'accent',{label:'Kehribar vurgu'});}\n})();\n</script>\n","css":":root{color-scheme:dark;--background:#000;--foreground:#eee;--muted-foreground:#999}*{box-sizing:border-box}body{margin:0;padding:24px;background:#000;color:#eee;font:16px/1.5 Arial,Helvetica,sans-serif}button{font:inherit;cursor:pointer}.viz-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:24px}.btn{color:#bbb;background:#141414;border:1px solid #333;border-radius:6px;min-height:44px;padding:9px 14px;text-align:left}.btn[aria-pressed=true]{color:#fff;border-color:#ddd;background:#262626}.btn-block{width:100%}.text-small{font-size:14px}.text-muted{color:#999}:focus-visible{outline:2px solid #fff;outline-offset:3px}[hidden]{display:none!important}h3{font-size:18px;font-weight:500}figcaption{font-size:16px}canvas{max-width:100%}@media(max-width:520px){body{padding:16px}}"}