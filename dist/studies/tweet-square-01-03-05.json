{"html":"<div id=\"tweet-square-010305\">\n  <div class=\"viz-controls\">\n    <button class=\"btn\" type=\"button\" data-pause aria-pressed=\"false\">Duraklat</button>\n    <span class=\"text-small\" data-status role=\"status\" aria-live=\"polite\">10 saniye · 1:1 · sessiz</span>\n  </div>\n  <div class=\"tweet-frame\">\n    <canvas width=\"1080\" height=\"1080\" role=\"img\" aria-label=\"Yazısız siyah bir kare içinde, yukarıdan aşağı Slice Loupe, Delay Vernier ve Splice Loom. Birlikte tekrar eden 10 saniyelik animasyon.\"></canvas>\n  </div>\n</div>\n<style>\n#tweet-square-010305 .tweet-frame{width:100%;max-width:540px;aspect-ratio:1;margin:16px auto 0;background:#000;overflow:hidden}\n#tweet-square-010305 canvas{display:block;width:100%;height:auto;aspect-ratio:1}\n</style>\n<script>\n(()=>{\n'use strict';\nconst root=document.getElementById('tweet-square-010305');\nconst canvas=root.querySelector('canvas'),ctx=canvas.getContext('2d');\nconst button=root.querySelector('[data-pause]'),status=root.querySelector('[data-status]');\nconst reduced=matchMedia('(prefers-reduced-motion: reduce)');\nconst duration=10,tau=Math.PI*2,white='#FFFFFF',red='#FF0000';\nconst clamp=(x,a=0,b=1)=>Math.min(b,Math.max(a,x)),fract=x=>x-Math.floor(x),mod=(x,n)=>(x%n+n)%n;\nconst hash=n=>fract(Math.sin(n*127.1+43.7)*43758.5453);\nconst grayAlpha=a=>a<=0?0:[.16,.32,.56,1].reduce((best,v)=>Math.abs(v-a)<Math.abs(best-a)?v:best);\nlet time=.7,paused=reduced.matches,visible=true,last=0,raf=0;\nfunction ink(alpha=1,color=white){\n ctx.globalAlpha=color===white?grayAlpha(alpha):clamp(alpha);\n ctx.fillStyle=color;ctx.strokeStyle=color;\n}\nfunction rect(x,y,w,h,alpha=1,color=white){\n ink(alpha,color);ctx.fillRect(Math.round(x*2)/2,Math.round(y*2)/2,w,h);\n}\nfunction line(points,alpha=1,color=white){\n ink(alpha,color);ctx.lineWidth=1;ctx.lineCap='butt';ctx.lineJoin='miter';\n ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(...p):ctx.moveTo(...p));ctx.stroke();\n}\nfunction box(x,y,w,h,alpha=1,color=white){line([[x,y],[x+w,y],[x+w,y+h],[x,y+h],[x,y]],alpha,color);}\n\n// Original Slice Loupe geometry and white peaks. The bounded scan travels\n// out and back, so neither the overview window nor the magnification jumps.\nfunction loupe(phase){\n const w=412,width=.24,writer=.5-.5*Math.cos(phase*tau),start=writer*(1-width);\n const end=start+width,span=w-16,overview=u=>8+u*span,detail=u=>8+(u-start)/width*span;\n const left=overview(start),right=overview(end);\n line([[8,16],[w-8,16]],.32);line([[8,38],[w-8,38]],.24);\n line([[8,28],[left,33]],.16);line([[w-8,28],[right,33]],.16);\n box(left,33,right-left,10,.7,red);\n for(let i=0;i<17;i++){\n  const position=(i+.35+hash(i)*.25)/17,amplitude=.35+hash(i*5)*.65;\n  const selected=position>=start&&position<=end;\n  line([[overview(position),38-amplitude*2],[overview(position),38+amplitude*2]],selected?1:.4,selected?red:white);\n  // Draw the complete signal, clipped into the lens. Peaks can leave through\n  // its edge without their entire silhouette popping away at the boundary.\n  const x=detail(position),markWidth=Math.min(12,.018/width*span);\n  ctx.save();ctx.beginPath();ctx.rect(8,4,span,24);ctx.clip();\n  line([[x-markWidth,16],[x,16-amplitude*9],[x+markWidth*.4,16+amplitude*7],[x+markWidth,16]],1);\n  ctx.restore();\n }\n line([[8,6],[8,26]],.32);line([[w-8,6],[w-8,26]],.32);\n}\n\n// Same two vernier rulers, with one sinusoidal offset cycle in ten seconds.\nfunction vernier(phase){\n const w=400,center=w/2,pitch=8,lowerPitch=9,shift=Math.sin(phase*tau)*18;\n line([[2,17],[w-2,17]],.3);line([[2,27],[w-2,27]],.3);\n for(let i=-Math.ceil(w/pitch);i<=Math.ceil(w/pitch);i++){\n  const x=center+i*pitch;if(x<2||x>w-2)continue;\n  const major=mod(i,5)===0,near=Math.abs(mod(x-center-shift+lowerPitch/2,lowerPitch)-lowerPitch/2)<1;\n  rect(x,major?5:10,1,major?12:7,near?.95:.45,near?red:white);\n }\n for(let i=-Math.ceil(w/lowerPitch);i<=Math.ceil(w/lowerPitch);i++){\n  const x=center+i*lowerPitch+shift;if(x<2||x>w-2)continue;\n  const major=mod(i,5)===0,near=Math.abs(mod(x-center+pitch/2,pitch)-pitch/2)<1;\n  rect(x,27,1,major?12:7,near?.95:.45,near?red:white);\n }\n line([[center-13,3],[center-13,1],[center+13,1],[center+13,3]],.65);\n line([[center-13,41],[center-13,43],[center+13,43],[center+13,41]],.65);\n const error=clamp(shift/18,-1,1)*11;\n line([[center,22],[center+error,22]],.95,red);\n rect(center+error-1.5,20.5,3,3,1,red);\n}\n\n// Four distinct segments per lane repeat spatially. Moving four pitches in\n// ten seconds returns to the identical pattern at 9.6px/s (gallery: 10px/s).\nfunction loom(phase){\n const w=396,middle=w*.52,ys=[10,22,34],travel=phase*96;\n for(let lane=0;lane<3;lane++){\n  const y=ys[lane],next=ys[(lane+1)%3];\n  line([[0,y],[middle-10,y],[middle+10,next],[w,next]],.16);\n  for(let j=-1;j<Math.ceil(w/24)+6;j++){\n   const raw=j*24-travel-lane*8,len=7+hash(mod(j,4)+lane*9)*11;\n   const mapY=x=>x<middle-10?y:x>middle+10?next:y+(next-y)*(x-(middle-10))/20;\n   const points=[];\n   for(let k=0;k<=6;k++){const x=raw+k/6*len;points.push([x,mapY(x)]);}\n   const live=raw<middle&&raw+len>middle;\n   line(points,live?1:.75,live?red:white);\n   line([[raw,mapY(raw)-2],[raw,mapY(raw)+2]],.45);\n  }\n }\n line([[middle-6,2],[middle+6,2]],.6,red);\n line([[middle-6,42],[middle+6,42]],.6,red);\n}\n\nfunction row(draw,x,y,width,phase){\n ctx.save();ctx.translate(x,y);ctx.beginPath();ctx.rect(0,0,width,44);ctx.clip();draw(phase);ctx.restore();\n}\nfunction paint(seconds=time){\n const phase=mod(seconds,duration)/duration;\n ctx.setTransform(2,0,0,2,0,0);ctx.globalAlpha=1;ctx.fillStyle='#000';ctx.fillRect(0,0,540,540);\n // Equal 132px center spacing; all three share the same optical width.\n row(loupe,64,116,412,phase);\n row(vernier,70,248,400,phase);\n row(loom,72,380,396,phase);\n ctx.globalAlpha=1;\n}\nfunction sync(){\n button.textContent=paused?'Oynat':'Duraklat';\n button.setAttribute('aria-pressed',String(paused));\n status.textContent=paused?'Duraklatıldı · 10 saniye · 1:1':'10 saniye · 1:1 · sessiz';\n}\nfunction schedule(){\n if(!raf&&!paused&&visible&&!document.hidden&&root.isConnected){last=0;raf=requestAnimationFrame(frame);}\n}\nfunction frame(now){\n raf=0;if(paused||!visible||document.hidden||!root.isConnected)return;\n if(last)time=mod(time+Math.min((now-last)/1000,.1),duration);\n last=now;paint();raf=requestAnimationFrame(frame);\n}\nbutton.addEventListener('click',()=>{paused=!paused;sync();schedule();});\nreduced.addEventListener('change',e=>{paused=e.matches;sync();schedule();});\ndocument.addEventListener('visibilitychange',()=>{last=0;schedule();});\nnew IntersectionObserver(entries=>{visible=entries[entries.length-1].isIntersecting;last=0;schedule();}).observe(root);\n// Deterministic frame access for checking the seam and a later approved export.\nroot.tweetPreview={\n duration,width:1080,height:1080,\n renderAt(seconds){paused=true;time=mod(seconds,duration);paint();sync();},\n play(){paused=false;sync();schedule();},\n pause(){paused=true;sync();}\n};\nsync();paint();schedule();\n})();\n</script>\n","css":":root{color-scheme:dark;--background:#000;--foreground:#eee;--muted-foreground:#999}*{box-sizing:border-box}body{margin:0;padding:24px;background:#000;color:#eee;font:16px/1.5 Arial,Helvetica,sans-serif}button{font:inherit;cursor:pointer}.viz-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:24px}.btn{color:#bbb;background:#141414;border:1px solid #333;border-radius:6px;min-height:44px;padding:9px 14px;text-align:left}.btn[aria-pressed=true]{color:#fff;border-color:#ddd;background:#262626}.btn-block{width:100%}.text-small{font-size:14px}.text-muted{color:#999}:focus-visible{outline:2px solid #fff;outline-offset:3px}[hidden]{display:none!important}h3{font-size:18px;font-weight:500}figcaption{font-size:16px}canvas{max-width:100%}@media(max-width:520px){body{padding:16px}}"}