{"html":"<div id=\"iwr-night-plotter\" aria-label=\"Set 05: Plotter Logic, beş hareketli ses ekranı\">\n  <div class=\"viz-controls\">\n    <button type=\"button\" class=\"btn\" data-mode=\"play\" aria-pressed=\"true\">Çalma</button>\n    <button type=\"button\" class=\"btn\" data-mode=\"record\" aria-pressed=\"false\">Kayıt</button>\n    <button type=\"button\" class=\"btn btn-ghost\" data-pause aria-pressed=\"false\">Duraklat</button>\n    <span class=\"text-small text-muted\">Örnek ses ritmi · sessiz demo</span>\n  </div>\n  <div class=\"nl-layout\">\n    <div class=\"nl-stage\">\n      <div class=\"nl-phone\" aria-label=\"iwrzwr: Plotter Logic önizlemesi\">\n        <div class=\"nl-header\">\n          <div class=\"nl-status\" aria-hidden=\"true\"><span>9:41</span><span data-record hidden>REC</span><span>••• &nbsp; ▰</span></div>\n          <div class=\"nl-controls\">\n            <div class=\"nl-circle\" aria-hidden=\"true\"></div>\n            <canvas role=\"img\" aria-label=\"Broken Grid: bir ızgaranın silinen parçaları sesi görünür kılıyor\"></canvas>\n            <div class=\"nl-circle\" aria-hidden=\"true\"><i data-lucide=\"plus\"></i></div>\n          </div>\n        </div>\n        <div class=\"nl-pads\" aria-hidden=\"true\"><div><i data-lucide=\"mic\"></i></div><div><i data-lucide=\"mic\"></i></div></div>\n      </div>\n      <div class=\"text-small text-muted nl-spec\">126px header · 44px alan · 24px boşluk</div>\n    </div>\n    <div class=\"nl-options\" role=\"group\" aria-label=\"Plotter Logic seçenekleri\">\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"broken\" aria-pressed=\"true\">1 · Broken Grid</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"weave\" aria-pressed=\"false\">2 · Step Weave</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"courier\" aria-pressed=\"false\">3 · Cell Courier</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"factors\" aria-pressed=\"false\">4 · Factor Constellation</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"fragments\" aria-pressed=\"false\">5 · Gesture Fragments</button>\n    </div>\n  </div>\n  <div class=\"nl-caption\" data-description aria-live=\"polite\">Ses eklenerek değil, ızgaradan parçalar eksiltilerek çiziliyor.</div>\n</div>\n<style>\n  #iwr-night-plotter .nl-layout { display:grid; grid-template-columns:minmax(0,402px) minmax(190px,1fr); gap:24px; align-items:center; margin-top:20px; }\n  #iwr-night-plotter .nl-stage { min-width:0; }\n  #iwr-night-plotter .nl-options { display:grid; gap:8px; }\n  #iwr-night-plotter .nl-phone { --nl-screen:#000; --nl-pad:#cdcdcd; --nl-divider:#b6b6b6; --nl-ink:#f1f0e8; color:var(--nl-ink); background:var(--nl-pad); border-radius:30px; overflow:hidden; font-family:-apple-system,BlinkMacSystemFont,sans-serif; }\n  #iwr-night-plotter .nl-header { height:126px; position:relative; background:var(--nl-screen); border-radius:0 0 32px 40px; }\n  #iwr-night-plotter .nl-status { position:absolute; top:24px; left:28px; right:28px; display:flex; align-items:center; justify-content:space-between; font-size:13px; font-weight:500; }\n  #iwr-night-plotter [data-record] { color:#FF0000; font-family:ui-monospace,monospace; font-size:11px; }\n  #iwr-night-plotter [hidden] { display:none; }\n  #iwr-night-plotter .nl-controls { position:absolute; top:62px; left:20px; right:20px; display:flex; align-items:center; gap:24px; height:44px; }\n  #iwr-night-plotter .nl-circle { width:44px; height:44px; flex:none; display:grid; place-items:center; border-radius:50%; background:#141414; box-shadow:inset 0 0 0 1px #303030; }\n  #iwr-night-plotter .nl-circle svg { width:20px; height:20px; stroke-width:1.5; }\n  #iwr-night-plotter canvas { display:block; height:44px; width:100%; flex:1; min-width:0; }\n  #iwr-night-plotter .nl-pads { display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--nl-divider); }\n  #iwr-night-plotter .nl-pads>div { display:grid; place-items:center; height:120px; background:var(--nl-pad); color:#929292; }\n  #iwr-night-plotter .nl-pads svg { width:18px; height:18px; }\n  #iwr-night-plotter .nl-spec { margin-top:10px; }\n  #iwr-night-plotter .nl-caption { margin-top:16px; min-height:44px; }\n  @media(max-width:630px) { #iwr-night-plotter .nl-layout { grid-template-columns:minmax(0,1fr); gap:18px; } #iwr-night-plotter .nl-stage { width:100%; max-width:402px; margin:auto; } }\n</style>\n<script>\n(() => {\n  const root=document.getElementById('iwr-night-plotter');\n  const canvas=root.querySelector('canvas'),ctx=canvas.getContext('2d');\n  const pause=root.querySelector('[data-pause]'),caption=root.querySelector('[data-description]');\n  const reduced=matchMedia('(prefers-reduced-motion: reduce)');\n  const state={style:'broken',mode:'play',paused:reduced.matches,accent:true,gain:.82};\n  const names={broken:'Broken Grid',weave:'Step Weave',courier:'Cell Courier',factors:'Factor Constellation',fragments:'Gesture Fragments'};\n  const descriptions={\n    broken:['Ses eklenerek değil, ızgaradan parçalar eksiltilerek çiziliyor.','Yeni kesikler tarama kafasının arkasında kalıyor; ızgara bir negatif kayda dönüşüyor.'],\n    weave:['Köşeli çizgiler birer hücre kayarak kısa süreli desenler örüyor.','Her darbe bir sıraya yeni bir basamak ekliyor; önceki sıralar tutuluyor.'],\n    courier:['Beş hücrelik kuryeler, boş bir kafeste mesaj taşıyor.','Kayıt kafası küçük hücre kümeleri bırakıyor; son mesaj kısa süre yerinde kalıyor.'],\n    factors:['Küçük sayı kümeleri, ritimle farklı çarpan gruplarına ayrılıyor.','Her darbe bir kümeyi yeniden kuruyor; diğer iki küme son düzenini saklıyor.'],\n    fragments:['Ayrı çizgi parçalarını sırayla izleyen küçük bir çizim kafası.','Her hece bir çizik ekliyor; bağımsız izler kısa bir notasyona dönüşüyor.']\n  };\n  const white='#f1f0e8',amber='#FF0000';\n  let w=226,dpr=1,t=2.4,last=0,raf=0,visible=true;\n  const clamp=(x,a=0,b=1)=>Math.min(b,Math.max(a,x));\n  const mod=(x,n)=>(x%n+n)%n;\n  const fract=x=>x-Math.floor(x);\n  const hash=n=>fract(Math.sin(n*127.1+43.7)*43758.5453);\n  const accent=()=>state.accent?amber:white;\n  // Synthetic numbers and rhythm. No signal classification, pitch, or cellular-automata accuracy claim.\n  function env(time) { return clamp((.15+.55*Math.pow(Math.max(0,Math.sin(time*2.7)),6)+.28*Math.pow(Math.max(0,Math.sin(time*6.1+1)),12))*state.gain); }\n  function ink(alpha=1,color=white) { ctx.globalAlpha=clamp(alpha);ctx.fillStyle=color;ctx.strokeStyle=color; }\n  function rect(x,y,width,height,alpha=1,color=white) { ink(alpha,color);ctx.fillRect(Math.round(x*dpr)/dpr,Math.round(y*dpr)/dpr,width,height); }\n  function line(points,alpha=1,color=white) { if(!points.length)return;ink(alpha,color);ctx.lineWidth=1;ctx.lineCap='butt';ctx.lineJoin='miter';ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(...p):ctx.moveTo(...p));ctx.stroke(); }\n  function box(x,y,width,height,alpha=1,color=white) { line([[x,y],[x+width,y],[x+width,y+height],[x,y+height],[x,y]],alpha,color); }\n  function broken(time) {\n    const pitch=9,n=Math.floor((w-6)/pitch),left=(w-n*pitch)/2,head=mod(time*.19,1),recording=state.mode==='record';\n    for(let row=0;row<5;row++)line([[left,4+row*9],[w-left,4+row*9]],.45);\n    for(let col=0;col<=n;col++)line([[left+col*pitch,4],[left+col*pitch,40]],.24);\n    for(let col=0;col<n;col++) {\n      const u=col/n,sample=recording?Math.floor(time*.19)*5+u*5:u*5;\n      const a=env(sample),rows=Math.round(a*3.6),height=rows*9+4;\n      if(!recording||u<head) {\n        ctx.clearRect(left+col*pitch+1,22-height/2,pitch-2,height);\n        if(rows>1)ctx.clearRect(left+col*pitch-1,22-(rows-1)*4.5,2,(rows-1)*9);\n      }\n    }\n    const x=left+head*n*pitch;\n    line([[x,1],[x,5]],1,accent());line([[x,39],[x,43]],1,accent());\n    if(recording)line([[x,6],[x,38]],.65,accent());\n  }\n  function weave(time) {\n    const pitch=12,step=Math.floor(time*3),phase=fract(time*3),recording=state.mode==='record',head=mod(step,4);\n    for(let row=0;row<4;row++) {\n      const shift=recording?mod(Math.floor((step-row+4)/4),2)*pitch/2:mod(step+row,4)*pitch/4;\n      const baseline=7+row*10,points=[];\n      for(let col=-2;col<w/pitch+2;col++) {\n        const x=col*pitch+shift;\n        if(recording&&row===head&&x>w*phase)break;\n        points.push([x,baseline],[x+pitch/2,baseline],[x+pitch/2,baseline+5],[x+pitch,baseline+5]);\n      }\n      line(points,row===head?.95:.5,row===head?accent():white);\n    }\n  }\n  function courier(time) {\n    const pitch=4,cols=Math.floor((w-4)/pitch),left=(w-cols*pitch)/2,step=Math.floor(time*5),recording=state.mode==='record';\n    for(let x=0;x<cols;x+=3)for(let y=0;y<9;y+=2)rect(left+x*pitch,5+y*pitch,1,1,.14);\n    // Four deliberately hand-authored five-cell states: a courier, not a full Game of Life engine.\n    const forms=[[[1,0],[2,1],[0,2],[1,2],[2,2]],[[0,0],[2,0],[1,1],[2,1],[1,2]],[[0,0],[1,0],[2,0],[0,1],[1,2]],[[1,0],[0,1],[1,1],[0,2],[2,2]]];\n    if(recording) {\n      const positions=Math.max(2,Math.floor(cols/7)),write=mod(Math.floor(step/2),positions);\n      for(let p=0;p<=write;p++) {\n        const age=write-p,shape=forms[mod(p+Math.floor(step/(positions*2)),4)],x=left+(p*7+2)*pitch;\n        shape.forEach(([cx,cy])=>rect(x+cx*pitch,16+cy*pitch,2,2,p===write?1:.38,p===write?accent():white));\n      }\n      rect(left+(write*7+2)*pitch,8,10,1,1,accent());\n    } else {\n      for(let k=0;k<3;k++) {\n        const x=mod(step+k*Math.floor(cols/3),cols-3),y=[1,3,5][k],shape=forms[mod(step+k,4)];\n        shape.forEach(([cx,cy])=>rect(left+(x+cx)*pitch,5+(y+cy)*pitch,2,2,.85,k===0?accent():white));\n      }\n    }\n  }\n  function factors(time) {\n    const groups=3,pitch=w/groups,step=Math.floor(time*1.6),active=mod(step,3),pairs=[[2,3],[2,4],[3,3],[3,4],[3,5],[2,6]],recording=state.mode==='record';\n    for(let g=0;g<groups;g++) {\n      const tick=recording?step-mod(step-g,3):step+g*2;\n      const [a,b]=pairs[mod(tick,pairs.length)],cx=pitch*(g+.5),r=11,spin=recording?0:time*.22;\n      for(let i=0;i<a;i++) {\n        const theta=i/a*Math.PI*2-Math.PI/2+spin;\n        const x=cx+Math.cos(theta)*r,y=22+Math.sin(theta)*r;\n        for(let j=0;j<b;j++) {\n          const phi=j/b*Math.PI*2-Math.PI/2;\n          const px=x+Math.cos(phi)*4.5,py=y+Math.sin(phi)*4.5;\n          rect(px-1,py-1,2,2,g===active?.95:.65,g===active&&i===0?accent():white);\n        }\n      }\n      const total=a*b;\n      for(let mark=0;mark<total;mark++)rect(cx-total+mark*2,42,1,1,.25,g===active?accent():white);\n      if(recording&&g===active)line([[cx-4,1],[cx+4,1]],1,accent());\n    }\n  }\n  function fragments(time) {\n    const count=7,pitch=(w-8)/count,recording=state.mode==='record',phase=mod(time*.85,count+1),active=Math.min(count-1,Math.floor(phase));\n    for(let i=0;i<count;i++) {\n      const x=4+i*pitch,seed=i+3,y=10+hash(seed)*22;\n      const points=[[x,y],[x+pitch*.25,clamp(y+8*(hash(seed+5)-.5),4,40)],[x+pitch*.58,clamp(y+16*(hash(seed+12)-.5),4,40)],[x+pitch*.83,clamp(y+18*(hash(seed+3)-.5),4,40)]];\n      if(recording&&i>active)continue;\n      const progress=i===active?fract(phase):1;\n      if(!recording||i<active)line(points,.35);\n      if(i===active) {\n        const segment=Math.min(2,Math.floor(progress*3)),local=fract(progress*3),from=points[segment],to=points[segment+1];\n        const tip=[from[0]+(to[0]-from[0])*local,from[1]+(to[1]-from[1])*local];\n        line([...points.slice(0,segment+1),tip],1,accent());\n        rect(tip[0]-1,tip[1]-1,3,3,1,accent());\n      } else if(recording)line(points,.68);\n      if(recording&&i<active)rect(x+pitch*.4,40,2,1,.5);\n    }\n  }\n  const renderers={broken,weave,courier,factors,fragments};\n  function draw() { ctx.clearRect(0,0,w,44);ctx.save();ctx.beginPath();ctx.rect(0,0,w,44);ctx.clip();renderers[state.style](t);ctx.restore(); }\n  function sync() {\n    root.querySelectorAll('[data-style]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.style===state.style)));\n    root.querySelectorAll('[data-mode]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.mode===state.mode)));\n    const description=descriptions[state.style][state.mode==='record'?1:0];caption.textContent=description;canvas.setAttribute('aria-label',names[state.style]+': '+description);\n    root.querySelector('[data-record]').hidden=state.mode!=='record';pause.textContent=state.paused?'Devam et':'Duraklat';pause.setAttribute('aria-pressed',String(state.paused));draw();schedule();\n  }\n  function resize() { w=Math.max(1,canvas.getBoundingClientRect().width);dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(w*dpr);canvas.height=44*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);draw(); }\n  function schedule() { if(!raf&&!state.paused&&visible&&!document.hidden&&root.isConnected) { last=0;raf=requestAnimationFrame(frame); } }\n  function frame(now) { raf=0;if(state.paused||!visible||document.hidden||!root.isConnected)return;if(!last)last=now;const elapsed=now-last;if(elapsed>=1000/30){t+=Math.min(elapsed/1000,.07);last=now;draw();}raf=requestAnimationFrame(frame); }\n  root.querySelectorAll('[data-style]').forEach(el=>el.addEventListener('click',()=>{state.style=el.dataset.style;sync();}));\n  root.querySelectorAll('[data-mode]').forEach(el=>el.addEventListener('click',()=>{state.mode=el.dataset.mode;sync();}));\n  pause.addEventListener('click',()=>{state.paused=!state.paused;sync();});\n  reduced.addEventListener('change',()=>{state.paused=reduced.matches;sync();});\n  document.addEventListener('visibilitychange',schedule);\n  new ResizeObserver(resize).observe(canvas);\n  new IntersectionObserver(entries=>{const latest=entries.reduce((a,b)=>b.target===root&&(!a||b.time>=a.time)?b:a,null);if(latest){visible=latest.isIntersecting;schedule();}}).observe(root);\n  resize();sync();\n  if(globalThis.Tweak){const tweak=new Tweak({container:root.querySelector('.nl-phone'),onChange:sync});tweak.addToggle(state,'accent',{label:'Kehribar vurgu'});tweak.addSlider(state,'gain',{label:'Tepki yoğunluğu',min:.3,max:1.2,step:.1});}\n})();\n</script>\n","css":":root{color-scheme:dark;--background:#000;--foreground:#eee;--muted-foreground:#999}*{box-sizing:border-box}body{margin:0;padding:24px;background:#000;color:#eee;font:16px/1.5 Arial,Helvetica,sans-serif}button{font:inherit;cursor:pointer}.viz-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:24px}.btn{color:#bbb;background:#141414;border:1px solid #333;border-radius:6px;min-height:44px;padding:9px 14px;text-align:left}.btn[aria-pressed=true]{color:#fff;border-color:#ddd;background:#262626}.btn-block{width:100%}.text-small{font-size:14px}.text-muted{color:#999}:focus-visible{outline:2px solid #fff;outline-offset:3px}[hidden]{display:none!important}h3{font-size:18px;font-weight:500}figcaption{font-size:16px}canvas{max-width:100%}@media(max-width:520px){body{padding:16px}}"}