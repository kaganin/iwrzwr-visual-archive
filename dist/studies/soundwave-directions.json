{"html":"<div id=\"iwr-wave-directions\" aria-label=\"Beş soundwave animasyonu karşılaştırması\">\n  <div class=\"viz-controls\">\n    <button type=\"button\" class=\"btn\" data-phase=\"playback\" aria-pressed=\"true\">Çalma</button>\n    <button type=\"button\" class=\"btn\" data-phase=\"recording\" aria-pressed=\"false\">Kayıt</button>\n    <button type=\"button\" class=\"btn btn-ghost\" data-pause aria-pressed=\"false\">Duraklat</button>\n    <span class=\"text-small text-muted\">Örnek ses ritmi · sessiz demo</span>\n  </div>\n  <div class=\"iwr-comparison\">\n    <div class=\"iwr-preview-wrap\">\n      <div class=\"iwr-phone\" aria-label=\"iwrzwr üst alan önizlemesi\">\n        <div class=\"iwr-header\">\n          <div class=\"iwr-status\" aria-hidden=\"true\"><span>9:41</span><span>••• &nbsp; ▰</span></div>\n          <div class=\"iwr-controls\">\n            <div class=\"iwr-circle\" aria-hidden=\"true\"></div>\n            <div class=\"iwr-activity\">\n              <div class=\"iwr-rec\" hidden><span class=\"iwr-dot\"></span><span data-time>00:00</span></div>\n              <canvas class=\"iwr-wave\" role=\"img\" aria-label=\"Spectrum Ribbon: renkli, üst üste akan dalgalar\"></canvas>\n            </div>\n            <div class=\"iwr-circle\" aria-hidden=\"true\"></div>\n          </div>\n        </div>\n        <div class=\"iwr-pads\" aria-hidden=\"true\"><div><i data-lucide=\"mic\"></i></div><div><i data-lucide=\"mic\"></i></div></div>\n      </div>\n      <div class=\"text-small text-muted iwr-dimensions\">126px header · 44px dalga alanı · 24px boşluk</div>\n    </div>\n    <div class=\"iwr-options\" role=\"group\" aria-label=\"Animasyon seçenekleri\">\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"ribbon\" aria-pressed=\"true\">1 · Spectrum Ribbon</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"mono\" aria-pressed=\"false\">2 · Mono Wave</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"silk\" aria-pressed=\"false\">3 · Silk Layers</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"liquid\" aria-pressed=\"false\">4 · Liquid Wave</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"spectrum\" aria-pressed=\"false\">5 · Fine Spectrum</button>\n    </div>\n  </div>\n  <div class=\"iwr-caption\" aria-live=\"polite\"><span data-caption>Renkli, yarı saydam dalgalar; akışkan, canlı bir his.</span></div>\n</div>\n<style>\n  #iwr-wave-directions .iwr-comparison { display:grid; grid-template-columns:minmax(0,402px) minmax(150px,1fr); gap:24px; align-items:center; margin-top:20px; }\n  #iwr-wave-directions .iwr-options { display:grid; gap:8px; }\n  #iwr-wave-directions .iwr-preview-wrap { min-width:0; }\n  #iwr-wave-directions .iwr-phone { background:#cdcdcd; border-radius:30px; overflow:hidden; width:100%; color:#fff; font-family:-apple-system,BlinkMacSystemFont,sans-serif; }\n  #iwr-wave-directions .iwr-header { position:relative; height:126px; background:#000; border-radius:0 0 32px 40px; }\n  #iwr-wave-directions .iwr-status { position:absolute; top:24px; left:28px; right:28px; display:flex; justify-content:space-between; font-size:13px; font-weight:500; line-height:16px; }\n  #iwr-wave-directions .iwr-controls { position:absolute; top:62px; left:20px; right:20px; display:flex; gap:24px; align-items:center; height:44px; }\n  #iwr-wave-directions .iwr-circle { width:44px; height:44px; border-radius:50%; background:#141414; box-shadow:inset 0 0 0 1px #303030; flex:none; }\n  #iwr-wave-directions .iwr-activity { min-width:0; flex:1; display:flex; align-items:center; gap:8px; height:44px; }\n  #iwr-wave-directions .iwr-wave { display:block; min-width:0; width:100%; height:44px; flex:1; }\n  #iwr-wave-directions .iwr-rec { flex:none; display:flex; align-items:center; gap:6px; width:60px; color:#fff; font-family:ui-monospace,monospace; font-size:11px; line-height:14px; font-variant-numeric:tabular-nums; }\n  #iwr-wave-directions .iwr-rec[hidden] { display:none; }\n  #iwr-wave-directions .iwr-dot { width:6px; height:6px; border-radius:50%; background:#ff413a; flex:none; }\n  #iwr-wave-directions .iwr-pads { display:grid; grid-template-columns:1fr 1fr; gap:1px; background:#b4b4b4; }\n  #iwr-wave-directions .iwr-pads>div { height:120px; display:grid; place-items:center; color:#909090; background:#cdcdcd; }\n  #iwr-wave-directions .iwr-pads svg { width:18px; height:18px; }\n  #iwr-wave-directions .iwr-dimensions { margin-top:10px; }\n  #iwr-wave-directions .iwr-caption { margin-top:18px; min-height:24px; }\n  @media(max-width:610px) { #iwr-wave-directions .iwr-comparison { grid-template-columns:minmax(0,1fr); gap:18px; } #iwr-wave-directions .iwr-preview-wrap { width:100%; max-width:402px; margin:auto; } #iwr-wave-directions .iwr-options { grid-template-columns:repeat(2,minmax(0,1fr)); } }\n</style>\n<script>\n(() => {\n  const root = document.getElementById('iwr-wave-directions');\n  const canvas = root.querySelector('canvas');\n  const ctx = canvas.getContext('2d');\n  const badge = root.querySelector('.iwr-rec');\n  const timer = root.querySelector('[data-time]');\n  const caption = root.querySelector('[data-caption]');\n  const pauseButton = root.querySelector('[data-pause]');\n  const reduced = matchMedia('(prefers-reduced-motion: reduce)');\n  const state = { style:'ribbon', phase:'playback', paused:false, monochrome:false, intensity:0.75 };\n  const descriptions = {\n    ribbon:'Renkli, yarı saydam dalgalar; akışkan, canlı bir his.',\n    mono:'1px beyaz ana dalga ve hafif izleri; sade, yumuşak ve merkezde.',\n    silk:'İnce paralel katmanlar; sesle birlikte açılan ipeksi çizgiler.',\n    liquid:'Dolu, organik dalga; konuşmayla esneyen tek bir ışık formu.',\n    spectrum:'1px keskin çubuklar; merkeze hizalı, birlikte akan frekans hissi.'\n  };\n  const names = {ribbon:'Spectrum Ribbon',mono:'Mono Wave',silk:'Silk Layers',liquid:'Liquid Wave',spectrum:'Fine Spectrum'};\n  let w=226, h=44, elapsed=0, last=0, smoothLevel=0.5, drawTime=0;\n  const palette=['#47cfff','#6f72ff','#cb65ff','#ff789f'];\n  function sync() {\n    root.querySelectorAll('[data-style]').forEach(b => b.setAttribute('aria-pressed',String(b.dataset.style===state.style)));\n    root.querySelectorAll('[data-phase]').forEach(b => b.setAttribute('aria-pressed',String(b.dataset.phase===state.phase)));\n    badge.hidden = state.phase!=='recording';\n    caption.textContent = descriptions[state.style];\n    canvas.setAttribute('aria-label',names[state.style]+': '+descriptions[state.style]);\n    pauseButton.textContent = state.paused?'Devam et':'Duraklat';\n    pauseButton.setAttribute('aria-pressed',String(state.paused));\n    resize();\n  }\n  function resize() {\n    const box=canvas.getBoundingClientRect();\n    w=Math.max(1,box.width); h=44;\n    const dpr=Math.min(devicePixelRatio||1,3);\n    canvas.width=Math.round(w*dpr); canvas.height=Math.round(h*dpr);\n    ctx.setTransform(dpr,0,0,dpr,0,0);\n    draw(drawTime);\n  }\n  root.querySelectorAll('[data-style]').forEach(b=>b.addEventListener('click',()=>{state.style=b.dataset.style;sync();}));\n  root.querySelectorAll('[data-phase]').forEach(b=>b.addEventListener('click',()=>{state.phase=b.dataset.phase;sync();}));\n  pauseButton.addEventListener('click',()=>{state.paused=!state.paused;sync();});\n  function envelope(x) {return Math.pow(Math.sin(Math.PI*Math.max(0,Math.min(1,x))),1.25);}\n  function signal(t) {return 0.13+0.5*Math.pow(Math.sin(t*1.65),4)+0.28*Math.pow(Math.sin(t*3.15+0.7),8);}\n  function wave(x,t,layer) {\n    const drift=state.phase==='recording'?t*2.4:t*1.5;\n    return Math.sin(x*Math.PI*(3.1+layer*0.11)-drift+layer*0.6)*0.72+Math.sin(x*Math.PI*5.3+t*0.9-layer*0.4)*0.28;\n  }\n  function stroke(fn,color,width,alpha=1) {\n    ctx.beginPath();\n    for(let i=0;i<=110;i++){const x=i/110,y=fn(x);if(!i)ctx.moveTo(1+x*(w-2),y);else ctx.lineTo(1+x*(w-2),y);}\n    ctx.strokeStyle=color;ctx.lineWidth=width;ctx.globalAlpha=alpha;ctx.lineCap='butt';ctx.stroke();ctx.globalAlpha=1;\n  }\n  function draw(t) {\n    ctx.clearRect(0,0,w,h);\n    const gain=reduced.matches?0.3+smoothLevel*0.2:smoothLevel;\n    const amp=3+gain*15;\n    const motion=reduced.matches?1.4:t;\n    if(state.style==='ribbon') {\n      ctx.globalCompositeOperation='screen';\n      for(let layer=0;layer<4;layer++) {\n        const color=state.monochrome?'#eeeeee':palette[layer];\n        const mid=x=>22+envelope(x)*amp*wave(x,motion,layer);\n        const thick=x=>envelope(x)*(1.2+gain*2.8)*(0.65+0.35*Math.sin(x*9+motion+layer));\n        ctx.beginPath();\n        for(let i=0;i<=110;i++){let x=i/110,y=mid(x)-thick(x);if(!i)ctx.moveTo(x*w,y);else ctx.lineTo(x*w,y);}\n        for(let i=110;i>=0;i--){let x=i/110;ctx.lineTo(x*w,mid(x)+thick(x));}\n        ctx.closePath();ctx.fillStyle=color;ctx.globalAlpha=0.32;ctx.fill();ctx.globalAlpha=1;\n        stroke(mid,color,0.8,0.78);\n      }\n      ctx.globalCompositeOperation='source-over';\n    } else if(state.style==='mono') {\n      for(let layer=3;layer>=0;layer--)stroke(x=>22+envelope(x)*amp*wave(x,motion-layer*0.09,0)*(1-layer*0.18),'#fff',1,layer===0?0.95:0.26-layer*0.04);\n    } else if(state.style==='silk') {\n      for(let layer=0;layer<8;layer++) {\n        const offset=(layer-3.5)*0.9;\n        stroke(x=>22+envelope(x)*(amp*0.72*wave(x,motion,layer*0.33)+offset*(0.6+gain*1.8)),'#fff',0.65,0.25+0.45*(1-Math.abs(layer-3.5)/4));\n      }\n    } else if(state.style==='liquid') {\n      const thickness=x=>envelope(x)*(3+gain*12)*(0.72+0.2*Math.sin(x*12-motion*1.8)+0.08*Math.sin(x*21+motion));\n      const axis=x=>22+envelope(x)*Math.sin(x*7+motion)*gain*3;\n      ctx.beginPath();\n      for(let i=0;i<=110;i++){let x=i/110,y=axis(x)-thickness(x);if(!i)ctx.moveTo(x*w,y);else ctx.lineTo(x*w,y);}\n      for(let i=110;i>=0;i--){let x=i/110;ctx.lineTo(x*w,axis(x)+thickness(x));}\n      ctx.closePath();\n      const gradient=ctx.createLinearGradient(0,5,w,39);\n      gradient.addColorStop(0,state.monochrome?'#c5c5c5':'#a3deee');gradient.addColorStop(0.45,'#fff');gradient.addColorStop(1,state.monochrome?'#777':'#8c83ae');\n      ctx.fillStyle=gradient;ctx.globalAlpha=0.85;ctx.fill();ctx.globalAlpha=1;\n      stroke(x=>axis(x)-thickness(x),'#fff',0.7,0.85);\n    } else {\n      const count=Math.max(2,Math.floor(w/4));\n      ctx.strokeStyle='#fff';ctx.lineWidth=1;ctx.lineCap='butt';\n      for(let col=0;col<count;col++) {\n        const x=col/(count-1);\n        const sample=state.phase==='recording'?signal(motion-(1-x)*2.4):gain*(0.3+0.7*Math.abs(wave(x,motion,0)));\n        const size=1+Math.min(18,sample*18)*(0.28+0.72*envelope(x));\n        ctx.globalAlpha=0.9;ctx.beginPath();ctx.moveTo(1+x*(w-2),22-size);ctx.lineTo(1+x*(w-2),22+size);ctx.stroke();\n      }\n      ctx.globalAlpha=1;\n    }\n  }\n  function frame(now) {\n    if(!root.isConnected)return;\n    const dt=last?Math.min(0.05,(now-last)/1000):0;last=now;\n    if(!state.paused&&!document.hidden) {\n      elapsed+=dt;\n      const target=signal(elapsed)*state.intensity/0.75;\n      const response=target>smoothLevel?0.08:0.24;\n      smoothLevel+=(target-smoothLevel)*(1-Math.exp(-dt/response));\n      drawTime=elapsed;draw(drawTime);\n      const stamp=Math.floor(elapsed*100)%6000;\n      timer.textContent=String(Math.floor(stamp/100)).padStart(2,'0')+':'+String(stamp%100).padStart(2,'0');\n    }\n    requestAnimationFrame(frame);\n  }\n  new ResizeObserver(resize).observe(canvas);\n  sync(); requestAnimationFrame(frame);\n  if(globalThis.Tweak) {\n    const tweaks=new Tweak({container:root.querySelector('.iwr-phone'),onChange:sync});\n    tweaks.addToggle(state,'monochrome',{label:'Monokrom'});\n    tweaks.addSlider(state,'intensity',{label:'Ses yoğunluğu',min:0.15,max:1,step:0.05});\n  }\n})();\n</script>\n","css":":root{color-scheme:dark;--background:#000;--foreground:#eee;--muted-foreground:#999}*{box-sizing:border-box}body{margin:0;padding:24px;background:#000;color:#eee;font:16px/1.5 Arial,Helvetica,sans-serif}button{font:inherit;cursor:pointer}.viz-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:24px}.btn{color:#bbb;background:#141414;border:1px solid #333;border-radius:6px;min-height:44px;padding:9px 14px;text-align:left}.btn[aria-pressed=true]{color:#fff;border-color:#ddd;background:#262626}.btn-block{width:100%}.text-small{font-size:14px}.text-muted{color:#999}:focus-visible{outline:2px solid #fff;outline-offset:3px}[hidden]{display:none!important}h3{font-size:18px;font-weight:500}figcaption{font-size:16px}canvas{max-width:100%}@media(max-width:520px){body{padding:16px}}"}