{"html":"<div id=\"iwr-night-invariants\" aria-label=\"Set 14: Visible Invariants, beş hareketli ses ekranı\">\n  <div class=\"viz-controls\">\n    <button type=\"button\" class=\"btn\" data-mode=\"play\" aria-pressed=\"true\">Çalma</button>\n    <button type=\"button\" class=\"btn\" data-mode=\"record\" aria-pressed=\"false\">Kayıt</button>\n    <button type=\"button\" class=\"btn btn-ghost\" data-pause aria-pressed=\"false\">Duraklat</button>\n    <span class=\"text-small text-muted\">Örnek ses ritmi · sessiz demo</span>\n  </div>\n  <div class=\"vi-layout\">\n    <div class=\"vi-stage\">\n      <div class=\"vi-phone\" aria-label=\"iwrzwr: Visible Invariants önizlemesi\">\n        <div class=\"vi-header\">\n          <div class=\"vi-status\" aria-hidden=\"true\"><span>9:41</span><span data-record hidden>REC</span><span>••• &nbsp; ▰</span></div>\n          <div class=\"vi-controls\">\n            <div class=\"vi-circle\" aria-hidden=\"true\"></div>\n            <canvas role=\"img\" aria-label=\"Moment Balance: yüklerden hesaplanan denge noktası\"></canvas>\n            <div class=\"vi-circle\" aria-hidden=\"true\"><i data-lucide=\"plus\"></i></div>\n          </div>\n        </div>\n        <div class=\"vi-pads\" aria-hidden=\"true\"><div><i data-lucide=\"mic\"></i></div><div><i data-lucide=\"mic\"></i></div></div>\n      </div>\n      <div class=\"text-small text-muted vi-spec\">126px header · 44px alan · 24px boşluk</div>\n    </div>\n    <div class=\"vi-options\" role=\"group\" aria-label=\"Visible Invariants seçenekleri\">\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"moment\" aria-pressed=\"true\">1 · Moment Balance</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"marginal\" aria-pressed=\"false\">2 · Marginal Print</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"area\" aria-pressed=\"false\">3 · Area Contract</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"registration\" aria-pressed=\"false\">4 · Registration Residual</button>\n      <button type=\"button\" class=\"btn btn-block\" data-style=\"occlusion\" aria-pressed=\"false\">5 · Occlusion Order</button>\n    </div>\n  </div>\n  <div class=\"vi-caption\" data-description aria-live=\"polite\">Destek, beş yükün gerçek ağırlık merkezinde; yüksek ses her zaman sağa gitmiyor.</div>\n</div>\n<style>\n  #iwr-night-invariants .vi-layout { display:grid; grid-template-columns:minmax(0,402px) minmax(190px,1fr); gap:24px; align-items:center; margin-top:20px; }\n  #iwr-night-invariants .vi-stage { min-width:0; }\n  #iwr-night-invariants .vi-options { display:grid; gap:8px; }\n  #iwr-night-invariants .vi-phone { --vi-screen:#000; --vi-pad:#cdcdcd; --vi-divider:#b6b6b6; --vi-ink:#f1f0e8; color:var(--vi-ink); background:var(--vi-pad); border-radius:30px; overflow:hidden; font-family:-apple-system,BlinkMacSystemFont,sans-serif; }\n  #iwr-night-invariants .vi-header { height:126px; position:relative; background:var(--vi-screen); border-radius:0 0 32px 40px; }\n  #iwr-night-invariants .vi-status { position:absolute; top:24px; left:28px; right:28px; display:flex; align-items:center; justify-content:space-between; font-size:13px; font-weight:500; }\n  #iwr-night-invariants [data-record] { color:#FF0000; font-family:ui-monospace,monospace; font-size:11px; }\n  #iwr-night-invariants [hidden] { display:none; }\n  #iwr-night-invariants .vi-controls { position:absolute; top:62px; left:20px; right:20px; display:flex; align-items:center; gap:24px; height:44px; }\n  #iwr-night-invariants .vi-circle { width:44px; height:44px; flex:none; display:grid; place-items:center; border-radius:50%; background:#141414; box-shadow:inset 0 0 0 1px #303030; }\n  #iwr-night-invariants .vi-circle svg { width:20px; height:20px; stroke-width:1.5; }\n  #iwr-night-invariants canvas { display:block; height:44px; width:100%; flex:1; min-width:0; }\n  #iwr-night-invariants .vi-pads { display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--vi-divider); }\n  #iwr-night-invariants .vi-pads>div { display:grid; place-items:center; height:120px; background:var(--vi-pad); color:#929292; }\n  #iwr-night-invariants .vi-pads svg { width:18px; height:18px; }\n  #iwr-night-invariants .vi-spec { margin-top:10px; }\n  #iwr-night-invariants .vi-caption { margin-top:16px; min-height:44px; }\n  @media(max-width:630px) { #iwr-night-invariants .vi-layout { grid-template-columns:minmax(0,1fr); gap:18px; } #iwr-night-invariants .vi-stage { width:100%; max-width:402px; margin:auto; } }\n</style>\n<script>\n(() => {\n  const root=document.getElementById('iwr-night-invariants');\n  const canvas=root.querySelector('canvas'),ctx=canvas.getContext('2d');\n  const pause=root.querySelector('[data-pause]'),caption=root.querySelector('[data-description]');\n  const reduced=matchMedia('(prefers-reduced-motion: reduce)');\n  const state={style:'moment',mode:'play',paused:reduced.matches,accent:true};\n  const names={moment:'Moment Balance',marginal:'Marginal Print',area:'Area Contract',registration:'Registration Residual',occlusion:'Occlusion Order'};\n  const descriptions={\n    moment:['Destek, beş yükün gerçek ağırlık merkezinde; yüksek ses her zaman sağa gitmiyor.','Her darbe yalnız bir yükü değiştiriyor; kısa kol, destek dengeye gelince kayboluyor.'],\n    marginal:['Tek kolon okunurken harita ve iki kenardaki gerçek toplamlar değişmiyor.','Bir adres yazılınca hem o satırın hem o kolonun toplamı birlikte artıyor.'],\n    area:['Üç pay yer değiştiriyor; dış üçgenin alanı hiç değişmiyor.','Önce iki pay yazılıyor; üçüncü, kalan alanı alıyor.'],\n    registration:['Ortak kayma çıkarılıyor; tek yerel sapma ve dört küçük ters düzeltme kalıyor.','Beş ölçüm toplanıp hizalanıyor; yalnız yerel farkların bağlantıları kalıyor.'],\n    occlusion:['Ön şekil sabit; arkadaki geçerken yalnız örtülen kenar parçaları kayboluyor.','Geometri sabit; her darbe hangi şeklin önde kaldığını yazıyor.']\n  };\n  const white='#f1f0e8',amber='#FF0000';\n  let w=226,dpr=1,t=2.4,last=0,raf=0,visible=true;\n  const clamp=(x,a=0,b=1)=>Math.min(b,Math.max(a,x)),mod=(x,n)=>(x%n+n)%n,mix=(a,b,q)=>a+(b-a)*q;\n  // Live sound seam: iwrSignal exists only inside the archive gallery. Without it, or with sound off, nothing changes.\n  const hearing=()=>typeof iwrSignal!=='undefined'&&iwrSignal.active?iwrSignal:null;\n  // Time-driven machines move on the beat and rest between hits; the studies' own dt clamps still apply first.\n  const conduct=()=>{const s=hearing();return s?0.25+4.2*s.hit:1;};\n  const accent=()=>state.accent?amber:white;\n  function ink(alpha=1,color=white) { ctx.globalAlpha=clamp(alpha);ctx.fillStyle=color;ctx.strokeStyle=color; }\n  function rect(x,y,width,height,alpha=1,color=white) { ink(alpha,color);ctx.fillRect(Math.round(x*dpr)/dpr,Math.round(y*dpr)/dpr,width,height); }\n  function line(points,alpha=1,color=white) { if(points.length<2)return;ink(alpha,color);ctx.lineWidth=1;ctx.lineCap='butt';ctx.lineJoin='miter';ctx.beginPath();points.forEach((p,i)=>i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]));ctx.stroke(); }\n  // All inputs are deterministic synthetic examples, never microphone measurements.\n  const loadPositions=[.12,.31,.5,.69,.88];\n  const savedLoads=[[.8,.45,.65,.45,.8],[.04,.08,.12,.16,.3],[.85,.3,.1,.15,.06],[0,0,0,0,0],[.14,.3,.8,.3,.14],[.3,.16,.12,.08,.04]];\n  const loadEdits=[[0,.1],[4,.15],[2,.1],[1,.1],[3,.25],[0,.8],[4,.8],[2,.65],[1,.45],[3,.45]];\n  const recordedLoads=[];let loadSeed=[...savedLoads[0]];\n  for(const [index,value] of loadEdits){loadSeed=[...loadSeed];loadSeed[index]=value;recordedLoads.push(loadSeed);}\n  function balance(weights,held=.5) {\n    const total=weights.reduce((a,b)=>a+b,0),weighted=weights.reduce((sum,value,index)=>sum+value*loadPositions[index],0);\n    return {total,position:total>1e-10?weighted/total:held};\n  }\n  function momentModel(time,recording) {\n    if(recording) {\n      const clock=mod(time,8),index=Math.floor(clock/.8),phase=clock-index*.8,weights=recordedLoads[index],previous=recordedLoads[mod(index-1,10)],target=balance(weights),old=balance(previous).position;\n      const support=mix(old,target.position,clamp(phase/.4));\n      return {weights,index:loadEdits[index][0],target:target.position,support,old,total:target.total,moment:weights.reduce((sum,value,i)=>sum+value*(loadPositions[i]-support),0),moving:phase<.4};\n    }\n    const clock=mod(time,9.6),index=Math.min(5,Math.floor(clock/1.6)),phase=clock-index*1.6,previous=savedLoads[mod(index-1,6)],weights=previous.map((value,i)=>mix(value,savedLoads[index][i],clamp(phase/.7)));\n    let held=.5;for(let ago=1;ago<=6;ago++){const candidate=balance(savedLoads[mod(index-ago,6)]);if(candidate.total>0){held=candidate.position;break;}}\n    const target=balance(weights,held);return {weights,index:-1,target:target.position,support:target.position,old:target.position,total:target.total,moment:0,moving:false};\n  }\n  function moment(time) {\n    const m=momentModel(time,state.mode==='record'),x=value=>5+value*(w-10);\n    line([[x(.06),22],[x(.94),22]],m.total?.88:.35);\n    m.weights.forEach((value,index)=>{const at=x(loadPositions[index]);if(value>0){line([[at,22-14*value],[at,22]],.96,index===m.index?accent():white);line([[at-2,20],[at,22],[at+2,20]],.65);}else line([[at-1,22],[at+1,22]],.25);});\n    const at=x(m.support);line([[at-4,33],[at,25],[at+4,33],[at-4,33]],m.total?1:.4,accent());\n    if(m.moving&&Math.abs(m.target-m.support)>1e-6){line([[x(m.old),37],[x(m.old),40]],.35);line([[at,36],[x(m.target),36]],.8,accent());line([[x(m.target),34],[x(m.target),38]],.8,accent());}\n  }\n  const addresses=[[0,0],[1,2],[2,4],[0,4],[2,0],[1,5],[0,2],[2,5]];\n  function marginals(points) {\n    const rows=[0,0,0],columns=[0,0,0,0,0,0,0];\n    points.forEach(([row,column])=>{rows[row]++;columns[column]++;});return {rows,columns};\n  }\n  function marginalModel(time,recording) {\n    const count=recording?clamp(Math.floor(mod(time,6.6)/.55),0,8):8,points=addresses.slice(0,count),totals=marginals(points),column=recording?-1:Math.floor(mod(time,5.6)/.7);\n    return {points,totals,column,latest:recording&&count>0&&mod(time,6.6)<4.95?count-1:-1};\n  }\n  function marginal(time) {\n    const m=marginalModel(time,state.mode==='record'),x=column=>10+column*(w-55)/6,y=row=>8+row*8;\n    for(let row=0;row<3;row++)for(let col=0;col<7;col++)rect(x(col)-.5,y(row)-.5,1,1,.24);\n    m.points.forEach(([row,col],index)=>line([[x(col)-2,y(row)],[x(col)+2,y(row)]],.96,col===m.column||index===m.latest?accent():white));\n    m.totals.rows.forEach((total,row)=>{\n      if(total)line([[w-29,y(row)],[w-29+total*5,y(row)]],.75);\n      const contribution=m.points.some(([r,c])=>r===row&&c===m.column);\n      if(contribution)line([[w-29+(total-1)*5,y(row)],[w-29+total*5,y(row)]],1,accent());\n      if(m.latest>=0&&m.points[m.latest][0]===row)line([[w-29+(total-1)*5,y(row)],[w-29+total*5,y(row)]],1,accent());\n    });\n    m.totals.columns.forEach((total,col)=>{line([[x(col)-1,40],[x(col)+1,40]],.24);if(total)line([[x(col),40],[x(col),40-total*3]],.8,col===m.column||m.latest>=0&&m.points[m.latest][1]===col?accent():white);});\n    if(m.column<7&&m.column>=0)line([[x(m.column)-3,3],[x(m.column)+3,3]],.8,accent());\n  }\n  const mixtures=[[1,1,1],[6,65,29],[55,10,35],[17,28,55]].map(values=>normalize(values));\n  function normalize(values,held=[1/3,1/3,1/3]) { const positive=values.map(value=>Math.max(0,value)),total=positive.reduce((a,b)=>a+b,0);return total>1e-10?positive.map(value=>value/total):[...held]; }\n  function barycentric(vertices,shares) { return [0,1].map(axis=>vertices.reduce((sum,vertex,index)=>sum+vertex[axis]*shares[index],0)); }\n  function areaModel(time,recording) {\n    const period=recording?2.4:1.5,clock=mod(time,period*4),index=Math.min(3,Math.floor(clock/period)),phase=clock-index*period,target=mixtures[index],previous=mixtures[mod(index-1,4)];\n    if(!recording)return {shares:previous.map((value,i)=>mix(value,target[i],clamp(phase/.75))),active:-1};\n    const first=target[0],rest=1-first,ratio=previous[1]/(previous[1]+previous[2]),firstStage=[first,rest*ratio,rest*(1-ratio)];\n    if(phase<.8)return {shares:previous.map((value,i)=>mix(value,firstStage[i],clamp(phase/.3))),active:0};\n    if(phase<1.6){const second=mix(firstStage[1],target[1],clamp((phase-.8)/.3));return {shares:[first,second,1-first-second],active:1};}\n    return {shares:[...target],active:2};\n  }\n  function area(time) {\n    const m=areaModel(time,state.mode==='record'),span=Math.min(150,w-12),left=(w-span)/2,vertices=[[left,35],[left+span,35],[left+span*.38,5]],point=barycentric(vertices,m.shares);\n    line([...vertices,vertices[0]],.72);\n    vertices.forEach((vertex,index)=>line([vertex,point],.94,m.active>=0&&index!==m.active?accent():white));\n    rect(point[0]-1,point[1]-1,2,2,1,accent());\n  }\n  const referenceMarks=[[.12,18],[.3,25],[.48,16],[.67,28],[.85,20]];\n  function register(displacements) {\n    if(!displacements.length)return {mean:[0,0],residuals:[]};\n    const mean=[0,1].map(axis=>displacements.reduce((sum,point)=>sum+point[axis],0)/displacements.length);\n    return {mean,residuals:displacements.map(point=>point.map((value,axis)=>value-mean[axis]))};\n  }\n  function registrationModel(time,recording) {\n    if(recording) {\n      const clock=mod(time,4),cycle=Math.floor(time/4),count=clamp(Math.floor(clock/.36)+1,0,5),align=clamp((clock-1.8)/.65),local=mod(cycle,2)?9:0;\n      const displacements=referenceMarks.slice(0,count).map((_,i)=>[6,-2+(i===2?local:0)]),estimate=register(displacements);\n      return {displacements,...estimate,align,count,shown:displacements.map(point=>point.map((value,axis)=>value-align*estimate.mean[axis]))};\n    }\n    const clock=mod(time,8),common=[6+3*Math.sin(clock*Math.PI/4),2*Math.sin(clock*Math.PI/4)],deviation=-10*Math.min(clamp((clock-2)/.5),clamp((5-clock)/.5));\n    const displacements=referenceMarks.map((_,i)=>[common[0],common[1]+(i===2?deviation:0)]),estimate=register(displacements);\n    return {displacements,...estimate,align:1,count:5,shown:estimate.residuals};\n  }\n  function registration(time) {\n    const m=registrationModel(time,state.mode==='record');\n    referenceMarks.forEach(([u,y],i)=>{\n      const x=5+u*(w-10);line([[x-3,y+3],[x-3,y],[x,y]],.5);\n      if(i<m.count){const delta=m.shown[i],point=[x+delta[0],y+delta[1]],length=Math.hypot(...delta),strong=i===2&&Math.hypot(...m.residuals[i])>3;\n        if(length>1e-8)line([[x,y],point],.83,strong?accent():white);\n        line([[point[0]-1.5,point[1]],[point[0]+1.5,point[1]]],.95,strong?accent():white);\n      }\n    });\n    if(m.align>0){const origin=[w/2,6],tip=[origin[0]+m.mean[0]*m.align,origin[1]+m.mean[1]*m.align];line([[origin[0]-2,origin[1]+2],origin,[origin[0]+2,origin[1]]],.3);line([origin,tip],.65);line([[tip[0],tip[1]-2],tip,[tip[0]+2,tip[1]]],.95,accent());}\n  }\n  function cross(a,b) { return a[0]*b[1]-a[1]*b[0]; }\n  function segmentInside(a,b,polygon) {\n    const signed=polygon.reduce((sum,p,i)=>sum+cross(p,polygon[(i+1)%polygon.length]),0),orientation=signed>=0?1:-1,delta=[b[0]-a[0],b[1]-a[1]];\n    let lo=0,hi=1;\n    for(let i=0;i<polygon.length;i++) {\n      const p=polygon[i],next=polygon[(i+1)%polygon.length],edge=[next[0]-p[0],next[1]-p[1]],c=orientation*cross(edge,[a[0]-p[0],a[1]-p[1]]),slope=orientation*cross(edge,delta);\n      if(Math.abs(slope)<1e-10){if(c<-1e-9)return null;continue;}\n      const crossing=-c/slope;if(slope>0)lo=Math.max(lo,crossing);else hi=Math.min(hi,crossing);\n      if(lo>hi+1e-10)return null;\n    }\n    return [clamp(lo),clamp(hi)];\n  }\n  function visibleSegment(a,b,polygon) {\n    const hidden=segmentInside(a,b,polygon),at=value=>[mix(a[0],b[0],value),mix(a[1],b[1],value)];\n    if(!hidden||hidden[1]-hidden[0]<1e-10)return {pieces:[[a,b]],hidden:0};\n    const pieces=[];if(hidden[0]>1e-10)pieces.push([a,at(hidden[0])]);if(hidden[1]<1-1e-10)pieces.push([at(hidden[1]),b]);\n    return {pieces,hidden:hidden[1]-hidden[0]};\n  }\n  function occlusionModel(time,recording,width) {\n    const shift=recording?0:.055*Math.sin(time*Math.PI/2.8),lift=recording?0:2.5*Math.sin(time*Math.PI/2.8);\n    const polygons=[[[.09,12],[.56,8],[.68,24],[.2,28]],[[.34,20],[.78,13],[.92,30],[.46,37]].map(p=>[p[0]+shift,p[1]+lift])].map(poly=>poly.map(p=>[5+p[0]*(width-10),p[1]]));\n    const front=recording?mod(Math.floor(time/1.4),2):0,back=1-front;\n    const edges=polygons[back].map((a,i)=>{const b=polygons[back][(i+1)%4];return {a,b,...visibleSegment(a,b,polygons[front])};});\n    return {polygons,front,back,edges};\n  }\n  function occlusion(time) {\n    const m=occlusionModel(time,state.mode==='record',w);\n    m.edges.forEach(edge=>edge.pieces.forEach(piece=>line(piece,.76)));\n    const front=m.polygons[m.front];line([...front,front[0]],.96);line([front[0],front[1]],.96,accent());\n  }\n  const renderers={moment,marginal,area,registration,occlusion};\n  function draw() { ctx.clearRect(0,0,w,44);ctx.save();ctx.beginPath();ctx.rect(0,0,w,44);ctx.clip();renderers[state.style](t);ctx.restore(); }\n  function sync() {\n    root.querySelectorAll('[data-style]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.style===state.style)));\n    root.querySelectorAll('[data-mode]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.mode===state.mode)));\n    const description=descriptions[state.style][state.mode==='record'?1:0];caption.textContent=description;canvas.setAttribute('aria-label',names[state.style]+': '+description);\n    root.querySelector('[data-record]').hidden=state.mode!=='record';pause.textContent=state.paused?'Devam et':'Duraklat';pause.setAttribute('aria-pressed',String(state.paused));draw();schedule();\n  }\n  function resize() { w=Math.max(1,canvas.getBoundingClientRect().width);dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(w*dpr);canvas.height=44*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);draw(); }\n  function schedule() { if(!raf&&!state.paused&&visible&&!document.hidden&&root.isConnected) { last=0;raf=requestAnimationFrame(frame); } }\n  function frame(now) { raf=0;if(state.paused||!visible||document.hidden||!root.isConnected)return;if(!last)last=now;const elapsed=now-last;if(elapsed>=1000/30){t+=Math.min(elapsed/1000,.07)*conduct();last=now;draw();}raf=requestAnimationFrame(frame); }\n  root.querySelectorAll('[data-style]').forEach(el=>el.addEventListener('click',()=>{state.style=el.dataset.style;sync();}));\n  root.querySelectorAll('[data-mode]').forEach(el=>el.addEventListener('click',()=>{state.mode=el.dataset.mode;sync();}));\n  pause.addEventListener('click',()=>{state.paused=!state.paused;sync();});\n  reduced.addEventListener('change',()=>{state.paused=reduced.matches;sync();});\n  document.addEventListener('visibilitychange',schedule);\n  new ResizeObserver(resize).observe(canvas);\n  new IntersectionObserver(entries=>{\n    const latest=entries.filter(entry=>entry.target===root).reduce((a,b)=>!a||b.time>=a.time?b:a,null);\n    if(latest){visible=latest.isIntersecting;schedule();}\n  }).observe(root);\n  resize();sync();\n  if(globalThis.Tweak){const tweak=new Tweak({container:root.querySelector('.vi-phone'),onChange:sync});tweak.addToggle(state,'accent',{label:'Kehribar vurgu'});}\n})();\n</script>\n","css":":root{color-scheme:dark;--background:#000;--foreground:#eee;--muted-foreground:#999}*{box-sizing:border-box}body{margin:0;padding:24px;background:#000;color:#eee;font:16px/1.5 Arial,Helvetica,sans-serif}button{font:inherit;cursor:pointer}.viz-controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:24px}.btn{color:#bbb;background:#141414;border:1px solid #333;border-radius:6px;min-height:44px;padding:9px 14px;text-align:left}.btn[aria-pressed=true]{color:#fff;border-color:#ddd;background:#262626}.btn-block{width:100%}.text-small{font-size:14px}.text-muted{color:#999}:focus-visible{outline:2px solid #fff;outline-offset:3px}[hidden]{display:none!important}h3{font-size:18px;font-weight:500}figcaption{font-size:16px}canvas{max-width:100%}@media(max-width:520px){body{padding:16px}}"}